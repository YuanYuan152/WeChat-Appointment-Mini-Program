# 浏览器请求后端的公开地址；生产环境必须使用公网 HTTPS 地址。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# EAP 对外公开站点地址，用于量表 canonical/Open Graph 和分享预览。
# 生产环境必须是无路径、无参数的 HTTPS origin，例如 https://eap.ji-psy.com。
NEXT_PUBLIC_SITE_URL=https://eap.ji-psy.com

# Next.js 服务端请求后端的内部地址，可与公开地址不同。
API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# 通用内容 HttpAdapter 尚未实现，保持 mock；量表、登录和预约使用各自的真实 API。
NEXT_PUBLIC_DATA_SOURCE=mock
