# Copy this file to .env for local development. Never commit the real .env.
APP_ENV=development
APP_VERSION=local
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
AUTO_MIGRATE_SCHEMA=true
ALLOW_DEV_LOGIN=true
ALLOW_SIMULATED_PAYMENT=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# SQL Server. Prefer a dedicated local account or Windows trusted connection.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=lxxlBuild
DB_USER=sa
DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=false
DB_TRUST_SERVER_CERTIFICATE=true
DB_CONNECT_TIMEOUT=5
SKIP_LEGACY_QUERIES=true

# Use different random values in every deployed environment.
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168
ASSESSMENT_SHARE_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
MESSAGE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_INTERNAL_TOKEN

BASE_URL=http://127.0.0.1:8000
UPLOAD_DIR=./static/uploads
ASSESSMENT_DATA_DIR=./runtime/assessment-data
ASSESSMENT_ASSET_DIR=./runtime/assessment-assets
ASSESSMENT_SEED_DATA_DIR=
ASSESSMENT_CONSENT_VERSION=2026-01
ASSESSMENT_FRONTEND_BASE_URL=http://127.0.0.1:3000

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MINIPROGRAM_STATE=developer
WECHAT_PAY_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_PAY_NOTIFY_URL=http://127.0.0.1:8000/api/payment/wechat/callback

SMS_MOCK=true
SMS_CODE_LENGTH=6
SMS_CODE_TTL_MINUTES=5
SMS_RESEND_INTERVAL_SECONDS=60
