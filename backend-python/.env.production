# 连心心理小程序 - 生产环境配置
# 上线前将此文件复制为 .env，并填写真实值
# 本文件只是模板，禁止原样部署。上线门禁应拒绝 your_* / your-*.com 占位值、
# 不可写或非绝对的 ASSESSMENT_DATA_DIR；如需启用分享，还必须拒绝空分享密钥。

# =========================================================
# 数据库
# =========================================================
# SQL Server 数据库连接配置
# 本地开发可使用 Windows 集成认证（不要把这一组值带到服务器）：
#   DB_SERVER=.\SQLEXPRESS
#   DB_TRUSTED_CONNECTION=true
#
# 生产环境通常使用 SQL Server 用户名密码认证；以下占位值必须替换：
#   DB_SERVER=192.168.1.100
#   DB_PORT=1433
#   DB_USER=sa
#   DB_PASSWORD=your_password
#   DB_TRUSTED_CONNECTION=false
DB_SERVER=your_sql_server_host
DB_PORT=1433
DB_NAME=your_database_name
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=false
DB_TRUST_SERVER_CERTIFICATE=true

# =========================================================
# 微信小程序
# =========================================================
WECHAT_APPID=wx9026409e86a6e43c
WECHAT_SECRET=4680cedc58de4fd8482fd81e40702b57

# =========================================================
# 微信支付
# =========================================================
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_KEY=your_pay_api_key
# 支付结果回调地址，必须为公网 HTTPS 地址
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/payment/wechat/callback

# =========================================================
# JWT
# =========================================================
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# =========================================================
# 服务本身
# =========================================================
# 服务对外访问的基础 URL，用于拼接上传文件的绝对路径
BASE_URL=https://your-domain.com
# 通用上传文件必须位于发布目录外，并由实际服务用户持久化读写。
# 测试环境改用 /data/mini_program/shared/test/uploads。
UPLOAD_DIR=/data/mini_program/shared/production/uploads

# =========================================================
# EAP 量表
# =========================================================
# 后台编辑后的量表 JSON 必须写入发布目录之外、仅供生产环境使用的持久化路径。
# 测试环境必须改用独立目录，例如 /data/mini_program/shared/test/assessment-data。
ASSESSMENT_DATA_DIR=/data/mini_program/shared/production/assessment-data
# 量表封面和结果图片的不可变持久化目录；测试环境必须使用独立的 test 路径。
ASSESSMENT_ASSET_DIR=/data/mini_program/shared/production/assessment-assets
# 仅首次初始化旧量表时使用；留空则读取仓库内 EAP_front_site/src/data。
ASSESSMENT_SEED_DATA_DIR=
ASSESSMENT_CONSENT_VERSION=2026-01
# 至少 32 个随机字符，不得复用 JWT_SECRET；更换后旧分享二维码会失效。
ASSESSMENT_SHARE_SECRET=
# 扫码成功后跳转的 EAP 公网 HTTPS 根地址。
ASSESSMENT_FRONTEND_BASE_URL=https://your-eap-domain.com

# 生产环境不得返回模拟短信验证码；无旧 T_* 数据源时保持跳过旧表查询。
SMS_MOCK=false
SKIP_LEGACY_QUERIES=true
