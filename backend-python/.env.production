# 连心心理小程序 - 生产环境配置
# 上线前将此文件复制为 .env，并填写真实值

# =========================================================
# 数据库
# =========================================================
# SQL Server 数据库连接配置
# 本地开发可使用 Windows 集成认证：
#   DB_SERVER=.\SQLEXPRESS
#   DB_TRUSTED_CONNECTION=true
#
# 生产环境通常使用 SQL Server 用户名密码认证：
#   DB_SERVER=192.168.1.100
#   DB_PORT=1433
#   DB_USER=sa
#   DB_PASSWORD=your_password
#   DB_TRUSTED_CONNECTION=false
DB_SERVER=.\SQLEXPRESS
DB_PORT=1433
DB_NAME=lxxlBuild
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_TRUSTED_CONNECTION=true
DB_TRUST_SERVER_CERTIFICATE=true

# =========================================================
# 微信小程序
# =========================================================
WECHAT_APPID=wx9026409e86a6e43c
WECHAT_SECRET=your_wechat_secret_here

# =========================================================
# 微信支付
# =========================================================
WECHAT_PAY_MCH_ID=your_mch_id
WECHAT_PAY_KEY=your_pay_api_key
# 支付结果回调地址，必须为公网 HTTPS 地址
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/payment/wechat/callback

# =========================================================
# JWT
# =========================================================
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# =========================================================
# 服务本身
# =========================================================
# 服务对外访问的基础 URL，用于拼接上传文件的绝对路径
BASE_URL=https://your-domain.com
