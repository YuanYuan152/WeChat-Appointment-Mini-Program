# Local Apple Silicon example (all database changes are explicit):
#   sudo deploy/scripts/prepare-data-dirs.sh \
#     --env-file deploy/env/local.env.example --apply
#   docker compose --env-file deploy/env/local.env.example \
#     -f deploy/compose.yml -f deploy/compose.local.yml build backend admin eap
#   docker compose --env-file deploy/env/local.env.example \
#     -f deploy/compose.yml -f deploy/compose.local.yml up -d --wait mssql
#   docker compose --env-file deploy/env/local.env.example \
#     -f deploy/compose.yml -f deploy/compose.local.yml \
#     --profile database-init run --rm --no-deps db-init
#   docker compose --env-file deploy/env/local.env.example \
#     -f deploy/compose.yml -f deploy/compose.local.yml \
#     --profile database-init run --rm --no-deps migrate
#   docker compose --env-file deploy/env/local.env.example \
#     -f deploy/compose.yml -f deploy/compose.local.yml up -d --wait
# A normal final "up" never runs db-init or migrate.
APP_ENV=development
APP_VERSION=local
VCS_REF=local
IMAGE_TAG=local
LOG_LEVEL=DEBUG
ENABLE_API_DOCS=true
AUTO_MIGRATE_SCHEMA=false
ALLOW_DEV_LOGIN=true
ALLOW_SIMULATED_PAYMENT=true

# Azure SQL Edge publishes both arm64 and amd64 manifests. Override these two
# values if the local machine or selected image requires another architecture.
MSSQL_IMAGE=mcr.microsoft.com/azure-sql-edge:latest
MSSQL_PLATFORM=linux/arm64
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=LocalOnly_Strong_Password_2026!
DB_USER=sa
DB_PASSWORD=LocalOnly_Strong_Password_2026!
DB_NAME=lxxlBuild_local
DB_CONNECT_TIMEOUT=5
SKIP_LEGACY_QUERIES=true
BACKEND_WORKERS=1

JWT_SECRET=local-only-jwt-secret-never-use-on-a-server-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168
ASSESSMENT_SHARE_SECRET=local-only-share-secret-never-use-on-a-server-2026
ASSESSMENT_CONSENT_VERSION=2026-01
MESSAGE_INTERNAL_TOKEN=local-only-internal-token

BASE_URL=http://127.0.0.1:8000
ASSESSMENT_FRONTEND_BASE_URL=http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:3001
ADMIN_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EAP_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
EAP_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_DATA_SOURCE=mock

WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MINIPROGRAM_STATE=developer
WECHAT_PAY_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_PAY_NOTIFY_URL=http://127.0.0.1:8000/api/payment/wechat/callback

SMS_MOCK=true
SMS_PROVIDER=tencent
SMS_CODE_LENGTH=6
SMS_CODE_TTL_MINUTES=5
SMS_RESEND_INTERVAL_SECONDS=60
SMS_MAX_SENDS_PER_HOUR=10
SMS_MAX_VERIFY_ATTEMPTS=5
SMS_CODE_HASH_SECRET=local-sms-code-hash-secret-change-before-sharing
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=

DATA_HOST_ROOT=/tmp/mini-program
DATA_DIR_UID=10001
DATA_DIR_GID=10001
DATA_DIR_MODE=0777
DATA_FILE_MODE=0666
UPLOAD_HOST_DIR=/tmp/mini-program/local/uploads
ASSESSMENT_DATA_HOST_DIR=/tmp/mini-program/local/assessment-data
ASSESSMENT_ASSET_HOST_DIR=/tmp/mini-program/local/assessment-assets
MSSQL_BACKUP_HOST_DIR=/tmp/mini-program/local/backups
