# Copy to deploy/env/production.env on the production host and chmod 600.
# Never commit the real file. Runtime and migration credentials must differ.
# Before the first start, run prepare-data-dirs.sh. Database creation and
# migration are opt-in through the "database-init" Compose profile.
APP_ENV=production
APP_VERSION=REPLACE_WITH_GIT_SHA
VCS_REF=REPLACE_WITH_THE_SAME_GIT_SHA
IMAGE_TAG=REPLACE_WITH_GIT_SHA
LOG_LEVEL=INFO
ENABLE_API_DOCS=false
AUTO_MIGRATE_SCHEMA=false
ALLOW_DEV_LOGIN=false
# 管理后台密钥登录正式入口（与 ALLOW_DEV_LOGIN 解耦，生产应保持 true）
ALLOW_ACCESS_KEY_LOGIN=true
ALLOW_SIMULATED_PAYMENT=false

# 管理后台密钥登录（构建 admin 镜像时写入前端）
ADMIN_ACCESS_KEY_LOGIN_ENABLED=true
ADMIN_ACCESS_KEY=REPLACE_WITH_ADMIN_ACCESS_KEY
ADMIN_ACCESS_KEY_LOGIN_CODE=dev_admin
# EAP 站点密钥登录（可选；与后台管理员密钥分离，默认来访身份）
EAP_ACCESS_KEY_LOGIN_ENABLED=false
EAP_ACCESS_KEY=
EAP_ACCESS_KEY_LOGIN_CODE=dev_patient

# Replace the tag with the exact digest approved by CI/security review.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_PLATFORM=linux/amd64
MSSQL_PID=Standard
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DATABASE_PASSWORD
MIGRATION_DB_USER=sa
MIGRATION_DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_DATABASE_PASSWORD
DB_USER=mini_production_app
DB_PASSWORD=REPLACE_WITH_SEPARATE_PRODUCTION_APP_DATABASE_PASSWORD
DB_NAME=lxxlBuild_production
DB_CONNECT_TIMEOUT=5
SKIP_LEGACY_QUERIES=true
BACKEND_WORKERS=4

# Container resource ceilings. Tune only after observing the target host.
MSSQL_CPUS_LIMIT=2.00
MSSQL_MEMORY_LIMIT=3g
MSSQL_MEMORY_RESERVATION=1536m
MSSQL_PIDS_LIMIT=768
DATABASE_JOB_CPUS_LIMIT=1.00
DATABASE_JOB_MEMORY_LIMIT=1g
DATABASE_JOB_MEMORY_RESERVATION=256m
DATABASE_JOB_PIDS_LIMIT=256
BACKEND_CPUS_LIMIT=1.50
BACKEND_MEMORY_LIMIT=1536m
BACKEND_MEMORY_RESERVATION=512m
BACKEND_PIDS_LIMIT=384
FRONTEND_CPUS_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_MEMORY_RESERVATION=128m
FRONTEND_PIDS_LIMIT=192

JWT_SECRET=REPLACE_WITH_RANDOM_PRODUCTION_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168
ASSESSMENT_SHARE_SECRET=REPLACE_WITH_SEPARATE_RANDOM_PRODUCTION_SHARE_SECRET_32_CHARS
ASSESSMENT_CONSENT_VERSION=2026-01
MESSAGE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_PRODUCTION_INTERNAL_TOKEN

BASE_URL=https://eap.ji-psy.com
ASSESSMENT_FRONTEND_BASE_URL=https://eap.ji-psy.com
CORS_ALLOWED_ORIGINS=https://eap.ji-psy.com,https://admin.ji-psy.com
ADMIN_PUBLIC_API_BASE_URL=https://admin.ji-psy.com
EAP_PUBLIC_API_BASE_URL=https://eap.ji-psy.com
EAP_PUBLIC_SITE_URL=https://eap.ji-psy.com
NEXT_PUBLIC_DATA_SOURCE=mock

WECHAT_APPID=REPLACE_WITH_PRODUCTION_WECHAT_APPID
WECHAT_SECRET=REPLACE_WITH_PRODUCTION_WECHAT_SECRET
WECHAT_MINIPROGRAM_STATE=formal
WECHAT_PAY_MCH_ID=REPLACE_WITH_PRODUCTION_WECHAT_MERCHANT_ID
WECHAT_PAY_KEY=REPLACE_WITH_PRODUCTION_WECHAT_PAY_KEY
WECHAT_PAY_NOTIFY_URL=https://eap.ji-psy.com/api/payment/wechat/callback

SMS_MOCK=false
SMS_CODE_LENGTH=6
SMS_CODE_TTL_MINUTES=5
SMS_RESEND_INTERVAL_SECONDS=60

SYSLOG_ADDRESS=unixgram:///dev/log
DATA_HOST_ROOT=/data/mini_program
DATA_DIR_UID=10001
DATA_DIR_GID=10001
DATA_DIR_MODE=0750
DATA_FILE_MODE=0640
UPLOAD_HOST_DIR=/data/mini_program/shared/production/uploads
ASSESSMENT_DATA_HOST_DIR=/data/mini_program/shared/production/assessment-data
ASSESSMENT_ASSET_HOST_DIR=/data/mini_program/shared/production/assessment-assets
MSSQL_BACKUP_HOST_DIR=/data/mini_program/backups/production
