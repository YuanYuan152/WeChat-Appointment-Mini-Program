# Copy to deploy/env/test.env on the test host and chmod 600.
# Never commit the real file. Runtime and migration credentials must differ.
# Before the first start, run prepare-data-dirs.sh. Database creation and
# migration are opt-in through the "database-init" Compose profile.
APP_ENV=test
APP_VERSION=REPLACE_WITH_GIT_SHA
VCS_REF=REPLACE_WITH_THE_SAME_GIT_SHA
IMAGE_TAG=REPLACE_WITH_GIT_SHA
# Optional build-only accelerator. Leave empty to use the Debian default.
DEBIAN_MIRROR=
DEBIAN_SECURITY_MIRROR=
LOG_LEVEL=INFO
ENABLE_API_DOCS=true
AUTO_MIGRATE_SCHEMA=false
ALLOW_DEV_LOGIN=true
ALLOW_SIMULATED_PAYMENT=true

# Replace the tag with the exact digest approved by CI/security review.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
MSSQL_PLATFORM=linux/amd64
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_TEST_DATABASE_PASSWORD
MIGRATION_DB_USER=sa
MIGRATION_DB_PASSWORD=REPLACE_WITH_STRONG_TEST_DATABASE_PASSWORD
DB_USER=mini_test_app
DB_PASSWORD=REPLACE_WITH_SEPARATE_TEST_APP_DATABASE_PASSWORD
DB_NAME=lxxlBuild_test
DB_CONNECT_TIMEOUT=5
SKIP_LEGACY_QUERIES=true
BACKEND_WORKERS=1

# Container resource ceilings. Tune only after observing the target host.
MSSQL_CPUS_LIMIT=1.50
MSSQL_MEMORY_LIMIT=2g
MSSQL_MEMORY_RESERVATION=1g
MSSQL_PIDS_LIMIT=512
DATABASE_JOB_CPUS_LIMIT=0.75
DATABASE_JOB_MEMORY_LIMIT=768m
DATABASE_JOB_MEMORY_RESERVATION=128m
DATABASE_JOB_PIDS_LIMIT=192
BACKEND_CPUS_LIMIT=0.75
BACKEND_MEMORY_LIMIT=768m
BACKEND_MEMORY_RESERVATION=256m
BACKEND_PIDS_LIMIT=256
FRONTEND_CPUS_LIMIT=0.50
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_MEMORY_RESERVATION=128m
FRONTEND_PIDS_LIMIT=192

JWT_SECRET=REPLACE_WITH_RANDOM_TEST_JWT_SECRET_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168
ASSESSMENT_SHARE_SECRET=REPLACE_WITH_SEPARATE_RANDOM_TEST_SHARE_SECRET_32_CHARS
ASSESSMENT_CONSENT_VERSION=2026-01
MESSAGE_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_TEST_INTERNAL_TOKEN

BASE_URL=https://test.eap.ji-psy.com
ASSESSMENT_FRONTEND_BASE_URL=https://test.eap.ji-psy.com
CORS_ALLOWED_ORIGINS=https://test.eap.ji-psy.com,https://test.admin.ji-psy.com
ADMIN_PUBLIC_API_BASE_URL=https://test.admin.ji-psy.com
EAP_PUBLIC_API_BASE_URL=https://test.eap.ji-psy.com
EAP_PUBLIC_SITE_URL=https://test.eap.ji-psy.com
NEXT_PUBLIC_DATA_SOURCE=mock

WECHAT_APPID=REPLACE_WITH_TEST_WECHAT_APPID
WECHAT_SECRET=REPLACE_WITH_TEST_WECHAT_SECRET
WECHAT_MINIPROGRAM_STATE=trial
WECHAT_PAY_MCH_ID=
WECHAT_PAY_KEY=
WECHAT_PAY_NOTIFY_URL=https://test.eap.ji-psy.com/api/payment/wechat/callback

SMS_MOCK=true
SMS_CODE_LENGTH=6
SMS_CODE_TTL_MINUTES=5
SMS_RESEND_INTERVAL_SECONDS=60

SYSLOG_ADDRESS=unixgram:///dev/log
DATA_HOST_ROOT=/data/mini_program
DATA_DIR_UID=10001
DATA_DIR_GID=10001
DATA_DIR_MODE=0750
DATA_FILE_MODE=0640
UPLOAD_HOST_DIR=/data/mini_program/shared/test/uploads
ASSESSMENT_DATA_HOST_DIR=/data/mini_program/shared/test/assessment-data
ASSESSMENT_ASSET_HOST_DIR=/data/mini_program/shared/test/assessment-assets
MSSQL_BACKUP_HOST_DIR=/data/mini_program/backups/test
