# 本地小程序开发：V2 后端地址（微信开发者工具需勾选「不校验合法域名」）
# 真机调试用局域网 IP（当前本机 WLAN）；仅模拟器时可改回 http://127.0.0.1:8000
VITE_API_V2_BASE_URL=http://192.168.124.7:8000

# 测试版多角色登录（登录页 DevRolePicker + dev_* mock code）
VITE_ENABLE_MOCK_LOGIN=true

# 默认登录角色（也可在登录页切换，无需重启）
# patient | patient_gang | patient_li | counselor | counselor_zhang | counselor_wang | counselor_chen | assistant | ops | admin
VITE_DEV_LOGIN_ROLE=patient
