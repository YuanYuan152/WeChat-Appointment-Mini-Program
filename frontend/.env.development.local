# 本地小程序开发：V2 后端地址（微信开发者工具需勾选「不校验合法域名」）
# 开发者工具可用 http://127.0.0.1:8000
# 真机调试必须用电脑当前 WLAN IP（ipconfig 查看 IPv4）
# VITE_API_V2_BASE_URL=http://192.168.124.21:8000
# VITE_API_V2_BASE_URL=https://eap.ji-psy.com
VITE_API_V2_BASE_URL=https://test.eap.ji-psy.com

# 测试版多角色登录（登录页 DevRolePicker + dev_* mock code）
VITE_ENABLE_MOCK_LOGIN=true

# 默认登录角色（也可在登录页切换，无需重启）
VITE_DEV_LOGIN_ROLE=patient

# 是否走真实微信支付（false/未设置 = 模拟支付）
# 上线前改为 true，并确保后端已配置真实商户凭证
VITE_ENABLE_REAL_PAY=false
