{
  "name": "ji-psy-frontend",
  "version": "1.0.0",
  "description": "连心心理前端项目 - 基于Vue 3 + TypeScript + UniApp",
  "main": "index.js",
  "scripts": {
    "dev": "uni",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:app": "uni -p app",
    "build": "uni build",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:app": "uni build -p app",
    "build:prod": "cross-env NODE_ENV=production uni build",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint --ext .vue,.js,.ts,.jsx,.tsx src",
    "lint:fix": "eslint --ext .vue,.js,.ts,.jsx,.tsx src --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,scss,css,json}\"",
    "preview": "vite preview",
    "clean": "rimraf dist unpackage"
  },
  "keywords": ["vue3", "typescript", "uniapp", "vite", "unocss"],
  "author": "连心心理团队",
  "license": "MIT",
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4050620250312001",
    "@dcloudio/uni-app-plus": "3.0.0-4050620250312001",
    "@dcloudio/uni-h5": "3.0.0-4050620250312001",
    "@dcloudio/uni-mp-weixin": "3.0.0-4050620250312001",
    "@dcloudio/uni-ui": "^1.5.7",
    "vue": "^3.4.21",
    "pinia": "^2.2.4",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.14",
    "@dcloudio/uni-automator": "3.0.0-4050620250312001",
    "@dcloudio/uni-cli-shared": "3.0.0-4050620250312001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4050620250312001",
    "@types/node": "^22.8.2",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "@uni-helper/uni-app-types": "1.0.0-alpha.6",
    "@uni-helper/uni-ui-types": "1.0.0-alpha.6",
    "@vue/runtime-core": "^3.5.13",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^9.9.1",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-vue": "^9.15.1",
    "prettier": "^3.3.3",
    "sass": "^1.78.0",
    "typescript": "^5.5.4",
    "unocss": "^0.63.4",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-vue-components": "^0.28.0",
    "vite": "^5.2.8",
    "vue-tsc": "^2.0.29",
    "rimraf": "^5.0.5"
  },
  "engines": {
    "node": ">= 18.0.0",
    "pnpm": ">= 8.0.0"
  },
  "packageManager": "pnpm@8.15.0",
  "pnpm": {
    "overrides": {
      "vue": "^3.4.21"
    }
  }
} 