@using lxxl.Models
@{
    ViewBag.Title = "活动报名";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
    List<T_SubUser> SubFormList = ViewBag.SubFormList;
    int index = 1;
}

<div class="main-content">
    <!-- #section:basics/content.breadcrumbs -->
    <div class="breadcrumbs" id="breadcrumbs">
        <script type="text/javascript">
            try { ace.settings.check('breadcrumbs', 'fixed') } catch (e) { }
        </script>
        <ul class="breadcrumb">
            <li><i class="ace-icon fa fa-home home-icon"></i>活动管理 </li>
            <li class="active">填报记录</li>
        </ul>
        <!-- /.breadcrumb -->
        <!-- #section:basics/content.searchbox -->
        <div class="nav-search" id="nav-search" style="display: none">
            <form action="javascript:alert('开发中')" method="post" class="form-search">
                <span class="input-icon">
                    <input type="text" placeholder="Search ..." class="nav-search-input" id="nav-search-input"
                           autocomplete="off" />
                    <i class="ace-icon fa fa-search nav-search-icon"></i>
                </span>
            </form>
        </div>
        <!-- /.nav-search -->
        <!-- /section:basics/content.searchbox -->
    </div>
    <!-- /section:basics/content.breadcrumbs -->
    <div class="page-content">
        <div class="row">
            <div class="col-xs-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="row">
                    @if (Session["alert"] != null)
                    {
                        <div class="col-xs-12 col-sm-8 col-sm-offset-2">
                            <div class="alert alert-warning alert-danger" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                                @Session["alert"]
                                @(Session["alert"] = null)
                            </div>
                        </div>
                        <div class="col-xs-0 col-sm-2">
                        </div>
                    }
                </div>
                <div class="row">
                    <div class="col-xs-12">
                        <!-- PAGE CONTENT BEGINS -->
                        <div class="row">
                            <div class="col-xs-12">
                                <table id="sample-table-1" class="table table-striped table-bordered table-hover">
                                    <thead>
                                        <tr>
                                            <th class="center">
                                                编号
                                            </th>
                                            <th>用户名</th>
                                            <th>姓名</th>
                                            <th>
                                                <i class="ace-icon fa fa-clock-o bigger-110 hidden-480"></i>
                                                填写时间
                                            </th>
                                            <th>操作</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var SubForm in SubFormList)
                                        {
                                            <tr>
                                                <td class="center">
                                                    <label class="position-relative">
                                                        <span class="label label-sm label-warning">@(index++)</span>
                                                    </label>
                                                </td>

                                                <td>@SubForm.User.UserName</td>
                                                <td>@SubForm.User.Name</td>
                                                <td>@SubForm.SubTime</td>
                                                <td>
                                                    <div class="hidden-sm hidden-xs btn-group">
                                                        <a class="btn btn-xs btn-group" target="_blank" title="查看填报记录" href="@Url.Action("Sign", "Action", new { ID = SubForm.ID })">
                                                            查看填报信息
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div><!-- /.span -->
                        </div><!-- /.row -->
                    </div><!-- /.col -->
                </div><!-- /.row -->
            </div>
        </div>
    </div>
</div>


