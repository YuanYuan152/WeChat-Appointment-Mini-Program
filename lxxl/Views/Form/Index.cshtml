@using lxxl.Models;
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
    List<T_ItemType> ItemTypeList = ViewBag.ItemTypeList;
}

<div class="main-content">
    <!-- #section:basics/content.breadcrumbs -->
    <div class="breadcrumbs" id="breadcrumbs">
        <script type="text/javascript">
            try { ace.settings.check('breadcrumbs', 'fixed') } catch (e) { }
        </script>
        <ul class="breadcrumb">
            <li><i class="ace-icon fa fa-home home-icon"></i>首页 </li>
        </ul>
        <!-- /.breadcrumb -->
        <!-- #section:basics/content.searchbox -->
        <div class="nav-search" id="nav-search" style="display: none">
            <form action="javascript:alert('开发中')" method="post" class="form-search">
                <span class="input-icon">
                    <input type="text" placeholder="Search ..." class="nav-search-input" id="nav-search-input"
                           autocomplete="off" />
                    <i class="ace-icon fa fa-search nav-search-icon"></i>
                </span>
            </form>
        </div>
        <!-- /.nav-search -->
        <!-- /section:basics/content.searchbox -->
    </div>
    <!-- /section:basics/content.breadcrumbs -->
    <div class="page-content">
        <div class="row">
            <div class="col-xs-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="row">
                    @if (Session["alert"] != null)
                    {
                        <div class="col-xs-12 col-sm-8 col-sm-offset-2">
                            <div class="alert alert-warning alert-danger" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                                @Session["alert"]
                                @(Session["alert"] = null)
                            </div>
                        </div>
                        <div class="col-xs-0 col-sm-2">
                        </div>
                    }
                </div>
                <div class="page-header">
                    <a href="javascript:" class="btn btn-bold" id="addform">添加表单</a>
                </div>
                <div class="row">
                    <div class="col-xs-12">
                        <!-- PAGE CONTENT BEGINS -->
                        <!-- #section:plugins/fuelux.treeview -->
                        <div class="row">
                            <div class="col-sm-12">
                                <div class="widget-box widget-color-blue2">
                                    <div class="widget-header">
                                        <h4 class="widget-title lighter smaller">表单管理</h4>
                                        <!-- #section:custom/widget-box.toolbar -->
                                        <div class="widget-toolbar">


                                            <a href="#" data-action="fullscreen" class="orange2">
                                                <i class="ace-icon fa fa-expand"></i>
                                            </a>

                                            <a href="javascript:location.reload()">
                                                <i class="ace-icon fa fa-refresh" style="color:white"></i>
                                            </a>
                                        </div>

                                        <!-- /section:custom/widget-box.toolbar -->
                                    </div>

                                    <div class="widget-body">
                                        <div class="widget-main padding-8">
                                            @for (int n = 1; n < ViewBag.Count + 1; n++)
                                            {
                                                string id = "tree" + n;
                                                <div id="@id" class="tree"></div>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div style="text-align:center;">
                                    @for (int n = 1; n < ViewBag.Count + 1; n++)
                                    {
                                        <a href="javascript:" class="page" page="@n">第@(n)页</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div><!-- /.col -->
                </div><!-- /.row -->
            </div>
        </div>
    </div>
</div>

<input type="button" id="btnmyModal1" style="display:none" data-toggle="modal" data-target="#myModal1" value="添加表单" />
<div class="modal fade" id="myModal1" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">添加表单</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" value="" id="setid">
                <div class="row">
                    <form id="form">
                        <input type="hidden" name="ID" value="" />
                        <div class="form-group" style="padding-bottom:50px;">
                            <label class="col-sm-2 control-label">表单名称</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="Name" placeholder="表单名称">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">表单说明</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="Info" placeholder="表单说明">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">关闭</button>
                <button type="button" class="btn btn-primary save">保存</button>
            </div>
        </div>
    </div>
</div>

<input type="button" id="btnmyModal2" style="display:none" data-toggle="modal" data-target="#myModal2" value="添加表单" />
<div class="modal fade" id="myModal2" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">添加选项组</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" value="" id="setid">
                <div class="row">
                    <form id="form">
                        <input type="hidden" value="" name="FormID" />
                        <input type="hidden" value="" name="ID">
                        <div class="form-group" style="padding-bottom:50px;">
                            <label class="col-sm-2 control-label">类型</label>
                            <div class="col-sm-10">
                                <select name="ItemTypeID" class="form-control">
                                    @foreach (var itemtype in ItemTypeList)
                                    {
                                        <option value="@itemtype.ID">@itemtype.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <div class="form-group" style="padding-bottom:50px;">
                            <label class="col-sm-2 control-label">名称</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="Name" placeholder="名称">
                            </div>
                        </div>
                        <div class="form-group" style="padding-bottom:50px;">
                            <label class="col-sm-2 control-label">排序号</label>
                            <div class="col-sm-10">
                                <input type="number" class="form-control" name="Order" placeholder="排序号">
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="col-sm-2 control-label">说明</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="Info" placeholder="说明">
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">关闭</button>
                <button type="button" class="btn btn-primary save">保存</button>
            </div>
        </div>
    </div>
</div>




<input type="button" id="btnmyModal3" style="display:none" data-toggle="modal" data-target="#myModal3" value="添加表单" />
<div class="modal fade" id="myModal3" tabindex="-1" role="dialog" aria-labelledby="myModalLabel">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">添加选项</h4>
            </div>
            <div class="modal-body">
                <input type="hidden" value="" id="setid">
                <div class="row">
                    <form id="form">
                        <input type="hidden" value="" name="ID" />
                        <input type="hidden" value="" name="ItemID" />
                        <div class="form-group" style="padding-bottom:50px;">
                            <label class="col-sm-2 control-label">名称</label>
                            <div class="col-sm-10">
                                <input type="text" class="form-control" name="Name" placeholder="名称">
                            </div>
                        </div>
                        <div class="form-group" style="padding-bottom:50px;">
                            <label class="col-sm-2 control-label">排序号</label>
                            <div class="col-sm-10">
                                <input type="number" class="form-control" name="Order" placeholder="排序号">
                            </div>
                        </div>
                        <div class="form-group" style="padding-bottom:50px;">
                            <label class="col-sm-2 control-label">可自定义</label>
