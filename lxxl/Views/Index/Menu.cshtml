@using lxxl.Models;
@{
    ViewBag.Title = "菜单管理";
    Layout = "~/Views/Shared/_LayoutHome.cshtml";
}

<div class="main-content">
    <!-- #section:basics/content.breadcrumbs -->
    <div class="breadcrumbs breadcrumbs-fixed" id="breadcrumbs">
        <script type="text/javascript">
            try { ace.settings.check('breadcrumbs', 'fixed') } catch (e) { }
        </script>
        <ul class="breadcrumb">
            <li>
                <i class="ace-icon fa fa-home home-icon"></i>
                <a href="@Url.Action("Index", "Index")">
                    首页
                </a>
            </li>
            <li class="active">菜单管理</li>
        </ul>
        <!-- /.breadcrumb -->
        <!-- #section:basics/content.searchbox -->
        <div class="nav-search" id="nav-search" style="display: none">
            <form action="javascript:alert('开发中')" method="post" class="form-search">
                <span class="input-icon">
                    <input type="text" placeholder="Search ..." class="nav-search-input" id="nav-search-input" autocomplete="off" />
                    <i class="ace-icon fa fa-search nav-search-icon"></i>
                </span>
            </form>
        </div>
        <!-- /.nav-search -->
        <!-- /section:basics/content.searchbox -->
    </div>
    <!-- /section:basics/content.breadcrumbs -->
    <div class="page-content">
        <div class="row">
            <div class="col-xs-12">
                <!-- PAGE CONTENT BEGINS -->
                <div class="row">
                    @if (Session["alert"] != null)
                    {
                        <div class="col-xs-12 col-sm-8 col-sm-offset-2">
                            <div class="alert alert-warning alert-danger" role="alert">
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                                @Session["alert"]
                                @(Session["alert"] = null)
                            </div>
                        </div>
                        <div class="col-xs-0 col-sm-2">
                        </div>
                    }
                </div>
                <div class="row">
                    <div class="col-xs-12" style="height: 50px;">
                        <a href="@Url.Action("AddMenu", "Index")" class="btn btn-danger addnew addtype">新增一级菜单</a>
                    </div>
                    @{
                        if (Session["Menu"] != null)
                        {
                            List<T_Menu> menus = (Session["Menu"] as List<T_Menu>).OrderBy(o => o.OrderTag).Where(o => !o.IsDelete).ToList();
                            foreach (var menu in menus)
                            {
                                if (menu.MenuID == 0)
                                {

                                    <div class="col-xs-12 col-sm-6 widget-container-col">
                                        <!-- #section:custom/widget-box -->
                                        <div class="widget-box">
                                            <div class="widget-header">
                                                <h5 class="widget-title">@(menu.MenuName)(@(menu.Show ? "显示" : "隐藏"))(@(menu.Type == 1 ? "新闻列表" : menu.Type == 2 ? "跳至首文" : menu.Type == 3 ? "跳转链接" : "类型异常"))</h5>
                                                <!-- #section:custom/widget-box.toolbar -->
                                                <div class="widget-toolbar">

                                                    <div class="widget-menu">
                                                        <a href="#" data-action="settings" data-toggle="dropdown">
                                                            <i class="ace-icon fa fa-bars"></i>
                                                        </a>

                                                        <ul class="dropdown-menu dropdown-menu-right dropdown-light-blue dropdown-caret dropdown-closer">
                                                            <li>
                                                                <a href="@Url.Action("AddMenu", "Index", new { menuid = menu.ID })">新增</a>
                                                            </li>
                                                            <li>
                                                                <a href="@Url.Action("EditMenu", "Index", new { id = menu.ID })">编辑</a>
                                                            </li>

                                                            <li>
                                                                <a class="DeleteMenu" onclick="return confirm('是否确认删除该菜单，确认将删除该菜单及其子菜单内所有内容')" href="@Url.Action("DelMenu", "Index", new { id = menu.ID, hosturl = this.Request.Url })">删除</a>
                                                            </li>
                                                        </ul>
                                                    </div>

                                                    <a href="#" data-action="fullscreen" class="orange2">
                                                        <i class="ace-icon fa fa-expand"></i>
                                                    </a>

                                                    <a href="#" data-action="reload">
                                                        <i class="ace-icon fa fa-refresh"></i>
                                                    </a>

                                                    <a href="#" data-action="collapse">
                                                        <i class="ace-icon fa fa-chevron-down"></i>
                                                    </a>

                                                    <a href="#" data-action="close">
                                                        <i class="ace-icon fa fa-times"></i>
                                                    </a>
                                                </div>

                                                <!-- /section:custom/widget-box.toolbar -->
                                            </div>

                                            <div class="widget-body">
                                                <div class="widget-body-inner" style="overflow: hidden; display: none;">
                                                    <div class="widget-main">
                                                        <div class="row">
                                                            <div class="col-xs-12">
                                                                <table id="sample-table-1" class="table table-striped table-bordered table-hover">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>编号</th>
                                                                            <th>名称</th>

                                                                            <th>
                                                                                <i class="ace-icon fa fa-clock-o bigger-110 hidden-480"></i>
                                                                                是否显示
                                                                            </th>
                                                                            <th class="hidden-480">排序</th>
                                                                            <th class="hidden-480">类型</th>
                                                                            <th class="hidden-480">操作</th>
                                                                        </tr>
                                                                    </thead>

                                                                    <tbody>
                                                                        @foreach (var zimenu in menus)
                                                                        {
                                                                            if (menu.ID == zimenu.MenuID)
                                                                            {
                                                                                <tr>
                                                                                    <td class="hidden-480">
                                                                                        <span class="label label-sm label-warning">@zimenu.OrderTag</span>
                                                                                    </td>
                                                                                    <td>@zimenu.MenuName</td>
                                                                                    <td class="hidden-480">@(zimenu.Show ? "是" : "否")</td>

                                                                                    <td class="hidden-480">
                                                                                        @zimenu.OrderTag
                                                                                    </td>
                                                                                    <td>
                                                                                        @(zimenu.Type == 1 ? "新闻列表" : zimenu.Type == 2 ? "跳至首文" : zimenu.Type == 3 ? "跳转链接" : "类型异常")
                                                                                    </td>
                                                                                    <td>
                                                                                        <div class="hidden-sm hidden-xs btn-group">

                                                                                            <a class="btn btn-xs btn-info" href="@Url.Action("EditMenu", "Index", new { id = zimenu.ID })">
                                                                                                <i class="ace-icon fa fa-pencil bigger-120"></i>编辑
                                                                                            </a>
                                                                                            <a class="btn btn-xs btn-danger" href="@Url.Action("DelMenu", "Index", new { id = zimenu.ID, hosturl = this.Request.Url })">
                                                                                                <i class="ace-icon fa fa-trash-o bigger-120"></i>删除
                                                                                            </a>
                                                                                            <a class="btn btn-xs btn-warning" href="@Url.Action("ContentList", "Index", new { MenuID=zimenu.ID})" target="_blank">
                                                                                                <i class="ace-icon fa fa-flag bigger-120"></i>预览
                                                                                            </a>
                                                                                        </div>

                                                                                        <div class="hidden-md hidden-lg">
                                                                                            <div class="inline position-relative">
                                                                                                <button class="btn btn-minier btn-primary dropdown-toggle" data-toggle="dropdown" data-position="auto">
                                                                                                    <i class="ace-icon fa fa-cog icon-only bigger-110"></i>
                                                                                                </button>

                                                                                                <ul class="dropdown-menu dropdown-only-icon dropdown-yellow dropdown-menu-right dropdown-caret dropdown-close">
                                                                                                    <li>
                                                                                                        <a href="javascript:" class="tooltip-info" data-rel="tooltip" title="View">
                                                                                                            <span class="blue">
                                                                                                                <i class="ace-icon fa fa-search-plus bigger-120"></i>
                                                                                                            </span>
                                                                                                        </a>
                                                                                                    </li>

                                                                                                    <li>
                                                                                                        <a href="#" class="tooltip-success" data-rel="tooltip" title="Edit">
                                                                                                            <span class="green">
                                                                                                                <i class="ace-icon fa fa-pencil-square-o bigger-120"></i>
                                                                                                            </span>
                                                                                                        </a>
                                                                                                    </li>

                                                                                                    <li>
                                                                                                        <a href="#" class="tooltip-error" data-rel="tooltip" title="Delete">
                                                                                                            <span class="red">
                                                                                                                <i class="ace-icon fa fa-trash-o bigger-120"></i>
                                                                                                            </span>
                                                                                                        </a>
                                                                                                    </li>
                                                                                                </ul>
                                                                                            </div>
                                                                                        </div>
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div><!-- /.span -->
                                                        </div><!-- /.row -->
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- /section:custom/widget-box -->
                                    </div>
                                }
                            }
                        }

                    }

                </div><!-- /.row -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.page-content -->
</div>
