@using lxxl.Models;
@{
    Layout = "~/Views/Shared/_LayoutPatient.cshtml";
    T_User Patient = ViewBag.Patient;
}

<div id="container" class="page-bd" style="top: 46px; padding-top: 46px; background-color: #F8F8F8; ">

    <div class="weui-panel weui-panel_access">
        <div class="weui-panel__hd">个人信息</div>
        <div class="weui-panel__ft">
            <a href="javascript:void(0);" class="weui-media-box weui-media-box_appmsg">
                <div class="weui-media-box__hd weui-avatar-circle">
                    <img class="weui-media-box__thumb" src="@Patient.TopUrl" alt="" style="height:60px;">
                </div>
                <div class="weui-media-box__bd">
                    <h4 class="weui-media-box__title">@Patient.Name</h4>
                    <p class="weui-media-box__desc">@(Patient.Age) 岁 &nbsp;&nbsp;<small>@Patient.Sex</small></p>
                </div>
                <div class="weui-media-box__hd">
                    <span class="weui-cell__ft"></span>
                </div>
            </a>
        </div>
        <div class="weui-panel__ft">
            <a href="javascript:void(0);" onclick="viewMore(this);" id="viewMore" class="weui-cell weui-cell_access weui-cell_link js-show">
                <div class="weui-cell__bd">查看更多</div>
                <i class="icon icon-74"></i>
            </a>
        </div>

        <div class="weui_panel_bd" id="reg_index" style="display:none;">
            <form action="EditUser" method="post" id="edituser">
                <div class="weui-cells weui-cells_form" style="margin-top: 0;">
                    <div class="weui-cell">
                        <div class="weui-cell__hd"><label class="weui-label">姓名</label></div>
                        <div class="weui-cell__bd">
                            <input type="text" id="ID" hidden value="@Patient.ID">
                            <input class="weui-input" placeholder="请输入姓名" type="text" required name="Name" id="Name" value="@Patient.Name">
                        </div>
                    </div>
                    <div class="weui-cell">
                        <div class="weui-cell__hd">
                            <label class="weui-label">手机号</label>
                        </div>
                        <div class="weui-cell__bd">
                            <input class="weui-input" placeholder="请输入手机号" type="tel" required name="Tel" id="Tel" value="@Patient.Tel">
                        </div>
                    </div>
                    <div class="weui-cell">
                        <div class="weui-cell__hd">
                            <label class="weui-label">邮箱</label>
                        </div>
                        <div class="weui-cell__bd">
                            <input class="weui-input" placeholder="请输入邮箱" type="email" required name="Mail" id="Mail" value="@Patient.Mail">
                        </div>
                    </div>
                    <div class="weui-cell">
                        <div class="weui-cell__hd">
                            <label class="weui-label">性别</label>
                        </div>
                        <div class="weui-cell__bd">
                            <div class="weui-form-li iblock" style="margin: 0px 5px;">
                                <input class="weui-form-checkbox" type="radio" name="Sex" id="male" value="男" checked="@(Patient.Sex != null && Patient.Sex == "男")">
                                <label for="male">
                                    <i class="weui-icon-radio" style="margin-right: 0px;"></i>
                                    <div class="weui-form-text"><p>男</p></div>
                                </label>
                            </div>
                            <div class="weui-form-li iblock" style="margin: 0px 5px;">
                                <input class="weui-form-checkbox" type="radio" name="Sex" id="female" value="女" checked="@(Patient.Sex != null && Patient.Sex == "女")">
                                <label for="female">
                                    <i class="weui-icon-radio" style="margin-right: 0px;"></i>
                                    <div class="weui-form-text"><p>女</p></div>
                                </label>
                            </div>
                        </div>                        
                    </div>
                    <div class="weui-cell">
                        <div class="weui-cell__hd"><label class="weui-label">年龄</label></div>
                        <div class="weui-cell__bd">
                            <input class="weui-input" pattern="[0-9]*" placeholder="请输入年龄" type="number" name="Age" id="Age" value="@Patient.Age">
                        </div>
                    </div>
                    @*<div class="weui-cell">
                <div class="weui-cell__hd"><label class="weui-label">date</label></div>
                <div class="weui-cell__bd">
                    <input class="weui-input" type="date" name="Age" value="@Patient.b">
                </div>
            </div>*@

                    <div class="weui-btn-area" style="margin:0.5em 15px 1.5em;">
                        @*<input type="submit" class="weui_btn weui_btn_primary btnSubmit" value="提交更新" style="background-color: #3A87AD;" />*@
                        <a type="submit" class="weui-btn weui-btn_primary" href="javascript:" id="btn">提交更新</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    
    <div class="weui-panel" style="padding-bottom:20px;">
        <div class="weui-panel__hd">列表</div>
        <div class="weui-panel__bd">
            <div class="weui-media-box weui-media-box_small-appmsg">
                <div class="weui-cells">
                    <a class="weui-cell weui-cell_access" href="@Url.Action("myOrder", "Patient")">
                        <div class="weui-cell__hd"><img src="data:image/png;base64," alt="" style="width:20px;margin-right:5px;display:block"></div>
                        <div class="weui-cell__bd weui-cell_primary">
                            <p>预约订单</p>
                        </div>
                        <span class="weui-cell__ft"></span>
                    </a>
                    <a class="weui-cell weui-cell_access" href="@Url.Action("myConsulation", "Patient")">
                        <div class="weui-cell__hd"><img src="data:image/png;base64," alt="" style="width:20px;margin-right:5px;display:block"></div>
                        <div class="weui-cell__bd weui-cell_primary">
                            <p>咨询记录</p>
                        </div>
                        <span class="weui-cell__ft"></span>
                    </a>
                    <a class="weui-cell weui-cell_access" href="@Url.Action("myConsulation", "Patient")">
                        <div class="weui-cell__hd"><img src="data:image/png;base64," alt="" style="width:20px;margin-right:5px;display:block"></div>
                        <div class="weui-cell__bd weui-cell_primary">
                            <p>咨询师</p>
                        </div>
                        <span class="weui-cell__ft"></span>
                    </a>
                    @*<a class="weui-cell weui-cell_access" href="/wapform/wenjuan?gId=98c5cba8c74e44f3b15069a581c72b9a">
                        <div class="weui-cell__hd"><img src="data:image/png;base64," alt="" style="width:20px;margin-right:5px;display:block"></div>
                        <div class="weui-cell__bd weui-cell_primary">
                            <p>我的信息</p>
                        </div>
                        <span class="weui-cell__ft"></span>
                    </a>*@
                    <a class="weui-cell weui-cell_access" href="/wapForm/register">
                        <div class="weui-cell__hd"><img src="data:image/png;base64," alt="" style="width:20px;margin-right:5px;display:block"></div>
                        <div class="weui-cell__bd weui-cell_primary">
                            <p>我的登记表</p>
                        </div>
                        <span class="weui-cell__ft"></span>
                    </a>
                    <a class="weui-cell weui-cell_access" href="@Url.Action("notices", "Patient")">
                        <div class="weui-cell__hd"><img src="data:image/png;base64," alt="" style="width:20px;margin-right:5px;display:block"></div>
                        <div class="weui-cell__bd weui-cell_primary">
                            <p>我的通知</p>
                        </div>
                        <span class="weui-cell__ft"></span>
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

<link href="~/Content/css/validform.css" rel="stylesheet" />
<script src="~/Content/js/Validform_v5.3.2.js"></script>
<script>
    $(function () {
        $("#edituser").Validform({
            tiptype: function (msg, o) {
                if (msg.length != 0 && msg.indexOf("status") == -1 && msg.indexOf("正在提交数据") == -1)
                    alert(msg);
            },
            ajaxPost: true,
            callback: function (data) {
                console.log(data);
                if (data.responseText.split(":")[0] == "no") {
                    alert(data.responseText.split(":")[1]);
                } else if (data.responseText.split(":")[0] == "url") {
                    alert("保存成功");
                    location.reload();
                } else {
                    alert("服务器连接异常,请刷新页面");
                }
            },
            tipSweep: true
        });
        var abcd = 1;
        $(document).on("click", "#btn", function () {
            if (abcd == 1) {
                abcd = 2;
                var Name = $("#Name").val();
                if (Name == "") {
                    $.toptip("姓名不能为空");
                    abcd = 1
                    return false;
                }
                var Tel = $("#Tel").val();
                if (Tel == "") {
                    $.toptip("联系方式不能为空");
                    abcd = 1
                    return false;
                }
                else if (Tel.length != 11) {
                    $.toptip("联系方式需11位");
                    abcd = 1
                    return false;
                }
                var email = $("#Mail").val();
                //if (email == "") {
                //    $.toptip("邮箱不能为空");
                //    abcd = 1
                //    return false;
                //}
                //else if (!isValidEmailAddress(email)) {
                //    $.toptip("邮箱格式不正确");
                //    abcd = 1
                //    return false;
                //}
                var Age = $("#Age").val();
                var Sex = "男";
                var radios = document.getElementsByName("Sex");
                for(var i=0;i<radios.length;i++){
                    if(radios[i].checked == true){
                        Sex = radios[i].value;
                    }
                }
                var ID = $("#ID").val();
                $.ajax({
                    url: "/Patient/EditUser",
                    data: { "ID": ID, "Name": Name, "Tel": Tel, "Mail": email, "Age": Age, "Sex": Sex },
                    type: "post",
                    dataType: "text",
                    success: function (data) {
                        var result = JSON.parse(data);
                        if (result.code == 0) {
                            abcd = 1
                            $.alert("<span style='color:#fd7d36;font-weight: bold;font-size: 20px; '>" + Name + "</span>" + "，您已修改个人信息。", "提示", function () {
                                //window.location.reload();
                            });
                        }
                        else {
                            abcd = 1
                            alert(result.msg);
                        }
                    },
                    error: function () {
                        abcd = 1
                        alert("服务器连接失败");
                    }
                })
            }
        });
    })
    function isValidEmailAddress(emailAddress) {
        var pattern = /^\w+((-\w+)|(\.\w+))*\@@[A-Za-z0-9]+((\.|-)[A-Za-z0-9]+)*\.[A-Za-z0-9]+$/;
        return pattern.test(emailAddress);
    };
    $(document).ready(function () {
        document.getElementById("headerTitle").innerHTML = "个人中心";
        document.getElementsByClassName("weui-tabbar__item")[2].classList.remove("tabbarActive"); // 删除之前已选中tab的样式
        document.getElementsByClassName("weui-tabbar__item")[4].classList.add("tabbarActive");
    });
    
    function viewMore(value) {
        //alert(1)
    }
    $('#viewMore').click(function () {
        if ($(this).hasClass('js-show')) {
            $(this).removeClass('js-show');
            $(this).children('i').removeClass('icon-35').addClass('icon-74');
            document.getElementById("reg_index").style.display = 'block';
        } else {
            $(this).addClass('js-show');
            $(this).children('i').removeClass('icon-74').addClass('icon-35');
            document.getElementById("reg_index").style.display = 'none';
        }
    });
</script>
