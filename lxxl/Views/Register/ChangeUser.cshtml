@using lxxl.Models
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=0.0, user-scalable=no, minimum-scale=1.0, maximum-scale=1.0" />
    <link rel="stylesheet" type="text/css" href="/Content/wx/css/style.css" />
    <link rel="stylesheet" href="/Content/wx/css/weui.css" />
    <link rel="stylesheet" href="/Content/wx/css/example.css" />
    <link rel="stylesheet" type="text/css" href="/Content/wx/css/bootstrap.css">
    <script src="/Content/wx/js/jquery-1.10.2.js"></script>
    <script type="text/javascript">$(function () { $.getScript("/Content/wx/js/script.js"); })</script>
    <title>Log in</title>
</head>
<body>
    <div id="header" class="head">
        <div class="wrap">
            <div class="title">
                <span class="title_d"><p>Log in</p></span>
                <div class="clear"></div>
            </div>
        </div>
    </div>
    <div id="container">
        <div id="content" style="margin-bottom:5em;">
            <div class="weui_panel_bd">
                <div class="weui_cell">
                    Please log in with registered phone.：
                </div>
                <form method="post" id="ChangeUser" action="ChangeUser">
                    <div class="weui_cells weui_cells_form">
                        <div class="weui_cell">
                            <div class="weui_cell_hd"><label for="" class="weui_label">Phone</label></div>
                            <div class="weui_cell_bd weui_cell_primary">
                                <input class="weui_input" type="text" id="txtUser1" datatype="m" nullmsg="Please enter your mobile number" errormsg="Please input the correct mobile number" name="Tel" value="" placeholder="Phone" />
                            </div>
                        </div>
                        <div class="weui_cell  weui_vcode">
                            <div class="weui_cell_hd"><label for="" class="weui_label">Code</label></div>
                            <div class="weui_cell_bd weui_cell_primary">
                                <input type="text" class="weui_input" datatype="*" nullmsg="Verification code cannot be empty" id="imgcode" name="imgcode" placeholder="code" />
                            </div>
                            <div class="weui_cell_ft">
                                <a id="sendMobileCode" href="javascript:void(0);">
                                    <span id="zphone" class="weui_btn weui_btn_default"
                                          onclick="get_mobile_code();">Get code</span>
                                </a>
                            </div>
                        </div>
                        @*<div class="weui_cell">
                                <div class="weui_cell_hd"><label for="" class="weui_label">密码</label></div>
                                <div class="weui_cell_bd weui_cell_primary">
                                    <input class="weui_input" type="password" datatype="s6-18" nullmsg="密码不能为空" errormsg="密码为6到18位字符!" name="PassWord" value="" placeholder="密码" />
                                </div>
                            </div>*@

                        <div class="weui_btn_area">
                            <input type="submit" class="weui_btn_primary login_submit yesbtn" style="background-color: #3A87AD;" value="Log in" />
                        </div>
                        <div class="weui_cell">
                            <a href="@Url.Action("Index", "Doctor")" class="weui_btn weui_btn_default">Log in by WeChat account</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>
<!--验证表单-->
<link href="~/Content/css/validform.css" rel="stylesheet" />
<script src="~/Content/js/Validform_v5.3.2.js"></script>

<script type="text/javascript">
    var doc = null;
    $(function () {
        $.Tipmsg.r = null;
        doc = $("#ChangeUser").Validform({
            tiptype: function (msg, o) {
                if (msg.length != 0 && msg.indexOf("status") == -1 && msg.indexOf("正在提交数据") == -1)
                    alert(msg);
            },
            //ajaxPost: true,
            //beforeSubmit: function (data) {
            //    $("#serverIds").click();
            //    return false;
            //},
            //tipSweep: true
            ajaxPost: true,
            callback: function (data) {
                console.log(data);
                if (data.responseText.split(":")[0] == "no") {
                    alert(data.responseText.split(":")[1]);
                } else if (data.responseText.split(":")[0] == "url") {
                    alert("login success");
                    location.href = data.responseText.split(":")[1];
                } else {
                    alert("服务器连接异常,请刷新页面");
                }
            },
            tipSweep: true,
        });
    })
</script>
<script type="text/javascript">
    function get_mobile_code() {
        var myreg = /^13[0-9]{9}$|14[0-9]{9}|15[0-9]{9}$|18[0-9]{9}$|17[0-9]{9}$|16[0-9]{9}$|19[0-9]{9}$/;
        //var myreg = /^(0|86|17951)?(13[0-9]|15[012356789]|17[678]|18[0-9]|14[57])[0-9]{8}$/;
        if (!myreg.test($("#txtUser1").val())) {
            alert("Please enter the correct mobile number!");
        }
        else {
            $.get('/Register/acRegistered', { tel: $.trim($('#txtUser1').val()), type: 1 }, function (msg) {
                if (msg == '不存在') {
                    alert("该号码尚未注册，无法获取验证码");
                }
                else if (msg == '存在') {
                    $.get('/Register/SendMsgType', { tel: $.trim($('#txtUser1').val()), type: 1 }, function (msg) {
                        if (msg == '发送成功') {
                            RemainTime();
                            alert("get code success");
                            //$('#sjmsg').html('手机验证码发送成功，请打开手机查看');
                        }
                        else {
                            alert("get code error");
                        }
                    });
                }
            });


        }
    };

    //RemainTime();
    var iTime = 59;
    var Account;
    function RemainTime() {
        $("#zphone").removeAttr("onclick");
        //$("#zphone").attr("class", "form_btn_text1");
        var iSecond, sSecond = "", sTime = "";
        if (iTime >= 0) {
            iSecond = parseInt(iTime % 60);
            iMinute = parseInt(iTime / 60)
            if (iSecond >= 0) {
                if (iMinute > 0) {
                    sSecond = iMinute + "分" + iSecond + "秒";
                } else {
                    sSecond = iSecond + "秒";
                }
            }
            sTime = sSecond + "后重新获取";
            if (iTime == 0) {
                clearTimeout(Account);
                sTime = '获取验证码';
                iTime = 59;
                $("#zphone").attr("onclick", "get_mobile_code()");
                //$("#zphone").attr("class", "mybutton form_btn_text weui_btn weui_btn_primary");
            } else {
                Account = setTimeout("RemainTime()", 1000);
                iTime = iTime - 1;

            }
        } else {
            sTime = '没有倒计时';
        }
        $('#zphone').html(sTime);
    }
</script>