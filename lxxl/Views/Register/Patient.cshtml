<script type="text/javascript">
    function get_mobile_code() {
        var myreg = /^(0|86|17951)?(13[0-9]|15[012356789]|17[678]|18[0-9]|14[57])[0-9]{8}$/;
        if (!myreg.test($("#txtUser1").val())) {
            alert("请输入正确的手机号码!");
        }
        else {
            $.get('/Register/acRegistered', { tel: $.trim($('#txtUser1').val()), type: 2 }, function (msg) {
                if (msg == '存在') {
                    alert("该号码已存在，无法获取验证码");
                }
                else if (msg == '不存在') {
                    $.get('/Register/SendMsgType', { tel: $.trim($('#txtUser1').val()) }, function (msg) {
                        if (msg == '发送成功') {
                            alert("获取验证码成功");
                            RemainTime();
                            //$('#sjmsg').html('手机验证码发送成功，请打开手机查看');
                        }
                        else {
                            alert("获取验证码失败");
                        }
                    });
                }
            });


        }
    };

    //RemainTime();
    var iTime = 59;
    var Account;
    function RemainTime() {
        $("#zphone").removeAttr("onclick");
        //$("#zphone").attr("class", "weui_btn weui_btn_default");
        var iSecond, sSecond = "", sTime = "";
        if (iTime >= 0) {
            iSecond = parseInt(iTime % 60);
            iMinute = parseInt(iTime / 60)
            if (iSecond >= 0) {
                if (iMinute > 0) {
                    sSecond = iMinute + "分" + iSecond + "秒";
                } else {
                    sSecond = iSecond + "秒";
                }
            }
            sTime = sSecond + "后重新获取";
            if (iTime == 0) {
                clearTimeout(Account);
                sTime = '获取验证码';
                iTime = 59;
                $("#zphone").attr("onclick", "get_mobile_code()");
                //$("#zphone").attr("class", "weui_btn weui_btn_default");
            } else {
                Account = setTimeout("RemainTime()", 1000);
                iTime = iTime - 1;

            }
        } else {
            sTime = '没有倒计时';
        }
        $('#zphone').html(sTime);
    }
</script>
<script type="text/javascript">
    $(function () {
        $('#reg_now1').bind('click', function () {
            document.getElementById('content_wrapper2').style.display = 'none';
