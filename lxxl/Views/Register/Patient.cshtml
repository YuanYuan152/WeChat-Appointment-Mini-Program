        });
        $('#reg_now2').bind('click', function () {
            document.getElementById('content_wrapper1').style.display = 'none';
            document.getElementById('content_wrapper2').style.display = 'block';
            document.getElementById('f1nr').innerHTML = "连心心理隐私权政策";
            $('#reg_index1').addClass('show');
            $(window).unbind('touchmove');
        });
        $('.reg_bar_close').bind('touchstart touchend click',
        function (e) {
            if (e.type == 'touchstart') {
                $(this).addClass('ton1');
            } else if (e.type == 'touchend') {
                $(this).removeClass('ton1');
            } else {
                if (document.getElementById('us_panel')) {
                    $('#reg_index1').removeClass('show');
                    $(window).bind('touchmove',
                    function (e) {
                        e.preventDefault();
                        e.stopImmediatePropagation();
                    });
                } else {
                    $('#reg_index1').removeClass('show');
                }
            }
        });
    })
</script>
<script type="text/javascript">
    $(function () {
        $(".surebtn").change(function () {
            if ($(this).is(':checked')) {
                $(".yesbtn").attr("disabled", false);
                $(".yesbtn").css("background-color", "#3A87AD");
            }
            else {
                $(".yesbtn").attr("disabled", true);
                $(".yesbtn").css("background-color", "#CCC");
            }
        }).change();
    })
</script>