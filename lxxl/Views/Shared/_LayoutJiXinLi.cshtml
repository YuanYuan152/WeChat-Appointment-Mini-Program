    <script type="text/javascript" src="/Public/js/layer/layer.js"></script>
    <script type="text/javascript">
        $(function () {
            //菜单激活
            $(".nav-list li").click(function () {
                $this = $(this);
                if ($this.attr("id")) {
                    localStorage.active = $this.attr("id");
                }
            })
            var active = localStorage.active;
            $("#" + localStorage.active).addClass("active");
            if (!$(".nav-list").find("#" + active).hasClass('hsub')) {
                $(".nav-list").find("#" + active).parent().parent().addClass("open").addClass("active");
                $(".nav-list").find("#" + active).parent().stop().slideDown('normal');
            }
        })
    </script>
    <script>
        $('.sendf').click(function () {
            var from_id = $(this).attr('from_id');
            console.log(1)
            $.ajax({
                url: "/home/PostMessage",
                type: "post",
                dataType: "json",
                data: $('#' + from_id).serialize(),
                success: function (request) {
                    if (request.code == 1) {
                        showErrorMsg(request.msg);
                        setTimeout(function () {
                            window.location.reload();
                            console.log(request)
                        }, 2000);
                        return false;
                    } else {
                        showErrorMsg(request.msg);
                        return false;
                    }

                },
                error: function (request) {
                    showErrorMsg("服务器繁忙, 请联系管理员!");
                    return false;
                }
            });
        });
        function showErrorMsg(msg) {
            layer.open({ title: '提示', content: msg });
        }
    </script>

