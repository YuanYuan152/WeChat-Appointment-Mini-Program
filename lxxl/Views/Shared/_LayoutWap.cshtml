    <script>
        $('.sendf').click(function () {
            var from_id = $(this).attr('from_id');
            $.ajax({
                url: "/home/PostMessage",
                type: "post",
                dataType: "json",
                data: $('#' + from_id).serialize(),
                success: function (request) {
                    if (request.code == 1) {
                        showErrorMsg(request.msg);
                        setTimeout(function () {
                            window.location.reload();
                            // console.log(request)
                        }, 2000);
                        return false;
                    } else {
                        showErrorMsg(request.msg);
                        return false;
                    }

                },
                error: function (request) {
                    showErrorMsg("服务器繁忙, 请联系管理员!");
                    return false;
                }
            });
        });
        function showErrorMsg(msg) {
            layer.open({ title: '提示', content: msg });
        }
    </script>
