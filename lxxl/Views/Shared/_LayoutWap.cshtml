        var clock = '';
        var nums = 30;
        var btn;
        function sendCode(thisBtn) {
            btn = thisBtn;
            btn.disabled = true; //将按钮置为不可点击

            get_mobile_code();
        }

        function get_mobile_code() {
            var myreg = /^\+?[1-9]\d{1,14}$/;
            //var myreg = /^(0|86|17951)?(13[0-9]|15[012356789]|17[678]|18[0-9]|14[57])[0-9]{8}$/;
            //var regEmail = /^([a-zA-Z]|[0-9])(\w|\-)+[a-zA-Z0-9]+\.([a-zA-Z]{2,4})$/;
            if (!myreg.test($("#regist_phone").val())) {
                layer.alert("请输入正确的手机号码!");
                btn.disabled = false;
            }
            //else if (!regEmail.test($("#regist_phone").val()))//Email地址形式上就不对
            //{
            //    alert("请输入合法的邮箱!");
            //    btn.disabled = false;
            //}
            else {
                btn.value = '重新获取（' + nums + '）';
                clock = setInterval(doLoop, 1000); //一秒执行一次
                $.get('/Register/acRegistered', { tel: $.trim($('#regist_phone').val()), type: 0 }, function (msg) {
                    if (msg == '存在') {
                        alert("该号码已存在，无法获取验证码");
                    }
                    else if (msg == '不存在') {
                        $.get('/Register/SendMsgType', { tel: $.trim($('#regist_phone').val()) }, function (msg) {
                            if (msg == '发送成功') {
                                layer.alert("已发送验证码，请查收！");

                            }
                            else {
                                layer.alert("获取验证码失败");
                            }
                        });
                    }
                });


            }
        };

        function doLoop() {
            nums--;
            if (nums > 0) {
                btn.value = '重新获取（' + nums + '）';
            } else {
                clearInterval(clock); //清除js定时器
                btn.disabled = false;
                btn.value = '点击发送验证码';
                nums = 30; //重置时间
            }
        }

