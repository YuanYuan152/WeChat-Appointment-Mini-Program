                    if (request.code == 1) {
                        showErrorMsg(request.data);
                        setTimeout(function () {
                            window.location.reload();
                            // console.log(request)
                        }, 2000);
                        return false;
                    } else {
                        showErrorMsg(request.data);
                        return false;
                    }

                },
                error: function (request) {
                    showErrorMsg("服务器繁忙, 请联系管理员!");
                    return false;
                }
            });
        });
        function showErrorMsg(msg) {
            layer.open({ title: '提示', content: msg });
        }
