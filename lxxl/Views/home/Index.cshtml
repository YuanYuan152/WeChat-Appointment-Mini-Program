<style>
    a:link, a:visited {
        text-decoration: none;
        outline: none;
        color: #fff;
    }

    .cou-teambaner .slick-slide .img div {
        position: absolute;
        left: 0;
        bottom: -100%;
        padding: 18px;
        height: 100%;
        width: 100%;
        color: #fff;
        font-size: 14px;
        background: rgba(27, 94, 143, 0.78);
        transition: all .5s cubic-bezier(0.6, 0.23, 0.46, 1.02);
    }

    .cou-teambaner .slick-slide .img div {
        overflow: scroll;
    }

        .cou-teambaner .slick-slide .img div::-webkit-scrollbar {
            width: 6px;
            height: 1px;
        }

        .cou-teambaner .slick-slide .img div::-webkit-scrollbar-thumb {
            border-radius: 10px;
            -webkit-box-shadow: inset 0 0 5px rgba(0,0,0,0.2);
            background: #1b5e8f;
        }

        .cou-teambaner .slick-slide .img div::-webkit-scrollbar-track {
            -webkit-box-shadow: inset 0 0 5px rgba(0,0,0,0.2);
            border-radius: 10px;
            background: rgba(237, 237, 237, 0.64);
        }

    .cou-teambaner .slick-slide:hover .img div {
        bottom: 0;
    }

    .course-butmmy {
        text-align: center;
    }

        .course-butmmy a:nth-child(1) {
            background: #fff;
            color: #1b5e8f;
        }

        .course-butmmy a {
            display: inline-block;
            width: 80px;
            height: 21px;
            text-align: center;
            line-height: 21px;
            font-size: 10px;
            border-radius: 25px;
            margin: 10px 5px;
            box-shadow: 0 0 10px rgba(204,204,223,0.5);
        }

    .institution-con ul li .img div {
        position: absolute;
        left: 0;
        bottom: 0;
        color: #ffffff;
        font-size: 12px;
        background: rgba(249, 213, 153, 0.7);
        transition: all .5s cubic-bezier(0.6, 0.23, 0.46, 1.02);
        text-align: center;
        width: 176px;
        height: 0;
    }

    /*.institution-con ul li .img:hover div {
        bottom: 0;
    }*/
    /*.institution-con ul li:hover .img {
        background: url(../images/course-icon04-1.png) no-repeat center center;
    }*/

    .institution-con ul li:hover .img div {
        bottom: 0;
        position: absolute;
        height: 32px;
    }

    .institution-con ul li {
        margin-top: 15px;
    }
</style>
