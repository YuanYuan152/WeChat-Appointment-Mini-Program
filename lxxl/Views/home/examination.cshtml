@{
    ViewBag.Title = "examination";
    Layout = "~/Views/Shared/_LayoutWap.cshtml";
}
<style type="text/css">
    .campus .campus-box {
        width: 33.33%;
        padding: 0 40px;
    }

    .nav-course dl dd {
        border: 1px solid #a3a1a1;
        height: 100px;
    }

        .nav-course dl dd a {
            width: 100%;
            height: auto;
            line-height: 100px;
            font-size: 32px;
            margin-left: 27px;
            color: rgb(74,131,184);
            margin-top: 4%;
        }

    .nav-course .dl-course .select {
        background: #ffffff;
        border: hidden;
    }

    .f-show {
        height: 100px;
        width: 85%;
        margin-left: 10%;
        height: 94%;
    }

        .f-show .fshow_a h3 {
            color: rgb(249,156,60);
            font-size: 30px;
        }

        .f-show .fshow_a h5 {
            color: rgb(249,156,60);
            font-size: 24px;
        }

    .advan {
        /*background-color: rgb(166,196,207);*/
        margin: 0 auto;
        padding-top: 5rem;
        padding-bottom: 5rem;
    }

    .ad_show {
        margin-top: 3.4rem;
        width: 1300px;
        display: flex;
        justify-content: center;
        margin: 20px auto;
    }

    .ad-item {
        width: 270px;
        height:393px;
        text-align: center;
        cursor: pointer;
        transition: all 0.1s;
        font-size: 0.14rem;
        z-index: 1;
        margin: 20px;
        background-image: url(/Public/biyou/course/examinationBj.png);
        background-size: 100%, 100%;
    }

        .ad-item .item1 {
            color: rgb(73,129,188);
            padding-bottom: 30px;
            padding-top: 80px;
        }

            .ad-item .item1 h5 {
                font-size: 22px;
                font-weight: 500;
            }

            .ad-item .item1 p {
                width: 60%;
                margin-left: 20%;
                margin-top: 5px;
            }



        .ad-item .item2 {
            height: 80px;
            text-align: center;
            align-content: center;
            background-color: rgb(73,129,188);
            font-size: 30px;
            color: #fff;
            align-items: center;
            display: flex;
        }

            .ad-item .item2 p {
                margin: 0 auto;
            }

        .ad-item .item3 {
            height: 200px;
        }

            .ad-item .item3 p {
                margin: 10px;
                color: rgb(166,196,207);
                font-size: 14px;
            }

        .ad-item > img {
            height: 100%;
            width: 100%;
            display: block;
        }

        .ad-item.on {
            z-index: 3;
            transform: scale(1.2);
            transition: all 0.5s;
            background-color: #fff;
        }

        /*.ad-item .item1.on {
            background-color: rgb(73,129,188);
            color: #fff;
        }

        .ad-item .item2.on {
            background-color: rgb(147,178,196);
        }*/


    .ad_list {
        height: 0.2rem;
        width: 100%;
        margin-top: 0.4rem;
        text-align: center;
    }

        .ad_list > span {
            height: 0.1rem;
            width: 0.1rem;
            border-radius: 50%;
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
            -ms-border-radius: 50%;
            -o-border-radius: 50%;
            background: #BBBBBB;
            display: inline-block;
            margin: 0 0.1rem;
        }

            .ad_list > span.on {
                background: #3784FF !important;
                width: 24px;
                border-radius: 5px;
                transform: all 0.5s;
            }
</style>
<div class="con">
    <section>
        <div class="banner-box">
            <div class="home_banner bannerx">
                <div class="ban-con">
                    <div class="img"><img id="domain_img" src="/Public/upload/ad/2019/5d41477ee4763.png"></div>
                    <div class="text">
                        <h3 class="wow fadeInRight" id="domain_name">连心心理·上海</h3>
                        <p class="none wow fadeInRight" id="domain_description">上海市杨浦区同济科技大厦</p>
                        <p class="none wow fadeInRight" id="domain_lecturer"></p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="campus">
            <div class="title fadeInUp wow">
                <h3>考试培优</h3>
            </div>
            <div class="advan">
                <div class="ad_show">
                    <div class="ad-item">
                        <div class="item1">
                            <h5>托福TOEFL</h5>
                            <p>
                                课程介绍课程介绍课程介绍课程介绍课程介绍
                            </p>
                        </div>
                        <div class="item3">
                            <img src="/Public/biyou/course/examination01.png" style="height: 100%; object-fit: none; text-align: right;">
                        </div>
                    </div>
                    <div class="ad-item ">
                        <div class="item1">
                            <h5>雅思IELTS</h5>
                            <p>
                                课程介绍课程介绍课程介绍课程介绍课程介绍
                            </p>
                        </div>
                        <div class="item3">
                            <img src="/Public/biyou/course/examination02.png" style="height: 100%; object-fit: none; text-align: right;">
                        </div>
                    </div>
                    <div class="ad-item on">
                        <div class="item1 on">
                            <h5>多邻国DUOLINGGUO</h5>
                            <p>
                                课程介绍课程介绍课程介绍课程介绍课程介绍
                            </p>
                        </div>
                        <div class="item3">
                            <img src="/Public/biyou/course/examination03.png" style="height: 100%; object-fit: none; text-align: right;">
                        </div>
                    </div>
                    <div class="ad-item ">
                        <div class="item1">
                            <h5>培优PTE</h5>
                            <p>
                                课程介绍课程介绍课程介绍课程介绍课程介绍
                            </p>
                        </div>
                        <div class="item3">
                            <img src="/Public/biyou/course/examination04.png" style="height: 100%; object-fit: none; text-align: right;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section>
        <div class="campus" style="margin: auto; padding-bottom: 60px; background-color: rgb(166,196,207);">
            <div style="margin: auto; width: 1060px; padding-bottom: 20px; padding-top: 60px; ">
                <table cellspacing="0" cellpadding="0">
                    <tbody>
                        <tr style=" background-color: rgb(149,178,196); text-align: center; color: white; font-size: 18px; line-height: 50px;">
                            <td width="198" style="border: none;">USNEWS排名</td>
                            <td width="198" style="border: none;">COLLEGSIMPLY排名</td>
                            <td width="198" style="border: none;">NICHE排名</td>
                            <td width="198" style="border: none;">大学名称</td>
                            <td width="198" style="border: none;">英文大学名称</td>
                        </tr>
                        @for (int i = 0; i < 20; i++)
                        {
                            <tr style="background-color: rgb(233,239,239); text-align: center; color: rgb(73,129,178); font-size: 16px; line-height: 38px; border-bottom: 1px solid rgb(213,214,216); ">
                                <td style="border: none;">1</td>
                                <td style="border: none;">2</td>
                                <td style="border: none;">3</td>
                                <td style="border: none;">普林斯顿大学</td>
                                <td style="border: none;">Princeton University</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
<script type="text/javascript">
    $(function () {
        localStorage.active = "activeCourse";
    })

    $('.nav-course .dl-course dd').on('click', function () {
        var index = $(this).index();
        //$(this).parent().siblings().children('.bot-con').css('left', '-' + index * 100 + '%');
        $(this).addClass('select').siblings().removeClass('select');
        $(".f-show .fshow_a").eq(index).show().siblings().hide();
        console.log($(this).eq(index));
    });


    var aa = new zturn({
        id: "zturn",
        opacity: 0.6,
        width: 235,
        Awidth: 1024,
        scale: 0.7,
    })

    $(document).ready(function () {
        $('.container-banner').slick({
            centerMode: true,
            slidesToShow: 1,
            arrows: false,
            centerMode: true,
            focusOnSelect: true,
            autoplay: true,
            autoplaySpeed: 2000,
            dots: true,
        });

    });
    var len = $(".ad-item").length;
    $(".ad-item").on("mouseover", function () {
        var index = $(this).index();
        var indexs = index + 1;
        $(this).addClass("on").siblings().removeClass("on");
        for (var i = 0; i < len; i++) {
            $(".ad-item .item1").eq(i).removeClass("on");
            $(".ad-item .item2").eq(i).removeClass("on");
            console.log(i)
        }
        $(".ad-item .item1").eq(index).addClass("on");
        $(".ad-item .item2").eq(index).addClass("on");
    });
</script>