<script type="text/javascript">
    $(document).ready(function () {
        $('.cou-teambaner').slick({
            slidesToShow: 4,
            slidesToScroll: 1,
            autoplay: true,
            autoplaySpeed: 200000,
        });

    });

    $(document).ready(function () {
        if ($(window).width() >= 766) {
            $('.courseacti-baner').slick({
                slidesToShow:2,
                slidesToScroll: 2,
                autoplay: true,
                autoplaySpeed: 200000,
            });
        }

    });
    $(document).ready(function () {
        if ($(window).width() <= 766) {
            $('.courseacti-baner').slick({
                slidesToShow: 2,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 2000,
            });
        }

    });
    $(document).ready(function () {
        if ($(window).width() >= 766) {
            $('.courseacti-baner2').slick({
                slidesToShow: 3,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 2000,
            });
        }

    });
    $(document).ready(function () {
        if ($(window).width() <= 766) {
            $('.courseacti-baner2').slick({
                slidesToShow: 2,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 2000,
            });
        }

    });

    $('.campus_tab .bot-con')[0].style.left = "0%";
    var startX = '', disX = '';
    $('.campus_tab .top_menu a').on('click', function () {
        var index = $(this).index();
        $(this).parent().siblings().children('.bot-con').css('left', '-' + index * 100 + '%');
        $(this).addClass('select').siblings().removeClass('select');
        console.log($(this).eq(index));
    });
    $('.campus_tab .bot-con').on('touchstart', '.campus-box', function (e) {
        startX = e.originalEvent.changedTouches[0].clientX;
    });
    $('.campus_tab .bot-con').on('touchmove', '.campus-box', function (e) {
        e.stopPropagation()
    })
    $('.campus_tab .bot-con').on('touchend', '.campus-box', function (e) {
        disX = e.originalEvent.changedTouches[0].clientX - startX;
        var leftNum = parseInt($('.campus_tab .bot-con')[0].style.left);
        if (disX > 0 && disX > 100) {
            if (leftNum <= -100) {
                $('.campus_tab .bot-con')[0].style.left = leftNum + 100 + "%";
                var order = -parseInt($('.campus_tab .bot-con')[0].style.left) / 100;
                $('.campus_tab .top_menu a').eq(order).addClass('select').siblings().removeClass('select')
            }
        } else if (disX < 0 && disX < -100) {
            if (leftNum >= -0) { //n+1次
                $('.campus_tab .bot-con')[0].style.left = leftNum - 100 + "%";
                var order = (-parseInt($('.campus_tab .bot-con')[0].style.left)) / 100;
                $('.campus_tab .top_menu a').eq(order).addClass('select').siblings().removeClass('select')
            }
        }
    })
</script>