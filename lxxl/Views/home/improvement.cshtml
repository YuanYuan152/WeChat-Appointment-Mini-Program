        Awidth: 1024,
        scale: 0.7,
    })

    $(document).ready(function () {
        $('.container-banner').slick({
            centerMode: true,
            slidesToShow: 1,
            arrows: false,
            centerMode: true,
            focusOnSelect: true,
            autoplay: true,
            autoplaySpeed: 2000,
            dots: true,
        });

    });
    var len = $(".ad-item").length;
    $(".ad-item").on("mouseover", function () {
        var index = $(this).index();
        var indexs = index + 1;
        $(this).addClass("on").siblings().removeClass("on");
        for (var i =0; i < len; i++) {
            $(".ad-item .item1").eq(i).removeClass("on");
            $(".ad-item .item2").eq(i).removeClass("on");
            console.log(i)
        }
        $(".ad-item .item1").eq(index).addClass("on");
        $(".ad-item .item2").eq(index).addClass("on");
    });

    $('.pictureSlider .poster-list li').on('click', function () {
