                font-size: 14px;
            }

            .ad-item .item1 span {
                font-size: 40px;
            }

        .ad-item .item2 {
            height: 80px;
            text-align: center;
            align-content: center;
            background-color: rgb(73,129,188);
            font-size: 30px;
            color: #fff;
            align-items: center;
            display: flex;
        }
            .ad-item .item2 p {
                margin: 0 auto;
            }

        .ad-item .item3 {
            height: 200px;
        }

            .ad-item .item3 p {
                margin: 10px;
                color: rgb(166,196,207);
                font-size: 14px;
            }

        .ad-item > img {
            height: 100%;
            width: 100%;
            display: block;
        }

        .ad-item.on {
            z-index: 3;
            box-shadow: 0 0 10px #0c0b0b;
            transform: scale(1.2);
            transition: all 0.5s;
            background-color: #fff;
        }

     .ad-item .item1.on {
            background-color: rgb(73,129,188);
            color: #fff;
        }

    .ad-item .item2.on {
            background-color: rgb(147,178,196);
        }


    .ad_list {
        height: 0.2rem;
        width: 100%;
        margin-top: 0.4rem;
        text-align: center;
    }

        .ad_list > span {
            height: 0.1rem;
            width: 0.1rem;
            border-radius: 50%;
            -webkit-border-radius: 50%;
            -moz-border-radius: 50%;
            -ms-border-radius: 50%;
            -o-border-radius: 50%;
            background: #BBBBBB;
            display: inline-block;
            margin: 0 0.1rem;
        }

            .ad_list > span.on {
                background: #3784FF !important;
                width: 24px;
                border-radius: 5px;
                transform: all 0.5s;
            }

</style>
