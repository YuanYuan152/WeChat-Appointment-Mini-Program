        margin: 0 auto;
        padding-top: 5rem;
        padding-bottom: 5rem;
    }

    .ad_show {
        margin-top: 3.4rem;
        width: 80%;
        display: flex;
        justify-content: center;
        margin: 20px auto;
    }

    .ad-item {
        width: 20%;
        text-align: center;
        cursor: pointer;
        transition: all 0.1s;
        font-size: 0.14rem;
        z-index: 1;
        margin: 20px;
        background-color: #fff;
    }

        .ad-item .item1 {
            color: rgb(73,129,188);
            padding-bottom: 20px;
        }

