@using lxxl.Models
@{
    ViewBag.Title = "newsList";
    Layout = "~/Views/Shared/_LayoutWap.cshtml";
    var type = ViewBag.type;
}


<link rel="stylesheet" href="/static/web/css/list.css?rnd=437320849934830">
<link rel="stylesheet" href="/static/web/css/style.css?rnd=437320849934830">
<style>
    .tag-m .first-tag {
        display: -webkit-box;
        display: flex;
        flex-wrap: wrap;
        padding: 5px 0 0;
        margin: 0;
    }
    .tag-m li {
        margin-right: 10px;
        margin-top: 9px;
        list-style: none;
        display: inline-block;
    }
    .tag-m .first-tag li.guided {
        position: relative;
    }
    .tag-m li a {
        font-family: PingFangSC-Regular;
        font-size: 15px;
        color: #666;
        line-height: 18px;
        text-decoration: none;
    }
    .tag-m .first-tag li.selected a, .tag-m .first-tag li a:hover {
        color: #0b8bff;
    }
    .tag-m #secondTagM {
        margin-top: 15px;
    }
    .tag-m .second-tag {
        background-color: #e1e4e7;
        border-radius: 4px;
    }
        .tag-m .second-tag ul {
            display: block;
            padding: 5px 10px 15px 0;
            list-style-type: none;
            font-size: 0;
        }
        .tag-m .second-tag li {
            margin-left: 30px;
            margin-top: 10px;
        }
            .tag-m .second-tag li a {
                color: #7a7a7a;
                font-size: 13px;
            }
                .tag-m .second-tag li.selected a, .tag-m .second-tag li a:hover {
                    color: #0b8bff;
                }
</style>
<div class="con">

    <section>
        <div class="banner-box">
            @*<div class="home_banner">
                @foreach (T_Banner item in ViewBag.BannerLst)
                {
                    <div class="ban-con">
                        <a href="javascript:void(0);">
                            <div class="img"><img src="/Upload/Contract/640.jpg"></div>
                            <div class="text ">
                                <h3 class="wow fadeInRight">@item.Title</h3>
                                <p class="none wow fadeInRight">@item.Profile</p>
                            </div>
                        </a>
                    </div>
                }
            </div>*@
            <!--head start-->
            @*<div class="ban-appointment wow zoomIn" style="width: 420px;padding: 2em 0;margin: auto;text-align: center;background-color: rgba(0,0,0,0.4);border-radius: 10px;float: right;">
                <h5 class="fadeInDown wow" data-wow-delay=".3s" style="font-size: 1.8em;color: #fff;line-height: 1.6;margin-top: 1em;font-weight: normal;">国内专业心理服务平台</h5>
                <p style=" margin: 1em 0 3em; color: #fff;">严选Top1%的心理咨询师，只提供高质量的心理服务</p>
                <div class="actions" style="overflow: hidden;width: 100%;text-align: center;padding-bottom: 0;">
                    <a class="button button--filled--red" href="/experts" style="margin: 0 1em 0; display: inline-block; width: 40%; text-decoration: none; text-align: center; padding: 0.8em; border-radius: 4px; margin-bottom: 1em; box-sizing: border-box; opacity: 0.9; background-color: #F16272;">心理咨询</a>
                    <a class="button button--filled--green" href="/psychiatrists" style="margin: 0 1em 0; display: inline-block; width: 40%; text-decoration: none; text-align: center; padding: 0.8em; border-radius: 4px; margin-bottom: 1em; box-sizing: border-box; opacity: 0.9; background-color: #129994; ">精神科顾问</a>
                </div>
            </div>*@
            <!--head end-->
        </div>
    </section>
    <section>
        <div class="list" style="padding-top:20px; padding-bottom: 40px; background: #f3f7f9; ">
            <div class="list-con" style="background-color: #f3f3f3; border-radius: 10px; padding-top: 1px; max-width: 1000px;">
                <h3 class="section_tit" style="margin:10px 0 10px 0; padding-left: 10px; border-left: #c00 5px solid; font-size: 24px; ">
                    @(type == 1 ? "了解咨询" : type == 2 ? "心理测量" : "其他")
                </h3>
                <div class="list-crumb" style="background-color: #e9e9e9;padding: 8px 15px;margin-top: 15px;margin-bottom: 10px;list-style: none;border-radius: 4px;">
                    <span>您当前的位置：</span> <a href="/home/Index">首页</a> -> 心理服务 ->
                    <a href="/home/newsList?type=@type">@(type == 1 ? "了解咨询" : type == 2 ? "心理测量" : "其他")</a>
                </div>
                <div class="tag-m">
                    <ul class="first-tag">
                        <li class="selected">
                            <a href="#">全部</a>
                        </li>
                        <li>
                            <a href="#">心理测量</a>
                        </li>
                        <li>
                            <a href="#">活动招募</a>
                        </li>
                        <li>
                            <a href="#">心理主题</a>
                        </li>
                        <li>
                            <a href="#">往期精华</a>
                        </li>
                    </ul>
                    <div id="secondTagM">
                        <div class="second-tag showed-second-tag">
                            <ul class="selector-tag">
                                <!-- 全部标签 -->
                                <li data-url="#" class="selected">
                                    <a href="#">全部</a>
                                </li>
                                <li data-url="#">
                                    <a href="#">类型一</a>
                                </li>
                                <li data-url="#">
                                    <a href="#">类型二</a>
                                </li>
                                <li data-url="#">
                                    <a href="#">类型三</a>
                                </li>
                                <li data-url="#">
                                    <a href="#">类型四</a>
                                </li>
                                <li data-url="#">
                                    <a href="#">类型五</a>
                                </li>
                                <li data-url="#">
                                    <a href="#">类型六</a>
                                </li>
                                <li data-url="#">
                                    <a href="#">类型七</a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <ul class="list-box" style="width: 96%; margin: 0 auto; padding: 5px 0 0;">
                    @foreach (T_Content item in ViewBag.ContentList)
                    {
                        <li>
                            <div class="list-box-l"><img src="@item.url"></div>
                            @*<div class="list-box-l" style="width:130px;">@item.ModifyTime.ToString("yyyy-MM-dd") </div>*@
                            <div class="list-box-r">
                                <h4> 
                                    @if(item.Source=="")
                                    {
                                        <a href="/home/newsDetail?ID=@item.ID" target="_blank">@item.Title</a>
                                    }
                                    else
                                    {
                                        <a href="@item.Source" target="_blank">@item.Title</a>
                                    }
                                <em>@item.ModifyTime.ToString("yyyy-MM-dd")</em>
                                </h4>
                                <p>@item.Profile</p>
                                @* <p style="margin-top:0px;"><a href="/home/newsDetail?ID=@item.ID" target="_blank">@item.Title</a></p>*@
                            </div>
                        </li>
                    }
                </ul>
                <div class='dataTables_paginate paging_simple_numbers'>
                    <ul class='pagination'>
                        <li id="example1_previous" class="paginate_button previous disabled phone-2"><a class="prev" href="/home/newsList?type=@ViewBag.type&page=@(ViewBag.ThisPage==1?1:ViewBag.ThisPage-1)">‹</a></li>
                        @for (int i = ViewBag.sPage; i <= ViewBag.ePage; i++)
                        {
                            if (i == ViewBag.ThisPage)
                            {
                                <li class="paginate_button active"><a tabindex="0" data-dt-idx="1" aria-controls="example1" href="#">@i</a></li>
                            }
                            else
                            {
                                <li class="paginate_button"><a class="num" href="/home/newsList?type=@ViewBag.type&page=@i">@i</a></li>
                            }
                        }
                        <li id="example1_next" class="paginate_button next phone-2"><a class="next" href="/home/newsList?type=@ViewBag.type&page=@(ViewBag.ThisPag < ViewBag.ePage ? ViewBag.ThisPag+1 : ViewBag.ThisPage)">›</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </section>

</div>
<script type="text/javascript">
    $(function () {
        localStorage.active = "activeNewsList";
    })
</script>



