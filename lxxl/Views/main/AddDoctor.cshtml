@using lxxl.Models
@{
    Layout = null;
    ViewBag.Title = "AddExaminer";
    List<T_ExamC> aCourselistdb = ViewBag.aCourselistdb;
    List<T_Field> Fieldlist = ViewBag.Fieldlist;
    List<T_SystemSettings> TargetGrouplist = ViewBag.TargetGrouplist;
}
<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>添加咨询师</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
    @*<style>
        .layui-form-item {
            margin-bottom: 10px;
        }
    </style>*@
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>用户名
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="UserName" name="UserName" class="layui-input" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>密码
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="Password" name="Password" class="layui-input" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>姓名
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="name" name="name" class="layui-input" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>手机号码
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="tel" name="tel" class="layui-input" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>性别
                    </label>
                    <div class="layui-input-block">
                        <input type="radio" name="sex" value="男" title="男" checked>
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>男</div>
                        </div>
                        <input type="radio" name="sex" value="女" title="女">
                        <div class="layui-unselect layui-form-radio">
                            <i class="layui-anim layui-icon"></i>
                            <div>女</div>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>学历
                    </label>
                    <div class="layui-input-block">
                        @*<select name="sex" id="sex">
                            <option value="博士">博士</option>
                            <option value="硕士">硕士</option>
                            <option value="本科">本科</option>
                            <option value="专科">专科</option>
                        </select>*@
                        <input type="radio" name="Course" lay-filter="CourseM" value="博士" title="博士">
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>博士</div>
                        </div>
                        <input type="radio" name="Course" lay-filter="CourseM" value="硕士" title="硕士" checked>
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>硕士</div>
                        </div>
                        <input type="radio" name="Course" lay-filter="CourseM" value="本科" title="本科">
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>本科</div>
                        </div>
                        <input type="radio" name="Course" lay-filter="CourseM" value="专科" title="专科">
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>专科</div>
                        </div>
                        <input type="radio" name="Course" lay-filter="CourseM" value="其他" title="其他" >
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>其他</div>
                        </div>
                        <input type="text" id="qitaCourse" name="qitaCourse" class="layui-input" value="" style="width: 250px; display:none">
                    </div>
                </div>                
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>从业年限
                    </label>
                    <div class="layui-input-block">
                        <input type="number" id="WorkYears" name="WorkYears" class="layui-input" required lay-verify="required" style="width:100px;display:inline;"><span>年以上</span>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>咨询时数
                    </label>
                    <div class="layui-input-block">
                        <input type="number" id="ConsultHours" name="ConsultHours" class="layui-input" required lay-verify="required" style="width:100px;display:inline;"><span>+小时数</span>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>价格
                    </label>
                    <div class="layui-input-block">
                        <input type="number" id="Billing" name="Billing" class="layui-input" required lay-verify="required" style="width:100px;display:inline;"><span> 元/50分钟</span>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>城市
                    </label>
                    <div class="layui-input-block">
                        <div class="x-city" id="City">
                            <div class="layui-input-inline">
                                <select name="province" lay-filter="province">
                                    <option value="">请选择省</option>
                                </select>
                            </div>
                            <div class="layui-input-inline">
                                <select name="city" lay-filter="city">
                                    <option value="">请选择市</option>
                                </select>
                            </div>
                            <div class="layui-input-inline">
                                <select name="area" lay-filter="area">
                                    <option value="">请选择县/区</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>资质
                    </label>
                    <div class="layui-input-block">
                        <textarea id="Qualification" placeholder="" rows="3" name="Qualification" class="layui-textarea"></textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>咨询流派和方向
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="Specialty" name="Specialty" class="layui-input" >
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>受训背景
                    </label>
                    <div class="layui-input-block">
                        <textarea id="Careerexperience" placeholder="" rows="3" name="Careerexperience" class="layui-textarea"></textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>领域
                    </label>
                    <div class="layui-input-block">
                        <table class="layui-table layui-input-block">
                            <tbody>
                                @foreach (T_Field item in Fieldlist.Where(o => o.FieldID == 0).ToArray())
                                {
                                    <tr>
                                        <td>
                                            <input type="checkbox" name="Field" lay-skin="primary" lay-filter="father" value="@item.Name" title="@item.Name">
                                        </td>
                                        <td>
                                            <div class="layui-input-block" style="margin-left:10px;">
                                                @foreach (T_Field item2 in Fieldlist.Where(o => o.FieldID == item.ID).ToArray())
                                                {
                                                    <input name="Field" lay-skin="primary" type="checkbox" value="@item2.Name" title="@item2.Name">
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>擅长人群
                    </label>
                    <div class="layui-input-block">
                        @*<input type="text" id="TargetGroup" name="TargetGroup" class="layui-input" value="@Doctor.TargetGroup">*@
                        @foreach (T_SystemSettings item in TargetGrouplist)
                        {
                            <input name="TargetGroup" lay-skin="primary" type="checkbox" value="@item.content1" title="@item.content1">
                        }
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>咨询方式
                    </label>
                    <div class="layui-input-block">
                        <select name="Mode" id="Mode">
                            <option value="0">不限</option>
                            <option value="1">面对面咨询</option>
                            <option value="2">视频咨询</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>导语/简介
                    </label>
                    <div class="layui-input-block">
                        <textarea id="Profile" placeholder="" rows="3" name="Profile" class="layui-textarea"></textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">个人介绍</label>
                    <div class="layui-input-block">
                        <textarea name="content" style="width:100%;height:200px;visibility:hidden;"></textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="link" class="layui-form-label">
                        <span class="x-red">*</span>图片
                    </label>
                    <div class="layui-input-block">
                        <div class="site-demo-upbar">
                            <button type="button" class="layui-btn" id="uploadPicture"><i class="layui-icon"></i>上传图片</button>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item imgs" id="imgshow">
                    <label class="layui-form-label">
                        图片展示
                    </label>
                    <img id="pimages" name="pimages" style="width: 400px;" />
                    <input id="avatar" name="url" required="" type="hidden" />
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>咨询师类别
                    </label>
                    <div class="layui-input-block">
                        <input type="radio" name="position" value="咨询师" title="咨询师" checked>
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>咨询师</div>
                        </div>
                        <input type="radio" name="position" value="实习咨询师" title="实习咨询师">
                        <div class="layui-unselect layui-form-radio">
                            <i class="layui-anim layui-icon"></i>
                            <div>实习咨询师</div>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>是否显示
                    </label>
                    <div class="layui-input-block">
                        <input type="checkbox" name="IsShow" value="true" title="显示">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>是否置顶
                    </label>
                    <div class="layui-input-block">
                        <input type="checkbox" checked="" name="Backup" lay-skin="switch" lay-filter="switchTest" lay-text="是|否">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        立即提交
                    </button>
                </div>
            </form>
        </div>
    </div>

    <link href="~/Content/kindeditor-4.1.7/themes/default/default.css" rel="stylesheet" />
    <script src="~/Content/kindeditor-4.1.7/kindeditor-min.js"></script>
    <script charset="utf-8" src="~/Content/kindeditor-4.1.7/lang/zh_CN.js"></script>
    <script type="text/javascript" src="https://cdn.bootcss.com/jquery/3.2.1/jquery.min.js"></script>
    <script type="text/javascript" src="/Content/mhome/js/xcity.js"></script>
    <script>
        var editor;

        layui.use(['form', 'layer', 'upload', 'code'],
            function () {
                
                form = layui.form,
                layer = layui.layer;
                var upload = layui.upload;
                layui.code();
                $('#City').xcity('上海', '市辖区', '黄浦区');

                //自定义验证规则
                form.verify({
                    Name: function (value) {
                        if (value.length < 5) {
                            return '至少得5个字符啊';
                        }
                    },
                });

                //监听提交
                form.on('submit(add)',
                function (data) {
                    console.log(data);
                    var content = editor.html();
                    console.log(content);
                    var submitData = data.field;
                    submitData["introduce"] = content;
                    var obj = document.getElementsByName("TargetGroup");
                    var cbv = "";
                    for (k in obj) {
                        if (obj[k].checked)
                            cbv += obj[k].value + ',';
                    }
                    submitData["TargetGroup"] = cbv;
                    var objField = document.getElementsByName("Field");
                    var cbvField = "";
                    for (k in objField) {
                        if (objField[k].checked)
                            cbvField += objField[k].value + ',';
                    }
                    submitData["Field"] = cbvField;
                    //发异步
                    $.post("/main/AddDoctor", { field: JSON.stringify(submitData) }, function (data) {
                        if (data.code == 0) {
                            layer.alert("添加成功", {
                                icon: 6
                            },
                            function () {
                                //关闭当前frame
                                xadmin.close();

                                // 可以对父窗口进行刷新
                                xadmin.father_reload();
                            });
                        } else {
                            layer.alert(data.msg);
                        }
                    });
                    return false;
                });

                //指定允许上传的文件类型
                upload.render({
                    elem: '#uploadPicture',
                    url: '/Editor/UploadFilexx',
                    accept: 'images',  //普通文件
                    ext: 'jpg|png|gif',
                    done: function (res) {
                        layer.msg(res.msg);
                        console.log(res);
                        if (res.msg == "上传成功") {
                            console.log(res.name);
                            layer.closeAll('loading');
                            //layer.msg(data.info,{icon:1,time:1000});
                            $("#pimages").attr('src', res.src);
                            $("#avatar").val(res.src);
                            $(".imgs").show();
                            return false;
                        }
                    }
                });
                form.on('checkbox(father)', function (data) {

                    if (data.elem.checked) {
                        $(data.elem).parent().siblings('td').find('input').prop("checked", true);
                        form.render();
                    } else {
                        $(data.elem).parent().siblings('td').find('input').prop("checked", false);
                        form.render();
                    }
                });

                //此处即为 radio 的监听事件
                form.on('radio(CourseM)', function (data) {
                    console.log(data.elem); //得到radio原始DOM对象
                    if (data.value == '其他') {
                        //$("#qitaCourse").show();
                        $("#qitaCourse").css({ 'display': 'inline' });
                    }
                    else {
                        //$("#qitaCourse").hide();
                        $("#qitaCourse").css({ 'display': 'none' });

                    }
                });
            });
    </script>

    <script>
        KindEditor.ready(function (K) {
            editor = K.create('textarea[name="content"]', {
                langType: "zh_CN",
                allowFileManager: true,
                allowUpload: true,                               //是否可以上传
                fileManagerJson: '/Editor/ProcessRequest',      //浏览文件方法
                uploadJson: '/Editor/UploadFile',              //上传文件方法  //注意这两个路径
            });
        });
    </script>
</body>
</html>
