@using lxxl.Models
@{
    Layout = null;
    ViewBag.Title = "AddInfoData";
    List<T_ExamC> aCourselistdb = ViewBag.aCourselistdb;
}
<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>添加资料</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        <span class='x-red'>*</span>类型
                    </label>
                    <div class="layui-input-block">
                        <select name="Type" id="Type">
                            <option value="">---请选择分类---</option>
                            @foreach (T_ExamC item in aCourselistdb)
                            {
                                <option value="@item.ID">@item.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>标题
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="Title" name="Title" required class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>介绍
                    </label>
                    <div class="layui-input-block">
                        <textarea id="Profile" placeholder="" rows="3" name="Profile" class="layui-textarea"></textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="link" class="layui-form-label">
                        <span class="x-red">*</span>文件
                    </label>
                    <div class="layui-input-block">
                        <div class="site-demo-upbar">
                            <button type="button" class="layui-btn" id="uploadPicture"><i class="layui-icon"></i>上传文件</button>
                            <input id="avatar" name="Source" required="" type="hidden" />
                        </div>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>是否显示
                    </label>
                    <div class="layui-input-block">
                        <input type="checkbox" name="IsShow" value="true" title="显示">
                    </div>
                </div>              
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        立即提交
                    </button>
                </div>
            </form>
        </div>
    </div>


    <script>
        layui.use(['form', 'layer', 'upload'],
            function () {
                $ = layui.jquery;
                var form = layui.form,
                layer = layui.layer;
                var upload = layui.upload;

                //自定义验证规则
                form.verify({
                    Name: function (value) {
                        if (value.length < 5) {
                            return '至少得5个字符啊';
                        }
                    },
                });

                //监听提交
                form.on('submit(add)',
                function (data) {
                    console.log(data);
                    var submitData = data.field;
                    //发异步
                    $.post("/main/AddInfoData", { field: JSON.stringify(submitData) }, function (data) {
                        if (data.code == 0) {
                            layer.alert("添加成功", {
                                icon: 6
                            },
                            function () {
                                //关闭当前frame
                                xadmin.close();

                                // 可以对父窗口进行刷新
                                xadmin.father_reload();
                            });
                        } else {
                            layer.alert(data.msg);
                        }
                    });
                    return false;
                });

                //指定允许上传的文件类型
                upload.render({
                    elem: '#uploadPicture',
                    url: '/Editor/UploadFilexx',
                    accept: 'file',  //普通文件
                    done: function (res) {
                        layer.msg(res.msg);
                        console.log(res);
                        if (res.msg == "上传成功") {
                            console.log(res.name);
                            layer.closeAll('loading');
                            $("#avatar").val(res.src);
                            return false;
                        }
                    }
                });

            });
    </script>

</body>
</html>
