@using lxxl.Models
@{
    Layout = null;
    ViewBag.Title = "AddPatient";
}
<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>添加用户</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">

    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
    @*<style>
            .layui-form-item {
                margin-bottom: 10px;
            }
        </style>*@
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <div class="layui-form-item">
                    <label for="Tel" class="layui-form-label">
                        <span class="x-red">*</span>手机号码
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="Tel" name="Tel" class="layui-input" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="Password" class="layui-form-label">
                        <span class="x-red">*</span>密码
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="Password" name="Password" class="layui-input" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="Name" class="layui-form-label">
                        <span class="x-red">*</span>姓名
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="Name" name="Name" class="layui-input" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>性别
                    </label>
                    <div class="layui-input-block">
                        <input type="radio" name="Sex" value="男" title="男" checked>
                        <div class="layui-unselect layui-form-radio layui-form-radioed">
                            <i class="layui-anim layui-icon layui-anim-scaleSpring"></i>
                            <div>男</div>
                        </div>
                        <input type="radio" name="Sex" value="女" title="女">
                        <div class="layui-unselect layui-form-radio">
                            <i class="layui-anim layui-icon"></i>
                            <div>女</div>
                        </div>
                    </div>
                </div>

                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        立即提交
                    </button>
                </div>
            </form>
        </div>
    </div>

    <link href="~/Content/kindeditor-4.1.7/themes/default/default.css" rel="stylesheet" />
    <script src="~/Content/kindeditor-4.1.7/kindeditor-min.js"></script>
    <script charset="utf-8" src="~/Content/kindeditor-4.1.7/lang/zh_CN.js"></script>
    <script type="text/javascript" src="https://cdn.bootcss.com/jquery/3.2.1/jquery.min.js"></script>
    <script>
        var editor;

        layui.use(['form', 'layer', 'upload', 'code'],
            function () {

                form = layui.form,
                    layer = layui.layer;
                var upload = layui.upload;
                layui.code();

                //自定义验证规则
                form.verify({
                    Name: function (value) {
                        if (value.length < 5) {
                            return '至少得5个字符啊';
                        }
                    },
                });

                //监听提交
                form.on('submit(add)',
                    function (data) {
                        console.log(data);
                        var submitData = data.field;
                        //发异步
                        $.post("/main/AddPatient", { field: JSON.stringify(submitData) }, function (data) {
                            if (data.code == 0) {
                                layer.alert("添加成功", {
                                    icon: 6
                                },
                                    function () {
                                        //关闭当前frame
                                        xadmin.close();

                                        // 可以对父窗口进行刷新
                                        xadmin.father_reload();
                                    });
                            } else {
                                layer.alert(data.msg);
                            }
                        });
                        return false;
                    });
            });
    </script>
</body>
</html>

