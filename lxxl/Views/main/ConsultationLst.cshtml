    <style type="text/css">
        .layui-table-cell {
            height: 50px !important;
            white-space: nowrap;
            line-height: 50px;
            padding: 0 15px;
            box-sizing: border-box;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .layui-table img {
            max-width: 300px;
        }
        
        /* 固定所有行的高度 */
        .layui-table tbody tr {
            height: 50px !important;
        }
        
        .layui-table-header thead tr {
            height: 50px !important;
        }
        
        /* 固定列也使用相同高度 */
        .layui-table-fixed .layui-table-body tbody tr {
            height: 50px !important;
        }
        
        .layui-table-fixed .layui-table-header thead tr {
            height: 50px !important;
        }
        
        /* 复选框列特殊处理 - 使用更直接的方法 */
        .layui-table-cell:has(input[type="checkbox"]),
        .layui-table-cell input[type="checkbox"] {
            text-overflow: unset !important;
            overflow: visible !important;
        }
        
        /* 复选框列容器特殊处理 */
        .layui-table-main tbody td:first-child .layui-table-cell,
        .layui-table-fixed-left tbody td:first-child .layui-table-cell,
        .layui-table-main thead th:first-child .layui-table-cell,
        .layui-table-fixed-left thead th:first-child .layui-table-cell {
            text-overflow: unset !important;
            overflow: visible !important;
            text-align: center;
            white-space: normal !important;
        }
        
        /* 复选框垂直居中 */
        .layui-table-cell input[type="checkbox"] {
            margin: 0;
            vertical-align: middle;
        }
        
        /* 个案记录表列特殊处理 */
        .layui-table-cell .layui-btn {
            margin: 5px;
        }
        
        /* 个案记录表列内容溢出处理 */
        .layui-table-cell {
            display: block;
        }
    </style>
</head>
<body>
