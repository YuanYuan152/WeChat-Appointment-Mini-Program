    <script>
        var userType = '@ViewBag.userType';
        layui.use(['laydate', 'form', 'table'], function () {
            var table = layui.table
            , form = layui.form;
            var laydate = layui.laydate;
            
            table.render({
                elem: '#test'
               , height: 'full-120'
              , url: '/main/GetConsultationList'
              , where: { keyword: '' }
               , toolbar: true
              , toolbar: '#toolbarDemo' //开启头部工具栏，并为其绑定左侧模板
              , title: '咨询师表'
              , totalRow: false
              , cols: [[
                { type: 'checkbox', fixed: 'left', unresize: true, width: 40 }
                //, { field: 'ID', title: 'ID', width: 80, unresize: true, sort: true}
              , { field: 'gId', title: 'gId', hide: true, style: 'display:none;' }
                 , { field: 'patientName', title: '来访者', fixed: 'left', unresize: true, width: 120 }
                 , { field: 'patientTel', title: '联系方式', fixed: 'left', unresize: true, width: 150 }
                , { field: 'appointmentTime', title: '预约时间', width: 150, sort: true }
                , { field: 'name', title: '咨询师', width: 120 }
                , { field: 'address', title: '咨询室', width: 180 }
                , { field: 'duration', title: '咨询时长', width: 100 }
                , { field: 'PayCost', title: '咨询费用', width: 100 }
                
             , { field: 'StateDescription', title: '咨询状态', width: 250 }
                //, { field: 'createTime', title: '创建时间', width: 160, sort: true }
                //, { field: 'appointmentTime', title: '预约时间', width: 200 }
                //, { field: 'cTime', title: '咨询时间', width: 200 }
                //, { field: 'remark', title: '备注' }
                , { fixed: 'right', title: '个案记录表', toolbar: '#barDemoGA', width: 200 }
                , { fixed: 'right', title: '操作', toolbar: '#barDemo', width: 250 }
              ]]
              , page: true
              , limits: [10, 15, 20, 1000]
              , limit: 15 //每页默认显示的数量
              , done: function (res, curr, count) {
                  // 执行一个laydate实例
                  laydate.render({
                      elem: '#startDay' //指定元素
                  });

                  //执行一个laydate实例
                  laydate.render({
                      elem: '#endDay' //指定元素
                  });
              }
            });
            
            //头工具栏事件
            table.on('toolbar(test)', function (obj) {
                var checkStatus = table.checkStatus(obj.config.id);
                //layer.alert(obj.event);
                switch (obj.event) {
                    case 'getCheckData':
                        //var data = checkStatus.data;
                        //layer.alert(JSON.stringify(data));

                        break;
                    case 'getCheckLength':
                        var data = checkStatus.data;
                        layer.msg('选中了：' + data.length + ' 个');
                        break;
                    case 'isAll':
                        layer.msg(checkStatus.isAll ? '全选' : '未全选');
                        break;

                        //自定义头工具栏右侧图标 - 提示
                    case 'LAYTABLE_TIPS':
                        layer.alert('帮助');
                        break;
                    case 'reload':
                        var searchName = $('#searchName').val();
                        var startDay = $("#startDay").val();
                        var endDay = $("#endDay").val();
                        var state = $("#state").val();
                        
                        table.reload('test', {
                            url: '/main/GetConsultationList'
                            , where: { keyword: searchName,startDay:startDay, endDay: endDay,state:state }
                            , page: 1
                            , title: '咨询记录表' + startDay + '-' + startDay
                        }, 'data');
                        $('#searchName').val(searchName);
                        if (startDay != "") {
                            $('#startDay').val(startDay);
                        }
                        if (endDay != "") {
                            $('#endDay').val(endDay);
                        }
                        
                        // 固定行高，无需同步
                        setTimeout(function() {
                            // 固定行高已设置，无需额外处理
                        }, 200);
                        break;
                };
            });

            //监听行工具事件
            table.on('tool(test)', function (obj) {
                var data0 = obj.data;
                console.log(obj)
                if (obj.event === 'del') {
                    layer.confirm('真的删除' + data0.userName + '么', function (index) {

                    });
                } else if (obj.event === 'edit') {
                    layer.open({
                        type: 2
                           , content: '/main/EditConsultation/' + data0.gId
                           , area: ['700px', '600px']
                           , maxmin: true
                    });
                } else if (obj.event === 'edit3') {
                    layer.open({
                        type: 2
                           , content: '/main/EditConsultation3/' + data0.gId
                           , area: ['500px', '600px']
                           , maxmin: true
                    });
                } else if (obj.event === 'CaseRecord') {
                    var caserecordID = obj.data.ID;
                    console.log(caserecordID);
                    layer.open({
                        type: 2
                        , title: '心理咨询个案记录表'
                           , content: '/main/CaseRecord/' + data0.gId
                           , area: ['100%', '100%']
                           , maxmin: true
                    });
                } else if (obj.event === 'addOrder') {
                    layer.open({
                        type: 2
                        , title: '补缴咨询费'
                           , content: '/main/addOrder/' + data0.gId
                            , area: ['500px', '600px']
                           , maxmin: true
                    });
                }
            });            
        });
        
        function onButtonClick(id) {
            layer.open({
                type: 2
              , title: '心理咨询个案记录表'
                , content: '/main/CaseRecord/' + id
                , area: ['100%', '100%']
                , maxmin: true
            });
        }
        function onSHClick(id) {
            layer.open({
                title:'确定信息',
                btn:['同意修改','取消','不同意修改'],//多个按钮直接用btn1/btn2/btn3...回调
                content:"<div style='font-size: 15px'>请确定是否同意修改个案记录表</div>",
                yes:function (index, layero) {//这里也可以用btn1替代yes
                    alert('确定按钮回调' + id )
                    layer.close(index);
                }, btn2 : function() {
                    alert('取消按钮回调')
                }, btn3 : function() {
                    alert('按钮3回调')
                },cancel: function(){
                    //alert('右上角关闭按钮回调')
                },end: function(){
                    //alert('最后执行回调')
                }});
        }
        function onButtonImgIDClick(id) {
            var data = {};  //声明一个空对象
            data["id"] = id;
            data["isSure"] = true;
            layer.open({
                title:'确定信息',
                btn:['同意修改','取消','不同意修改'],//多个按钮直接用btn1/btn2/btn3...回调
                content:"<div style='font-size: 15px'>请确定是否同意修改个案记录表</div>",
                yes:function (index, layero) {//这里也可以用btn1替代yes
                    $.ajax({
                        url: "/main/CaseRecordQC",
                        data: data,
                        type: "post",
                        dataType: "text",
                        success: function (data) {                    
                        },
                        error: function () {
                            $.alert("服务器连接失败。", "提示", function () {
                            });
                        }
                    });    
                    t.remove(); 
                    layer.close(index);
                }, btn2 : function() {
                    //alert('取消按钮回调')
                }, btn3 : function() {
                    //alert('按钮3回调')
                },cancel: function(){
                    //alert('右上角关闭按钮回调')
                },end: function(){
                    //alert('最后执行回调')
                }});
        }
    </script>
</body>

</html>