@using lxxl.Models
@{
    Layout = null;
    ViewBag.Title = "EditConsultingRoom";
    T_SystemSettings InfoData = ViewBag.InfoData;
}
<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>编辑院校</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <input type="text" id="id" name="id" hidden value="@InfoData.id">
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        <span class="x-red">*</span>名称
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="content1" name="content1" class="layui-input" value="@InfoData.content1" required lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">
                        <span class="x-red">*</span>地址
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="remark" name="remark" class="layui-input" value="@InfoData.remark">
                    </div>
                </div>

                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        立即提交
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        layui.use(['form', 'layer', 'upload'],
            function () {
                $ = layui.jquery;
                var form = layui.form,
                layer = layui.layer;
                var upload = layui.upload;

                //自定义验证规则
                form.verify({
                    Name: function (value) {
                        if (value.length < 5) {
                            return '至少得5个字符啊';
                        }
                    },
                });

                //监听提交
                form.on('submit(add)',
                function (data) {
                    console.log(data);
                    var submitData = data.field;
                    //发异步
                    $.post("/main/EditConsultingRoom", { field: JSON.stringify(submitData) }, function (data) {
                        if (data.code == 0) {
                            layer.alert("编辑成功", {
                                icon: 6
                            },
                            function () {
                                //关闭当前frame
                                xadmin.close();

                                // 可以对父窗口进行刷新
                                xadmin.father_reload();
                            });
                        } else {
                            layer.alert(data.msg);
                        }
                    });
                    return false;
                });


            });
    </script>

</body>
</html>
