@using lxxl.Models
@{
    Layout = null;
    ViewBag.Title = "AddExaminer";
    List<T_ExamC> aCourselistdb = ViewBag.aCourselistdb;
    T_Examiner Examiner = ViewBag.Examiner;
}
<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>编辑咨询师</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <input type="text" id="ID" name="ID" hidden value="@Examiner.ID">
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>咨询师名称
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="Name" name="Name" class="layui-input" disabled value="@Examiner.Name">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>导语
                    </label>
                    <div class="layui-input-block">
                        <textarea id="Profile" placeholder="" rows="3" name="Profile" class="layui-textarea">@Examiner.Profile</textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label">详细描述</label>
                    <div class="layui-input-block">
                        <textarea name="content" style="width:100%;height:200px;visibility:hidden;">@Examiner.ContentMain</textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="link" class="layui-form-label">
                        <span class="x-red">*</span>图片
                    </label>
                    <div class="layui-input-block">
                        <div class="site-demo-upbar">
                            <button type="button" class="layui-btn" id="uploadPicture"><i class="layui-icon"></i>上传图片</button>
                        </div>
                    </div>
                </div>
                <div class="layui-form-item imgs" id="imgshow">
                    <label class="layui-form-label">
                        图片展示
                    </label>
                    <img src="@Examiner.url" id="pimages" name="pimages" style="width: 400px;" />
                    <input id="avatar" name="url" required="" type="hidden" value="@Examiner.url"/>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label"><span class="x-red">*</span>课程</label>
                    <div class="layui-input-block">
                        @foreach (T_ExamC item in aCourselistdb)
                        {
                            if(Examiner.Course.Contains(item.Name))
                            {
                                <input type="checkbox" name="Course" lay-skin="primary" value="@item.Name" title="@item.Name" checked>
                            }
                            else
                            {
                                <input type="checkbox" name="Course" lay-skin="primary" value="@item.Name" title="@item.Name">
                            }
                        }
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>是否轮播
                    </label>
                    <div class="layui-input-block">
                        @if(Examiner.IsBanner)
                        { 
                            <input type="checkbox" checked="" name="Backup" lay-skin="switch" lay-filter="switchTest" lay-text="是|否">
                        }
                        else
                        {
                            <input type="checkbox" name="Backup" lay-skin="switch" lay-filter="switchTest" lay-text="是|否">
                        }
                    </div>
                    @*<div class="layui-form-mid layui-word-aux">
                            <span class="x-red">打勾表示此设置为轮播。</span>
                        </div>*@
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        立即提交
                    </button>
                </div>
            </form>
        </div>
    </div>

    <link href="~/Content/kindeditor-4.1.7/themes/default/default.css" rel="stylesheet" />
    <script src="~/Content/kindeditor-4.1.7/kindeditor-min.js"></script>
    <script charset="utf-8" src="~/Content/kindeditor-4.1.7/lang/zh_CN.js"></script>

    <script>
        var editor;

        layui.use(['form', 'layer', 'upload'],
            function () {
                $ = layui.jquery;
                var form = layui.form,
                layer = layui.layer;
                var upload = layui.upload;

                //自定义验证规则
                form.verify({
                    Name: function (value) {
                        if (value.length < 5) {
                            return '至少得5个字符啊';
                        }
                    },
                });

                //监听提交
                form.on('submit(add)',
                function (data) {
                    console.log(data);
                    var content = editor.html();
                    console.log(content);
                    var submitData = data.field;
                    submitData["ContentMain"] = content;
                    var arr_box = [];
                    $('input[name=Course]:checked').each(function () {
                        arr_box.push($(this).val());
                    });
                    submitData["Course"] = arr_box.join(",");
                    //发异步
                    $.post("/main/EditExaminer", { field: JSON.stringify(submitData) }, function (data) {
                        if (data.code == 0) {
                            layer.alert("编辑成功", {
                                icon: 6
                            },
                            function () {
                                //关闭当前frame
                                xadmin.close();

                                // 可以对父窗口进行刷新
                                xadmin.father_reload();
                            });
                        } else {
                            layer.alert(data.msg);
                        }
                    });
                    return false;
                });

                //指定允许上传的文件类型
                upload.render({
                    elem: '#uploadPicture',
                    url: '/Editor/UploadFilexx',
                    accept: 'images',  //普通文件
                    ext: 'jpg|png|gif',
                    done: function (res) {
                        layer.msg(res.msg);
                        console.log(res);
                        if (res.msg == "上传成功") {
                            console.log(res.name);
                            layer.closeAll('loading');
                            //layer.msg(data.info,{icon:1,time:1000});
                            $("#pimages").attr('src', res.src);
                            $("#avatar").val(res.src);
                            $(".imgs").show();
                            return false;
                        }
                    }
                });

            });
    </script>

    <script>
        KindEditor.ready(function (K) {
            //var uploadExhibition = K.uploadbutton({
            //    button: K('#uploadPicture'),
            //    fieldName: 'imgFile',
            //    url: '/Editor/UploadImage',
            //    afterUpload: function (data) {
            //        console.log(data);
            //        if (data.error === 0) {
            //            var url = K.formatUrl(data.url, 'absolute');
            //            $("#imgExhibitionID").append(' <div style="width: 49%; display: inline-block;"> <img src="' + url + '" style="max-width: 88%;"/><input imgsrc="' + url + '" name="imgExhibition" class="imgExhibition" type="button" value="delete"/></div>');
            //            alert("Submit successfully, please wait for review.");
            //        } else {
            //            alert("Upload Failed");
            //        }
            //    },
            //    afterError: function (str) {
            //        alert('Custom error message: ' + str);
            //    }
            //});
            //uploadExhibition.fileBox.change(function (e) {
            //    uploadExhibition.submit();
            //});
            editor = K.create('textarea[name="content"]', {
                langType: "zh_CN",
                allowFileManager: true,
                allowUpload: true,                               //是否可以上传
                fileManagerJson: '/Editor/ProcessRequest',      //浏览文件方法
                uploadJson: '/Editor/UploadFile',              //上传文件方法  //注意这两个路径
            });
        });

        //$('body').on('click', '.imgExhibition', function () {
        //    var tempimgscr = $(this).attr('imgsrc');
        //    $(this).parent().remove();
        //})
    </script>
</body>
</html>
