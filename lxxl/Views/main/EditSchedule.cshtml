                </label>
                <div class="layui-input-inline">
                    <input type="number" id="Price" name="Price" required="" lay-verify="required" value="@DoctorSchedule.Price">
                </div>
            </div>
            <div class="layui-form-item">
                <label for="L_pass" class="layui-form-label">
                    咨询方式
                </label>
                <div class="layui-input-inline">
                    <select name="methods" lay-filter="methods">
                        <option value="面询" @(DoctorSchedule.methods == "面询" ? "selected" : "")> 面询</option>
                        <option value="视频" @(DoctorSchedule.methods == "视频" ? "selected" : "")>视频</option>
                    </select>
                </div>
            </div>
            <div class="layui-form-item">
                <label for="L_pass" class="layui-form-label">
                    咨询地点
                </label>
                <div class="layui-input-inline">
                    <select name="address" lay-filter="address">
                        @foreach (T_SystemSettings item in RoomList)
                        {
                            <option value="@item.content1" @(DoctorSchedule.address == item.content1 ? "selected" : "")> @item.content1</option>
                        }
                    </select>
                </div>
            </div>
            <div class="layui-form-item">
                <label for="L_repass" class="layui-form-label">
                </label>
