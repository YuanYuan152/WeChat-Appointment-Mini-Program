@{
    ViewBag.Title = "ScheduleLst";
    Layout = null;
}
<!DOCTYPE html>
<html class="x-admin-sm">
<head>
    <meta charset="UTF-8">
    <title>排期表</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row layui-col-space15">
            <div class="layui-col-md12">
                <div class="layui-card">
                    <div class="layui-card-body ">
                        <table class="layui-hide" id="test" lay-filter="test" style="max-height:90%;"></table>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <script type="text/html" id="toolbarDemo1">
        <div class="layui-btn-container" style="margin-right: 200px;">
            <button class="layui-btn" onclick="xadmin.open('添加', '/main/AddSchedule/'+@ViewBag.doctorID, 450, 450)"><i class="layui-icon"></i>添加</button>
        </div>
    </script>
    <script type="text/html" id="barDemo">
        <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
        <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del">删除</a>
    </script>

    <script>
        var doctorID = '@ViewBag.doctorID';
        layui.use(['table', 'util'], function () {
            var table = layui.table;
            var util = layui.util;

        table.render({
            elem: '#test'
          , height: 'full-120'
          , url: '/main/GetScheduleList'
          , where: { ID: doctorID }
           , toolbar: true
          , toolbar: '#toolbarDemo1' //开启头部工具栏，并为其绑定左侧模板
          , title: '排期设置表'
          , totalRow: false
          , cols: [[
            { type: 'checkbox', width: 40, fixed: 'left' }
            , { field: 'gId', title: 'gId', hide:true}
            , { field: 'ID', title: 'ID', width: 80, fixed: 'left', unresize: true, sort: true }
            , { field: 'startTime', title: '开始时间' }
            , { field: 'endTime', title: '结束时间' }
            , { field: 'week', title: '星期' }
            //, { field: 'maxSign', title: '最大报名' }
            , { field: 'Price', title: '咨询费用', }
              , { field: 'methods', title: '咨询方式', }
            , { field: 'address', title: '咨询地点', }
            , { fixed: 'right', title: '操作', toolbar: '#barDemo', width: 150 }
          ]]
          , page: true
          , limits: [10, 20,100, 1000]
          , limit: 100 //每页默认显示的数量
        });

        //头工具栏事件
        table.on('toolbar(test)', function (obj) {
            var checkStatus = table.checkStatus(obj.config.id);
            switch (obj.event) {
                case 'getCheckData':
                    layer.open({
                        type: 2
                        , content: '/main/AddSchedule/'+doctorID
                        , area: ['450px', '450px']
                        , maxmin: true
                        , end :function(){
                            location.reload();
                        }
                        , title: "添加排期"
                    });
                    break;
                case 'getCheckLength':
                    var data = checkStatus.data;
                    layer.msg('选中了：' + data.length + ' 个');
                    break;
                case 'isAll':
                    layer.msg(checkStatus.isAll ? '全选' : '未全选');
                    break;

                    //自定义头工具栏右侧图标 - 提示
                case 'LAYTABLE_TIPS':
                    layer.alert('帮助');
                    break;
                case 'reload':
                    var searchName = $('#searchName').val();
                    table.reload('test', {
                        url: '/mapi/GetAdminList'
                        , where: { keyword: searchName }
                        , page: 1
                    }, 'data');
                    $('#searchName').val(searchName);
                    break;
            };
        });

        //监听行工具事件
        table.on('tool(test)', function (obj) {
            var data0 = obj.data;
            console.log(obj)
            if (obj.event === 'del') {
                layer.confirm('真的删除么', function (index) {
                    $.post("/main/DelSchedule", { gId: data0.gId }, function (data) {
                        if (data.code == 0) {
                            obj.del();
                            layer.msg(data.msg);
                            layer.close(index);
                            //location.reload();
                        } else {
                            layer.alert(data.msg);
                        }
                    });
                });
            } else if (obj.event === 'edit') {
                xadmin.open('编辑管理员', '/main/EditSchedule?gId=' + data0.gId, 500, 450);
            }
        });
    });

    </script>
</body>

</html>