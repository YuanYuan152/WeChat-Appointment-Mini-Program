@{
    Layout = null;
    ViewBag.Title = "adminLst";
}
<!DOCTYPE html>
<html class="x-admin-sm">
<head>
    <meta charset="UTF-8">
    <title>管理员列表</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
</head>
<body>
    <div class="x-nav">
        <span class="layui-breadcrumb">
            <a href="">首页</a>
            <a>
                <cite>管理员列表</cite>
            </a>
        </span>
        <a class="layui-btn layui-btn-small" style="line-height:1.6em;margin-top:3px;float:right" onclick="location.reload()" title="刷新">
            <i class="layui-icon layui-icon-refresh" style="line-height:30px"></i>
        </a>
    </div>
    <div class="layui-fluid">
        <div class="layui-row layui-col-space15">
            <div class="layui-col-md12">
                <div class="layui-card">                   
                    @*<div class="layui-card-header">
                        <button class="layui-btn layui-btn-danger" onclick="delAll()"><i class="layui-icon"></i>批量删除</button>
                        <button class="layui-btn" onclick="xadmin.open('添加用户', '/main/AddCourse', 600, 400)"><i class="layui-icon"></i>添加</button>
                    </div>*@
                    <div class="layui-card-body ">
                        <table class="layui-hide" id="test" lay-filter="test" style="max-height:90%;"></table>
                    </div>
                
                </div>
            </div>
        </div>
    </div>
    <script type="text/html" id="toolbarDemo">
        <div class="layui-btn-container" style="margin-right: 200px;">
            @*<button class="layui-btn layui-btn-danger" onclick="delAll()"><i class="layui-icon"></i>批量删除</button>*@
            <button class="layui-btn" onclick="xadmin.open('添加管理员', '/main/AddAdmin', 500, 450)"><i class="layui-icon"></i>添加</button>
        </div>
    </script>
    <script type="text/html" id="barDemo">
        <a class="layui-btn layui-btn-xs" lay-event="edit">编辑</a>
        <a class="layui-btn layui-btn-danger layui-btn-xs" lay-event="del" >删除</a>
    </script>

    <script>
        layui.use('table', function () {
            var table = layui.table;

            table.render({
                elem: '#test'
                  , height: 'full-120'
              , url: '/main/GetAdminList'
              , where: { keyword: '' }
               , toolbar: true
              , toolbar: '#toolbarDemo' //开启头部工具栏，并为其绑定左侧模板
              , title: '人员表'
              , totalRow: false
              , cols: [[
                { type: 'checkbox', width: 40, fixed: 'left' }
                , { field: 'ID', title: 'ID', width: 80, fixed: 'left', unresize: true, sort: true }
                , { field: 'UserName', title: '用户名' }
                , { field: 'Name', title: '姓名' }
                , { field: 'Tel', title: '电话' }
                , { field: 'Password', title: '密码' }
                , { field: 'type', title: '类型', }
                , { field: 'time', title: '创建时间', sort: true }
                , { fixed: 'right', title: '操作', toolbar: '#barDemo', width: 150 }
              ]]
              , page: true
              , limits: [10, 15, 20, 1000]
              , limit: 15 //每页默认显示的数量
            });

            //头工具栏事件
            table.on('toolbar(test)', function (obj) {
                var checkStatus = table.checkStatus(obj.config.id);
                //layer.alert(obj.event);
                switch (obj.event) {
                    case 'getCheckData':
                        //var data = checkStatus.data;
                        //layer.alert(JSON.stringify(data));
                        layer.open({
                            type: 2
                            , content: '/main/AddAdmin/1'
                            , area: ['450px', '450px']
                            , maxmin: true
                            //, end :function(){
                            //    location.reload();
                            //}
                            , title: "添加管理员"
                        });
                        break;
                    case 'getCheckLength':
                        var data = checkStatus.data;
                        layer.msg('选中了：' + data.length + ' 个');
                        break;
                    case 'isAll':
                        layer.msg(checkStatus.isAll ? '全选' : '未全选');
                        break;

                        //自定义头工具栏右侧图标 - 提示
                    case 'LAYTABLE_TIPS':
                        layer.alert('帮助');
                        break;
                    case 'reload':
                        var searchName = $('#searchName').val();
                        //alert(searchName);
                        table.reload('test', {
                            url: '/mapi/GetAdminList'
                            , where: { keyword: searchName }
                            , page: 1
                        }, 'data');
                        $('#searchName').val(searchName);
                        break;
                };
            });

            //监听行工具事件
            table.on('tool(test)', function (obj) {
                var data0 = obj.data;
                console.log(obj)
                if (obj.event === 'del') {
                    layer.confirm('真的删除' + data0.UserName + '么', function (index) {
                        $.post("/main/DelAdmin", { id: data0.ID }, function (data) {
                            if (data.code == 0) {
                                obj.del();
                                layer.msg(data.msg);
                                layer.close(index);
                                //location.reload();
                            } else {
                                layer.alert(data.msg);
                            }
                        });
                    });
                } else if (obj.event === 'edit') {
                    xadmin.open('编辑管理员', '/main/EditAdmin/' + data0.ID, 500, 450);
                    //layer.open({
                    //    type: 2
                    //        , content: '/main/EditAdmin/' 
                    //        , area: ['400px', '450px']
                    //        , maxmin: true
                    //    //, end: function () {
                    //    //    location.reload();
                    //    //}
                    //     , title: "编辑人员"
                    //});
                }
            });
        });

    </script>
</body>

</html>