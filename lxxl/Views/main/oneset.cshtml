@using lxxl.Models
@{
    Layout = null;
    ViewBag.Title = "oneset";
    T_Admin TAdmin = ViewBag.userT;
}

<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>管理员编辑</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <input type="text" id="ID" name="ID" hidden value="@TAdmin.ID">
                <input type="text" id="Type" name="Type" hidden value="@TAdmin.Type">
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>登录名
                    </label>
                    <div class="layui-input-inline">
                        <input type="text" id="username" name="UserName" class="layui-input" disabled value="@TAdmin.UserName">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>姓名
                    </label>
                    <div class="layui-input-inline">
                        <input type="text" id="Name" name="Name" class="layui-input" disabled value="@TAdmin.Name">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="phone" class="layui-form-label">
                        <span class="x-red">*</span>手机
                    </label>
                    <div class="layui-input-inline">
                        <input type="text" id="phone" name="Tel" required=""
                               autocomplete="off" class="layui-input" value="@TAdmin.Tel">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_email" class="layui-form-label">
                        <span class="x-red">*</span>邮箱
                    </label>
                    <div class="layui-input-inline">
                        <input type="text" id="L_email" name="Mail" 
                               autocomplete="off" class="layui-input" value="@TAdmin.Mail">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_pass" class="layui-form-label">
                        <span class="x-red">*</span>密码
                    </label>
                    <div class="layui-input-inline">
                        <input type="password" id="L_pass" name="Password" 
                               autocomplete="off" class="layui-input" value="">
                    </div>
                    <div class="layui-form-mid layui-word-aux">
                        6到16个字符
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                        <span class="x-red">*</span>新密码
                    </label>
                    <div class="layui-input-inline">
                        <input type="password" id="L_repass" name="newpassword" placeholder="新密码为空则不修改"
                               autocomplete="off" class="layui-input">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        立即提交
                    </button>
                </div>
            </form>
        </div>
    </div>
    <script>
        layui.use(['form', 'layer'],
                    function () {
                        $ = layui.jquery;
                        var form = layui.form,
                        layer = layui.layer;

                        //自定义验证规则
                        form.verify({
                            nikename: function (value) {
                                if (value.length < 5) {
                                    return '昵称至少得5个字符啊';
                                }
                            },
                            Password: [/(.+){6,12}$/, '密码必须6到12位'],
                            repass: [/(.+){6,12}$/, '密码必须6到12位']
                            //repass: function (value) {
                            //    if ($('#L_pass').val() != $('#L_repass').val()) {
                            //        return '两次密码不一致';
                            //    }
                            //}

                           
                        });

                        //监听提交
                        form.on('submit(add)',
                        function (data) {
                            console.log(data);
                            //发异步
                            $.post("/main/EditOne", { field: JSON.stringify(data.field) }, function (data) {
                                if (data.code == 0) {
                                    layer.alert("编辑成功", {
                                        icon: 6
                                    },
                                    function () {
                                        //关闭当前frame
                                        xadmin.close();

                                        // 可以对父窗口进行刷新
                                        xadmin.father_reload();
                                    });
                                } else {
                                    layer.alert(data.msg);
                                }
                            });
                            return false;
                        });

                    });</script>
</body>
</html>

