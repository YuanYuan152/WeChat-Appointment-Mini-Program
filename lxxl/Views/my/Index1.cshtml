    <style type="text/css">
        .l-header {
            position: relative;
            z-index: 100;
        }

            .l-header.shadow {
                box-shadow: 0 1px 5px rgba(0,0,0,.14);
            }

            .l-header a {
                color: #666;
                text-decoration: none;
            }

        .l-header--container {
            display: block;
            background: #fff;
            z-index: 3;
        }

            .l-header--container .jdxl-logo {
                position: absolute;
                left: 0;
                top: 15px;
                width: 105px;
                height: 56px;
                line-height: 47px;
                z-index: 4;
            }

            .l-header--container .l-header--inner {
                position: relative;
                width: 1000px;
                height: 80px;
                padding: 0;
                margin: 0 auto;
                overflow: visible;
            }

            .l-header--container .nav-list {
                display: inline-block;
                vertical-align: middle;
                height: 80px;
                font-size: 14px;
                padding: 0 0 0 110px;
            }

            .l-header--container .nav-item {
                position: relative;
                font-size: 18px;
                float: left;
                margin: 0 5px;
                min-width: 100px;
                text-align: center;
            }

                .l-header--container .nav-item:hover {
                    background: #129994;
                }

                    .l-header--container .nav-item:hover .user-signup a, .l-header--container .nav-item:hover a {
                        color: #fff;
                    }

                    .l-header--container .nav-item:hover .sub-nav--item a {
                        color: #666;
                    }

                .l-header--container .nav-item:after {
                    position: absolute;
                    bottom: -15px;
                    display: block;
                    content: "";
                    width: 100%;
                    height: 16px;
                    background: transparent;
                    z-index: 888;
                }

            .l-header--container .hot {
                position: absolute;
                top: 15px;
                right: -8px;
                display: inline-block;
                vertical-align: super;
                background: #ff5757;
                font-size: 10px;
                font-style: italic;
                color: #fff;
                line-height: 1.6;
                border-radius: 4px;
                padding: 0 5px;
            }

            .l-header--container .nav-item:hover .sub-nav--item {
                display: block;
            }

            .l-header--container .nav-item a {
                display: block;
                height: 80px;
                line-height: 80px;
                padding: 0 18px;
            }

            .l-header--container .sub-nav--item {
                position: absolute;
                left: 0;
                top: 90px;
                display: none;
                width: 100%;
                background: #fff;
                text-align: center;
                white-space: nowrap;
                padding: 4px 0;
                box-shadow: 1px 1px 30px rgba(0,0,0,.1);
                z-index: 888;
            }

                .l-header--container .sub-nav--item:before {
                    display: block;
                    content: "";
                    width: 0;
                    height: 0;
                    border-color: transparent transparent #fff;
                    border-style: solid;
                    border-width: 0 10px 10px;
                    margin: -10px auto auto;
                }

                .l-header--container .sub-nav--item a {
                    display: block;
                    height: 50px;
                    color: #666;
                    line-height: 50px;
                    text-align: center;
                    padding: 0;
                    cursor: pointer;
                }

            .l-header--container .nav-item:hover .sub-nav--item a:hover {
                color: #129994;
            }

            .l-header--container .message {
                float: right;
                margin: 28px 20px 0 0;
            }

                .l-header--container .message a {
                    position: relative;
                    display: block;
                    height: 24px;
                    background: url(//assets-1251943848.file.myqcloud.com/assets/desktop/icons/alarm-a2446874f9d55b565ff67d085310e6d09ee788e2fe92cd561b1060d6870a4b64.jpg) no-repeat 0 0/24px 100%;
                    padding: 0 0 0 30px;
                }

                .l-header--container .message .numbers {
                    position: absolute;
                    top: -8px;
                    left: 12px;
                    display: block;
                    width: 10px;
                    height: 10px;
                    background: #f16272;
                    font-size: 10px;
                    color: #fff;
                    padding: 0 5px;
                    border-radius: 10px;
                }

            .l-header--container .user-account {
                position: relative;
                float: right;
                width: 150px;
                margin: 0;
            }

                .l-header--container .user-account .user-signup a {
                    color: #129994;
                    text-align: center;
                }

                .l-header--container .user-account:hover .sub-nav--item {
                    display: block;
                }

                .l-header--container .user-account .sub-nav--item a {
                    display: flex;
                    align-items: center;
                    height: 50px;
                    font-size: 18px;
                    line-height: 25px;
                    padding: 0 18px;
                    white-space: pre-line;
                }

                .l-header--container .user-account .name {
                    float: left;
                    max-width: 48px;
                    font-size: 14px;
                    white-space: nowrap;
                    text-overflow: ellipsis;
                    overflow: hidden;
                }

                .l-header--container .user-account a {
                    display: block;
                    height: 80px;
                    text-align: left;
                    line-height: 80px;
                    padding: 0 18px;
                }

                .l-header--container .user-account .avatar {
