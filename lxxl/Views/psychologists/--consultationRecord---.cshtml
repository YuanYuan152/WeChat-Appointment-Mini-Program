@{
    Layout = null;
    T_Consultation consultation = ViewBag.consultation;
    //string[] alist = ViewBag.alist;
}
@using lxxl.Models

<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>咨询服务结果填报</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=0">
    <link rel="stylesheet" href="/Content/weui/css/weui.css" />
    <link rel="stylesheet" href="/Content/weui/css/weuix.css" />
    <script src="/Content/weui/js/zepto.min.js"></script>
    <script src="/Content/weui/js/zepto.weui.js"></script>
    <script src="/Content/weui/js/picker.city.js"></script>
    <script>
        $(function () {

            $(document).on("click", "#btn", function () {
                var PIteam = $("#PIteam").val();
                if (PIteam == "") {
                    $.toptip("PI团队不能为空");
                    return false;
                }
                var projectName = $("#projectName").val();
                if (projectName == "") {
                    $.toptip("项目名称不能为空");
                    return false;
                }
                var idd = 1;
                var content = "";
                var obj = document.getElementsByName("f3");
                var check_val = [];
                for (k in obj) {
                    if (obj[k].checked)
                        if (obj[k].checked && idd == 1) {
                            content = obj[k].value;
                            idd = 2;
                        } else {
                            content = content + "," + obj[k].value;
                        }
                }
                if (content == "") {
                    $.toptip("请选择项目来源");
                    return false;
                }
                var cTime = $("#years-monthes").val();
                if (cTime == "") {
                    $.toptip("咨询时间不能为空");
                    return false;
                }
                var duration = $("#duration").val();
                if (duration == "") {
                    $.toptip("咨询时长不能为空");
                    return false;
                }
                var expert = $("#expert").val();
                if (expert == "") {
                    $.toptip("咨询专家不能为空");
                    return false;
                }
                else if (expert == "其他") {
                    var qitaexpert = $("#qitaexpert").val();
                    if (qitaexpert == "") {
                        $.toptip("其他咨询专家不能为空");
                        return false;
                    }
                    else if (qitaexpert.length <= 2) {
                        $.toptip("咨询专家需大于2位");
                        return false;
                    }
                    expert = qitaexpert;
                }
                var record = $("#record").val();
                if (record == "") {
                    $.toptip("咨询记录不能为空");
                    return false;
                }
                var imgsrc = "";
                $(".imgID").each(function(){
                    if(imgsrc != "")
                    {
                        imgsrc = imgsrc +","+ $(this).attr("imgsrc");
                    }
                    else
                    {
                        imgsrc = $(this).attr("imgsrc");
                    }
                });
                var intention = $("#intention").val();
                var isSend = document.getElementsByName("isSend")[0];
                var gid = $("#gid").val();
                $.showLoading("数据提交中");
                setTimeout(function() {
                    $.hideLoading();
                }, 3000);
                //, "isSend": isSend.checked
                //alert(PIteam+ projectName+content+cTime+ duration+ expert+record+ upfile+ intention);
                $.ajax({
                    url: "/wapig/postConsultationRecord",
                    data: { "gid": gid, "PIteam": PIteam , "projectName": projectName, "projectSource": content, "cTime": cTime, "duration": duration,"expert": expert, "record": record, "upfile": imgsrc, "intention": intention},
                    //data: { "gid": gid, "PIteam": "" , "projectName": "", "projectSource": "", "cTime": "", "duration": "","expert": "", "record": "", "upfile": "", "intention": ""},
                    type: "post",
                    dataType: "text",
                    success: function (data) {
                        var result = JSON.parse(data);
                        if (result.code == 0) {
                            abcd = 1
                            $.alert("咨询数据提交成功。", "提交成功提示", function () {
                                //WeixinJSBridge.call('closeWindow');
                                var index = parent.layer.getFrameIndex(window.name); // 获取当前页面的索引
                                parent.layer.close(index); // 关闭当前页面
                            });
                        }
                        else {
                            abcd = 1
                            $.alert(result.msg,"提示",function(){

                            });
                        }
                    },
                    error: function () {
                        abcd = 1
                        $.alert("服务器连接失败。","提示",function(){

                        });
                    }
                })
                //$.alert("提交成功", "提交成功提示", function () {
                //    //window.opener = null;
                //    //window.open('', '_self');
                //    //window.close();
                //    WeixinJSBridge.call('closeWindow');
                //});
            });
            //解决表单控件不能回弹 只有微信ios有这个问题
            //    $("input,select,textarea").blur(function(){
            //        setTimeout(() => {
            //            const scrollHeight = document.documentElement.scrollTop || document.body.scrollTop || 0;
            //        window.scrollTo(0, Math.max(scrollHeight - 1, 0));
            //    }, 100);
            //})
            function isValidEmailAddress(emailAddress) {
                var pattern = /^\w+((-\w+)|(\.\w+))*\@@[A-Za-z0-9]+((\.|-)[A-Za-z0-9]+)*\.[A-Za-z0-9]+$/;
                return pattern.test(emailAddress);
            };

        });

        function textarea(input) {
            var content = $(input);
            var max = content.next().find('i').text();
            var value = content.val();
            if (value.length > 0) {

                value = value.replace(/\n|\r/gi, "");
                var len = value.length;
                content.next().find('span').text(len);
                if (len > max) {
                    content.next().addClass('f-red');
                } else {
                    content.next().removeClass('f-red');
                }
            }
        }

        function cleartxt(obj) {
            $(obj).prev().find('.weui-input').val("");
            return false;
        }

        function cleararea(obj) {
            $(obj).prev().find('.weui-textarea').val("").next().find("span").text(0);
            return false;
        }

    </script>
</head>

<body style="background-color: #EFEFEF; ">
