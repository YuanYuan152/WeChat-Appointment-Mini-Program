@using lxxl.Models
@{
    ViewBag.Title = "AddSchedule";
    Layout = null;
    List<T_SystemSettings> RoomList = ViewBag.RoomList;
}

<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>添加排期时间</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
    <!-- 让IE8/9支持媒体查询，从而兼容栅格 -->
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>时间
                        <input type="text" id="doctorID" name="doctorID" hidden value="@ViewBag.doctorID">
                    </label>
                    <div class="layui-input-inline">
                        <input class="layui-input" placeholder="时间" name="startTime" id="startTime" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_email" class="layui-form-label">
                        <span class="x-red">*</span>开始时刻
                    </label>
                    <div class="layui-input-inline">
                        <select name="startH" lay-filter="startH">
                            <option value="08:00">08:00</option>
                            <option value="08:30">08:30</option>
                            <option value="09:00">09:00</option>
                            <option value="09:30">09:30</option>
                            <option value="10:00">10:00</option>
                            <option value="10:30">10:30</option>
                            <option value="11:00">11:00</option>
                            <option value="11:30">11:30</option>
                            <option value="12:00">12:00</option>
                            <option value="12:30">12:30</option>
                            <option value="13:00">13:00</option>
                            <option value="13:30">13:30</option>
                            <option value="14:00">14:00</option>
                            <option value="14:30">14:30</option>
                            <option value="15:00">15:00</option>
                            <option value="15:30">15:30</option>
                            <option value="16:00">16:00</option>
                            <option value="16:30">16:30</option>
                            <option value="18:00">17:00</option>
                            <option value="18:30">17:30</option>
                            <option value="18:00">18:00</option>
                            <option value="18:30">18:30</option>
                            <option value="19:00">19:00</option>
                            <option value="19:30">19:30</option>
                            <option value="20:00">20:00</option>
                            <option value="20:30">20:30</option>
                            <option value="21:00">21:00</option>
                            <option value="21:30">21:30</option>
                            <option value="21:00">22:00</option>
                            <option value="21:30">22:30</option>
                            <option value="21:00">23:00</option>
                            <option value="21:30">23:30</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label class="layui-form-label"><span class="x-red">*</span>结束时刻</label>
                    <div class="layui-input-inline">
                        <select name="endH" lay-filter="endH">
                            <option value="08:30">08:30</option>
                            <option value="09:00">09:00</option>
                            <option value="09:30">09:30</option>
                            <option value="10:00">10:00</option>
                            <option value="10:30">10:30</option>
                            <option value="11:00">11:00</option>
                            <option value="11:30">11:30</option>
                            <option value="12:00">12:00</option>
                            <option value="12:30">12:30</option>
                            <option value="13:00">13:00</option>
                            <option value="13:30">13:30</option>
                            <option value="14:00">14:00</option>
                            <option value="14:30">14:30</option>
                            <option value="15:00">15:00</option>
                            <option value="15:30">15:30</option>
                            <option value="16:00">16:00</option>
                            <option value="16:30">16:30</option>
                            <option value="18:00">17:00</option>
                            <option value="18:30">17:30</option>
                            <option value="18:00">18:00</option>
                            <option value="18:30">18:30</option>
                            <option value="19:00">19:00</option>
                            <option value="19:30">19:30</option>
                            <option value="20:00">20:00</option>
                            <option value="20:30">20:30</option>
                            <option value="21:00">21:00</option>
                            <option value="21:30">21:30</option>
                            <option value="21:00">22:00</option>
                            <option value="21:30">22:30</option>
                            <option value="21:00">23:00</option>
                            <option value="21:30">23:30</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                        <span class="x-red">*</span>咨询费用
                    </label>
                    <div class="layui-input-inline">
                        <input type="number" id="Price" name="Price" required="" lay-verify="required">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_pass" class="layui-form-label">
                        咨询方式
                    </label>
                    <div class="layui-input-inline">
                        <select name="methods" lay-filter="methods">
                            <option value="面询">面询</option>
                            <option value="视频">视频</option>
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_pass" class="layui-form-label">
                        咨询地点
                    </label>
                    <div class="layui-input-inline">
                        <select name="address" lay-filter="address">
                            @foreach (T_SystemSettings item in RoomList)
                            {
                                <option value="@item.content1">@item.content1</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        立即提交
                    </button>
                </div>
            </form>
        </div>
    </div>
    <script>
        layui.use(['laydate', 'element', 'form', 'layer'],
                    function () {
                        $ = layui.jquery;
                        var form = layui.form,
                        layer = layui.layer;
                        laydate = layui.laydate;

                        //自定义验证规则
                        form.verify({

                        });

                        //执行一个laydate实例
                        laydate.render({
                            elem: '#startTime' //指定元素
                        });

                        //执行一个laydate实例
                        laydate.render({
                            elem: '#endTime' //指定元素
                        });


                        //监听提交
                        form.on('submit(add)',
                        function (data) {
                            console.log(data);
                            //发异步
                            $.post("/psychologists/AddSchedule", { field: JSON.stringify(data.field) }, function (data) {
                                if (data.code == 0) {
                                    layer.alert("增加成功", {
                                        icon: 6
                                    },
                                    function () {
                                        //关闭当前frame
                                        xadmin.close();

                                        // 可以对父窗口进行刷新
                                        xadmin.father_reload();
                                    });
                                } else {
                                    layer.alert(data.msg);
                                }
                            });
                            return false;
                        });

                    });
    </script>
</body>
</html>
