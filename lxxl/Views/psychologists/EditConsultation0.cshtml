    <link rel="stylesheet" href="/Content/layui/dist/css/layui.css">
    <script src="/Content/layui/dist/layui.js"></script>
    <script>
        $(function () {
            $(document).on("click", "#btn", function () {
                var date = $("#date").val();
                if (date == "") {
                    $.toptip("日期不能为空");
                    return false;
                }
                var shijian = $("#shijian").val();
                var endshijian = $("#endshijian").val();
                if (endshijian < shijian)
                {
                    $.toptip("时间不正确");
                    return false;
                }
                var gid = $("#gid").val();
                //var duration = $("#duration").val();
                var name = $("#name").val();
                var remark = $("#remark").val();
                //$.alert($("#name").val() + "预约咨询时间为" + date + " " + shijian + "。 已通过临床研究中心微信公众号通知预约人。", "时间设置成功提示", function () {
                //    WeixinJSBridge.call('closeWindow');
                //});

                $.ajax({
                    url: "/mapi/EditconsultationTimeD",
                    data: { "gid": gid, "appointmentTime": date + " " + shijian, "eTime": date + " " + endshijian, "remark": remark },
                    type: "post",
                    dataType: "text",
                    success: function (data) {
                        var result = JSON.parse(data);
                        if (result.code == 0) {
                            abcd = 1
                            //if (window.confirm(name + "医生预约咨询时间为" + date + " 时长" + duration + "小时。 已通过临床研究中心微信公众号通知预约人。")) {
                            //    window.parent.layer.closeAll();//关闭弹窗
                            //    window.parent.location.reload();
                            //}
                            $.alert("<span style='color:#fd7d36;font-weight: bold;font-size: 20px; '>" + name + "</span>" + "预约咨询时间为" + date + " " + shijian + "-" + endshijian + "。 已通过微信公众号通知预约人。", "时间设置成功提示", function () {
                                //WeixinJSBridge.call('closeWindow');
                                var index = parent.layer.getFrameIndex(window.name); // 获取当前页面的索引
                                parent.layer.close(index); // 关闭当前页面
                            });
                        }
                        else {
                            abcd = 1
                            $.alert(result.msg, "提示", function () {

                            });
                        }
                    },
                    error: function () {
                        abcd = 1
                        $.alert("服务器连接失败。", "提示", function () {

                        });
                    }
                })
            })
            //解决表单控件不能回弹 只有微信ios有这个问题
            //    $("input,select,textarea").blur(function(){
            //        setTimeout(() => {
            //            const scrollHeight = document.documentElement.scrollTop || document.body.scrollTop || 0;
            //        window.scrollTo(0, Math.max(scrollHeight - 1, 0));
            //    }, 100);
            //})
            function isValidEmailAddress(emailAddress) {
                var pattern = /^\w+((-\w+)|(\.\w+))*\@@[A-Za-z0-9]+((\.|-)[A-Za-z0-9]+)*\.[A-Za-z0-9]+$/;
                return pattern.test(emailAddress);
            };

        });

        function textarea(input) {
            var content = $(input);
            var max = content.next().find('i').text();
            var value = content.val();
            if (value.length > 0) {

                value = value.replace(/\n|\r/gi, "");
                var len = value.length;
                content.next().find('span').text(len);
                if (len > max) {
                    content.next().addClass('f-red');
                } else {
                    content.next().removeClass('f-red');
                }
            }
        }

        function cleartxt(obj) {
            $(obj).prev().find('.weui-input').val("");
            return false;
        }

        function cleararea(obj) {
            $(obj).prev().find('.weui-textarea').val("").next().find("span").text(0);
            return false;
        }

    </script>
</head>

<body style="background-color: #EFEFEF; ">
    <div class="page-hd" style="padding-top: 5px; padding-bottom: 5px; background-color: #E7E8ED; ">
        <h1 class="page-hd-title" style="color: #1ea0fa; font-weight: bold; margin: 0; padding: 0; text-align: center; padding-bottom: 2px;">
