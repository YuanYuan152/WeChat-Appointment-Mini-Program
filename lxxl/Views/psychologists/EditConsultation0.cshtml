            <div class="weui-cell__bd">
                <input class="weui-input border-radius" id="date" type="text" style="width: 105px;" value="@ViewBag.getDate">
                <input class="weui-input border-radius" id="shijian" placeholder="请选择时间" required type="text" value="@ViewBag.gettime" style="width: 85px;">-
                <input class="weui-input border-radius" id="endshijian" placeholder="请选择结束时间" required type="text" value="@ViewBag.getendtime" style="width: 85px;">
            </div>
        </div>
        @*<div class="weui-cell">
