@using lxxl.Models
@{
    Layout = null;
    ViewBag.Title = "ConsultationRecord";
    T_ConsultationRecord ConsultationRecord = ViewBag.ConsultationRecord;
}
<!DOCTYPE html>
<html class="x-admin-sm">

<head>
    <meta charset="UTF-8">
    <title>编辑来访者</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script type="text/javascript" src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
</head>
<body>
    <div class="layui-fluid">
        <div class="layui-row">
            <form class="layui-form">
                <input type="text" id="ID" name="ID" hidden value="@ConsultationRecord.ID">
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>姓名
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="name" name="name" class="layui-input" value="@ConsultationRecord.name" disabled>
                    </div>
                </div>
                @*<div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>电话
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="mobile" name="mobile" class="layui-input" value="@ConsultationRecord.mobile">
                    </div>
                </div>*@
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>来源
                    </label>
                    <div class="layui-input-block">
                        <input type="text" id="record" name="record" class="layui-input" value="@ConsultationRecord.record" disabled>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>是否结案
                    </label>
                    <div class="layui-input-block">
                        <input type="checkbox" name="IsShow" value="true" title="结案">
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="username" class="layui-form-label">
                        <span class="x-red">*</span>结案说明
                    </label>
                    <div class="layui-input-block">
                        <textarea name="Remark1" style="width:100%;height:100px;">@ConsultationRecord.Remark1</textarea>
                    </div>
                </div>
                <div class="layui-form-item">
                    <label for="L_repass" class="layui-form-label">
                    </label>
                    <button class="layui-btn" lay-filter="add" lay-submit="">
                        提交保存
                    </button>
                </div>
            </form>
        </div>
    </div>

    <link href="~/Content/kindeditor-4.1.7/themes/default/default.css" rel="stylesheet" />
    <script src="~/Content/kindeditor-4.1.7/kindeditor-min.js"></script>
    <script charset="utf-8" src="~/Content/kindeditor-4.1.7/lang/zh_CN.js"></script>
    <script type="text/javascript" src="https://cdn.bootcss.com/jquery/3.2.1/jquery.min.js"></script>
    <script type="text/javascript" src="/Content/mhome/js/xcity.js"></script>
    <script>
        layui.use(['laydate', 'element', 'form', 'layer'],
                    function () {
                        $ = layui.jquery;
                        var form = layui.form,
                        layer = layui.layer;

                        //自定义验证规则
                        form.verify({

                        });


                        //监听提交
                        form.on('submit(add)',
                        function (data) {
                            console.log(data);
                            //发异步
                            $.post("/psychologists/EditConsultationRecord2", { field: JSON.stringify(data.field) }, function (data) {
                                if (data.code == 0) {
                                    layer.alert("提交成功", {
                                        icon: 6
                                    },
                                    function () {
                                        //关闭当前frame
                                        xadmin.close();

                                        // 可以对父窗口进行刷新
                                        xadmin.father_reload();
                                    });
                                } else {
                                    layer.alert(data.msg);
                                }
                            });
                            return false;
                        });

                    });
    </script>
</body>
</html>
