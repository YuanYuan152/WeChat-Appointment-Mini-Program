@{
    Layout = null;
    ViewBag.Title = "Doctor";
}
<!DOCTYPE html>
<html class="x-admin-sm">
<head>
    <meta charset="UTF-8">
    <title>咨询列表</title>
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    
    <link rel="stylesheet" href="/Content/mhome/css/font.css">
    <link rel="stylesheet" href="/Content/mhome/css/index.css">
    <script src="/Content/mhome/lib/layui/layui.js" charset="utf-8"></script>
    <script type="text/javascript" src="/Content/mhome/js/index.js"></script>
    <style type="text/css">
        .layui-table-cell {
            height: auto !important;
            white-space: normal;
        }

        .layui-table img {
            max-width: 300px;
        }
    </style>
</head>
<body>
    <div class="x-nav">
        <span class="layui-breadcrumb">
            <a href="">首页</a>
            <a>
                <cite>咨询列表</cite>
            </a>
        </span>
        <a class="layui-btn layui-btn-small" style="line-height:1.6em;margin-top:3px;float:right" onclick="location.reload()" title="刷新">
            <i class="layui-icon layui-icon-refresh" style="line-height:30px"></i>
        </a>
    </div>
    <div class="layui-fluid">
        <div class="layui-row layui-col-space15">
            <div class="layui-col-md12">
                <div class="layui-card">
                    <div class="layui-card-body ">
                        <table class="layui-hide" id="test" lay-filter="test" style="max-height:95%;"></table>
                    </div>
                   

                </div>
            </div>
        </div>
    </div>
    <script type="text/html" id="toolbarDemo">
        @*<div class="layui-btn-container" style="margin-right: 200px;">
            <input type="text" placeholder="姓名、手机号" class="searchName" id="searchName" style="padding: 1px 0px 0px 25px;">
            <i style="font-size: 18px; position: absolute; top: 11px;  cursor: pointer; margin-left: -19px;" class="layui-icon layui-icon-close" lay-event="searchclose"></i>
            <input type="text" placeholder="查询时间" class="chooseDay" id="chooseDay" style="padding: 1px 0px 0px 10px; margin-left: 10px;">
            <button class="layui-btn layui-btn-sm" lay-event="reload" style="margin-left: 10px;">查询</button>
        </div>*@
        <div >
            <form class="layui-form layui-col-space5">
                <div class="layui-inline layui-show-xs-block">
                    <input type="text" placeholder="姓名、手机号" class="searchName layui-input" id="searchName" autocomplete="off">
                </div>
                <div class="layui-inline layui-show-xs-block">
                    <input type="text" placeholder="查询时间" class="chooseDay layui-input" id="chooseDay" style="padding: 1px 0px 0px 10px; margin-left: 10px;">
                </div>
                <div class="layui-inline layui-show-xs-block">
                    @*<button class="layui-btn" lay-submit="" lay-filter="sreach"><i class="layui-icon">&#xe615;</i></button>*@
                    <button class="layui-btn layui-btn-sm" lay-event="reload" style="margin-left: 10px;">查询</button>
                </div>
            </form>
        </div>
    </script>
    <script type="text/html" id="barDemo">
        <a class="layui-btn layui-btn-xs" lay-event="edit" style="margin:5px;">预约状态</a>
        <a class="layui-btn layui-btn-xs" lay-event="editTB" style="margin:5px;">修改咨询信息</a>
        <a class="layui-btn layui-btn-xs" lay-event="editCase" style="margin:5px;">个案记录表</a>
        <a class="layui-btn layui-btn-xs" lay-event="addOrder" style="margin:5px;">补缴费</a>
    </script>
    <script type="text/html" id="imgtmp">
        <img src="{{ d.url }}">
    </script>
    <script type="text/html" id="checkboxTpl">
        {{#  if(d.IsShow){ }}
        <input type="checkbox" name="lock" value="{{d.ID}}" title="显示" lay-filter="lockDemo" checked>
        {{#  } else  { }}
        <input type="checkbox" name="lock" value="{{d.ID}}" title="显示" lay-filter="lockDemo">
        {{#  }
        }}
    </script>
    <script>
        layui.use(['laydate', 'form', 'table'], function () {
            var table = layui.table
            , form = layui.form;
            var laydate = layui.laydate;
           
            table.render({
                elem: '#test'
               , height: 'full-120'
              , url: '/psychologists/GetConsultationList'
              , where: { keyword: '' }
               , toolbar: true
              , toolbar: '#toolbarDemo' //开启头部工具栏，并为其绑定左侧模板
              , title: '咨询师表'
              , totalRow: false
              , cols: [[
                { type: 'checkbox', fixed: 'left', unresize: true, width: 40 }
                //, { field: 'ID', title: 'ID', width: 80, unresize: true, sort: true}
                
              ,{ field: 'gId', title: 'gId', hide: true, style: 'display:none;' }
                 , { field: 'patientName', title: '来访者', fixed: 'left', unresize: true, width: 100 }
                 //, { field: 'patientTel', title: '联系方式', fixed: 'left', unresize: true, width: 100 }
                , { field: 'appointmentTime', title: '预约时间', width: 160, sort: true }
                , { field: 'cTime', title: '咨询时间', width: 160 }
            , { field: 'duration', title: '咨询时长', width: 100 }
            , { field: 'address', title: '咨询地址', width: 160 }
             , { field: 'StateDescription', title: '咨询状态', width: 200 }
                    //, { field: 'content1', title: '咨询内容' }
                    //, { field: 'problems', title: '具体问题', width: 200 }
                    , { field: 'remark', title: '备注', width: 100 }
                 //, { field: 'name', title: '咨询师', fixed: 'left', unresize: true, width: 100 }
                 //       , { field: 'expert', title: '咨询专家', width: 100 }
                 //        , { field: 'record', title: '咨询记录', width: 160 }
                 //         , { field: 'intention', title: '合作意图', width: 100 }
                    , { field: 'createTime', title: '创建时间', width: 160, sort: true }              
                , { fixed: 'right', title: '操作', toolbar: '#barDemo', width: 245 }
              ]]
              , page: true
              , limits: [10, 15, 20, 1000]
              , limit: 15 //每页默认显示的数量
                 , done: function (res, curr, count) {
                     $(".layui-table-main tr").each(function (index, val) {
                         $(".layui-table-fixed").each(function () {
                             $($(this).find(".layui-table-body tbody tr")[index]).height($(val).height());
                         });
                     });
                     $(".layui-table-header tr").each(function (index, val) {
                         $(".layui-table-fixed").each(function () {
                             $($(this).find(".layui-table-header thead tr")[index]).height($(val).height());
                         });
                     });
                 }
                , done: function (res, curr, count) { // 表格渲染完成回调
                    //执行一个laydate实例
                    laydate.render({
                        elem: '#chooseDay' //指定元素
                         , type: 'date'
                        , trigger: 'click'
                        , range: true //开启日期范围，默认使用“_”分割
                    });
                }

            });

            //头工具栏事件
            table.on('toolbar(test)', function (obj) {
                var checkStatus = table.checkStatus(obj.config.id);
                //layer.alert(obj.event);
                switch (obj.event) {
                    case 'getCheckData':
                        //var data = checkStatus.data;
                        //layer.alert(JSON.stringify(data));
                        
                        break;
                    case 'getCheckLength':
                        var data = checkStatus.data;
                        layer.msg('选中了：' + data.length + ' 个');
                        break;
                    case 'isAll':
                        layer.msg(checkStatus.isAll ? '全选' : '未全选');
                        break;

                        //自定义头工具栏右侧图标 - 提示
                    case 'LAYTABLE_TIPS':
                        layer.alert('帮助');
                        break;
                    case 'reload':
                        var searchName = $('#searchName').val();
                        var chooseDay = $("#chooseDay").val();
                        table.reload('test', {
                            url: '/psychologists/GetConsultationList'
                            , where: { keyword: searchName, chooseDay: chooseDay }
                            , page: 1
                            , title: '咨询记录表' + chooseDay
                        }, 'data');
                        $('#searchName').val(searchName);
                        if (chooseDay != "") {
                            $('#chooseDay').val(chooseDay);
                        }
                        
                        break;                       
                };
            });

            //监听行工具事件
            table.on('tool(test)', function (obj) {
                var data0 = obj.data;
                console.log(obj)
                if (obj.event === 'del') {
                    layer.confirm('真的删除' + data0.userName + '么', function (index) {

                    });
                } else if (obj.event === 'edit') {
                    layer.open({
                        type: 2
                         , title: '预约时间'
                           , content: '/psychologists/EditConsultation0/' + data0.gId
                           , area: ['500px', '600px']
                           , maxmin: true
                    });
                } else if (obj.event === 'editTB') {
                    layer.open({
                        type: 2
                         , title: '修改地址'
                           , content: '/psychologists/EditConsultationDZ/' + data0.gId
                           , area: ['600px', '600px']
                           , maxmin: true
                    });
                } else if (obj.event === 'editCase') {
                    layer.open({
                        type: 2
                        , title: '心理咨询个案记录表'
                           , content: '/psychologists/EditCaseRecord/' + data0.gId
                           , area: ['100%', '100%']
                           , maxmin: true
                    });
                } else if (obj.event === 'addOrder') {
                        layer.open({
                            type: 2
                            , title: '补缴咨询费'
                               , content: '/psychologists/addOrder/' + data0.gId
                                , area: ['500px', '600px']
                               , maxmin: true
                        });
                    } 
            });
        });

    </script>
</body>

</html>