    <div class="weui-cells">
        <label class="weui-label weui-start">13. 咨询主题： [选择题]  </label>
        <div class="weui-cell weui-form" style="padding: 0px 0px;">
            <table style="width: 98%;">
                <tbody>
                    @foreach (T_Field item in Fieldlist.Where(o => o.FieldID == 0).ToArray())
                    {
                        <tr>
                            <td>
                                <div class="weui-form-li iblock weui-form-li-z2">
                                    <input class="weui-form-checkbox" name="subject" id="subject @item.ID" value="@item.Name" type="checkbox" @(RegistrationForm.subject.Contains(item.Name) ? "checked" : "")>
                                    <label for="subject @item.ID">
                                        <i class="weui-icon-checkbox"></i>
                                        <div class="weui-form-text" style="margin-right: 0px;"><p>@item.Name</p></div>
                                    </label>
                                </div>
                            </td>
                            <td>
                                <div class="layui-input-block" style="margin-left:10px;">
                                    @foreach (T_Field item2 in Fieldlist.Where(o => o.FieldID == item.ID).ToArray())
                                    {
                                        <div class="weui-form-li iblock weui-form-li-z2">
                                            <input class="weui-form-checkbox" name="subject" id="subject @item2.ID" value="@item2.Name" type="checkbox" @(RegistrationForm.subject.Contains(item2.Name) ? "checked" : "")>
                                            <label for="subject @item2.ID">
                                                <i class="weui-icon-checkbox"></i>
                                                <div class="weui-form-text"><p>@item2.Name</p></div>
                                            </label>
                                        </div>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    <tr>
                        <td>
                            <div class="weui-form-li iblock weui-form-li-z2">
                                <input class="weui-form-checkbox" name="subject" id="subjectQTO" value="其他" type="checkbox" @(RegistrationForm.subject.Contains("其他") ? "checked" : "")>
                                <label for="subjectQTO">
                                    <i class="weui-icon-checkbox"></i>
                                    <div class="weui-form-text" style="margin-right: 0px;"><p>其他</p></div>
                                </label>
                            </div>
                        </td>
                        <td>
                            <div class="layui-input-block" style="margin-left:10px;">

                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>

        </div>

    </div>

    <div class="weui-cells">
        <label class="weui-label weui-start">14. 是否经医院诊断： [单选题]  </label>
        <div class="weui-form" style="padding: 0px 0px;">
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="diagnosis" id="diagnosis1" value="否" type="radio" @(RegistrationForm.diagnosis == "否" ? "checked" : "")>
