            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="diagnosis" id="diagnosis2" value="其他" type="radio" @(RegistrationForm.diagnosis == "是" ? "checked" : "")>
                <label for="diagnosis2" style="float: left;">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>是，请填写诊断结果</p></div>
                </label>
                <div class="weui-cell__bd" style="float: left; width: 100%;">
                    <input class="weui-input border-radius" name="diagnosisQT" id="diagnosisQT" type="text" value="@RegistrationForm.diagnosis">
                </div>
            </div>
        </div>
    </div>

    <div class="weui-cells">
        <label class="weui-label weui-start">15. 是否在服药： [单选题]   </label>
        <div class="weui-form" style="padding: 0px 0px;">
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="takeMedicine" id="takeMedicine1" value="否" type="radio" @(RegistrationForm.takeMedicine == "否" ? "checked" : "")>
                <label for="takeMedicine1">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>否</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="takeMedicine" id="takeMedicine2" value="其他" type="radio" @(RegistrationForm.takeMedicine == "是" ? "checked" : "")>
