            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="cohabit" id="cohabit4" value="寝室室友" type="radio" @(RegistrationForm.cohabit == "寝室室友" ? "checked" : "")>
                <label for="cohabit4">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>寝室室友</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="cohabit" id="cohabit5" value="独居" type="radio" @(RegistrationForm.cohabit == "独居" ? "checked" : "")>
                <label for="cohabit5">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>独居</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="cohabit" id="cohabit6" value="其他" type="radio" @(RegistrationForm.cohabit == "其他" ? "checked" : "")>
                <label for="cohabit6">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>其他</p></div>
                </label>
            </div>
        </div>
    </div>

    <div class="weui-cells">
        <label class="weui-label weui-start">12. 了解途径 ：[单选题] </label>
        <div class="weui-form" style="padding: 0px 0px;">
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway1" value="医生推荐" type="radio" @(RegistrationForm.gateway == "医生推荐" ? "checked" : "")>
                <label for="gateway1">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>医生推荐</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway2" value="咨询师推荐" type="radio" @(RegistrationForm.gateway == "咨询师推荐" ? "checked" : "")>
                <label for="gateway2">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>咨询师推荐</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway3" value="微信公众号" type="radio" @(RegistrationForm.gateway == "微信公众号" ? "checked" : "")>
                <label for="gateway3">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>微信公众号</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway4" value="微信视频号" type="radio" @(RegistrationForm.gateway == "微信视频号" ? "checked" : "")>
                <label for="gateway4">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>微信视频号</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway5" value="美团/大众点评" type="radio" @(RegistrationForm.gateway == "美团/大众点评" ? "checked" : "")>
                <label for="gateway5">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>美团/大众点评</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway6" value="直播" type="radio" @(RegistrationForm.gateway == "直播" ? "checked" : "")>
                <label for="gateway6">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>直播</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway7" value="团体活动" type="radio" @(RegistrationForm.gateway == "团体活动" ? "checked" : "")>
                <label for="gateway7">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>团体活动</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway8" value="小红书" type="radio" @(RegistrationForm.gateway == "小红书" ? "checked" : "")>
                <label for="gateway8">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>小红书</p></div>
