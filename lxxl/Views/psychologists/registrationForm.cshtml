                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="maritalStatus" id="maritalStatus5" value="丧偶" type="radio" @(RegistrationForm.maritalStatus == "丧偶" ? "checked" : "")>
                <label for="maritalStatus5">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>丧偶</p></div>
                </label>
            </div>
        </div>
    </div>

    <div class="weui-cells">
        <label class="weui-label weui-start">8. 文化程度 ：[单选题] </label>
        <div class="weui-form" style="padding: 0px 0px;">
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="educationalLevel" id="educationalLevel1" value="小学" type="radio" @(RegistrationForm.educationalLevel == "小学" ? "checked" : "")>
                <label for="educationalLevel1">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>小学</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="educationalLevel" id="educationalLevel2" value="初中" type="radio" @(RegistrationForm.educationalLevel == "初中" ? "checked" : "")>
                <label for="educationalLevel2">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>初中</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="educationalLevel" id="educationalLevel3" value="高中" type="radio" @(RegistrationForm.educationalLevel == "高中" ? "checked" : "")>
                <label for="educationalLevel3">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>高中</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="educationalLevel" id="educationalLevel4" value="大专" type="radio" @(RegistrationForm.educationalLevel == "大专" ? "checked" : "")>
                <label for="educationalLevel4">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>大专</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="educationalLevel" id="educationalLevel5" value="本科" type="radio" @(RegistrationForm.educationalLevel == "本科" ? "checked" : "")>
                <label for="educationalLevel5">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>本科</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="educationalLevel" id="educationalLevel6" value="研究生及以上" type="radio" @(RegistrationForm.educationalLevel == "研究生及以上" ? "checked" : "")>
                <label for="educationalLevel6">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>研究生及以上</p></div>
                </label>
            </div>
        </div>
    </div>

    <div class="weui-cells">
        <div class="weui-cell__hd ">
            <label class="weui-label weui-start">9. 宗教信仰： [填空题] </label>
        </div>
        <div class="weui-cell__bd weui-cell__bd_z1">
            <input class="weui-input border-radius" name="religion" id="religion" type="text" value="@RegistrationForm.religion">
        </div>
    </div>

    <div class="weui-cells">
        <div class="weui-cell__hd ">
            <label class="weui-label weui-start">10. 现居住城市；[填空题] </label>
        </div>
        <div class="weui-cell__bd weui-cell__bd_z1">
            <input class="weui-input border-radius" name="city" id="city" type="text" value="@RegistrationForm.city">
        </div>
    </div>

    <div class="weui-cells">
        <label class="weui-label weui-start">11. 和谁同住 ：[单选题] </label>
        <div class="weui-form" style="padding: 0px 0px;">
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="cohabit" id="cohabit1" value="家人" type="radio" @(RegistrationForm.cohabit == "家人" ? "checked" : "")>
                <label for="cohabit1">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>家人</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="cohabit" id="cohabit2" value="恋人" type="radio" @(RegistrationForm.cohabit == "恋人" ? "checked" : "")>
                <label for="cohabit2">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>恋人</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="cohabit" id="cohabit3" value="合租" type="radio" @(RegistrationForm.cohabit == "合租" ? "checked" : "")>
                <label for="cohabit3">
