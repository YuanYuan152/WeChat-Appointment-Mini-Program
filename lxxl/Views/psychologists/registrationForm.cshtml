                <input class="weui-form-checkbox" name="gateway" id="gateway10" value="济心理课程" type="radio" @(RegistrationForm.gateway == "济心理课程" ? "checked" : "")>
                <label for="gateway10">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>济心理课程</p></div>
                </label>
