            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="gateway" id="gateway9" value="政府活动/民非" type="radio" @(RegistrationForm.gateway == "政府活动/民非" ? "checked" : "")>
                <label for="gateway9">
