@{
    ViewBag.Title = "register";
}

@{
    ViewBag.Title = "EditCaseRecord";
    Layout = null;
    List<T_Field> Fieldlist = ViewBag.Fieldlist;
    T_RegistrationForm RegistrationForm = ViewBag.RegistrationForm;
}
@using lxxl.Models

<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>同心理咨询预约登记表</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=0">
    <link rel="stylesheet" href="/Content/weui/css/weui.css" />
    <link rel="stylesheet" href="/Content/weui/css/weuix.css" />
    <script src="/Content/weui/js/zepto.min.js"></script>
    <script src="/Content/weui/js/zepto.weui.js"></script>
    <script src="/Content/weui/js/picker.city.js"></script>

    <style>
        .weui-cells {
            margin-top: 0px;
            padding-left: 15px;
            padding-bottom: 5px;
            padding-top: 5px;
        }

        .weui-label {
            width: calc(100% - 24px);
            margin-top: 6px;
        }

        .weui-labelz4 {
            width: 72px;
            text-align: right;
        }

        .weui-labelz3 {
            width: 52px;
            text-align: right;
        }

        .weui-cell__bd_z1 {
            padding: 4px 28px 10px 22px;
        }

        .weui-cell__hd_z1 {
            padding: 2px 28px 10px 22px;
        }

        .weui-cell__hd_z2 {
            padding: 2px 28px 10px 22px;
        }

        .weui-form-li {
            margin: 1px 1px;
        }

        .weui-form-li-z2 {
            margin: 1px 1px;
        }
        .weui-label span {
            font-weight: normal;
        }
    </style>
</head>

<body style="background-color: #EFEFEF; ">
    <div class="page-hd" style="padding-top: 5px; padding-bottom: 5px; background-color: #E7E8ED; ">
        <h1 class="page-hd-title" style="color: #1ea0fa; font-weight: bold; margin: 0; padding: 0; text-align: center; padding-bottom: 2px;">
            同心理咨询预约登记表
        </h1>
        <p class="page-hd-desc">
            您好！为方便及时了解您的信息和咨询意愿，更好地为您匹配合适的咨询师，请填写以下内容。预约登记结束后，会有助理与您联系，以便为您安排接下来的咨询。
        </p>
        <p class="page-hd-desc">
            我们向您承诺，以下有关您的个人信息，都将严格的为您保密。
        </p>
    </div>

    <div class="weui-cells">
        <input type="text" id="gId" name="gId" class="layui-input" hidden value="@RegistrationForm.gId">
        <label class="weui-label">1. 您是否是本人咨询 ： <span style="font-weight: normal;">@RegistrationForm.isSelf </span></label>       
    </div>

    <div class="weui-cells" id="relationshipDiv">
        <label class="weui-label">2. 您是来访的： <span>@RegistrationForm.relationship </span></label>
    </div>

    <div class="weui-cells">
        <div class="weui-cel" style="padding-left: 0;">
            <label class="weui-label">3. 姓名：<span>@RegistrationForm.name </span></label>
        </div>
        <div class="weui-cell" style="padding-left: 0;">
            <label class="weui-label  weui-labelz4">性别：<span>@RegistrationForm.gender </span></label>
        </div>
        <div class="weui-cell" style="padding-left: 0;">
            <label class="weui-label weui-labelz4">年龄：<span>@RegistrationForm.age 岁</span></label>
        </div>
        <div class="weui-cell" style="padding-left: 0;">
            <label class="weui-label weui-labelz4">民族：<span>@RegistrationForm.nation </span></label>
        </div>
    </div>

    @*<div class="weui-cells">
        <div class="weui-cell__hd ">
            <label class="weui-label weui-start">4. 请输入您的手机号码： [填空题] </label>
        </div>
        <div class="weui-cell__bd weui-cell__bd_z1">
            <input class="weui-input border-radius" name="mobile" id="mobile" type="text" value="@RegistrationForm.mobile">
        </div>
    </div>

    <div class="weui-cells">
        <div class="weui-cell__hd ">
            <label class="weui-label weui-start">5. 与同心理联系的微信号 ：[填空题] </label>
        </div>
        <div class="weui-cell__bd weui-cell__bd_z1">
            <input class="weui-input border-radius" name="wechat" id="wechat" type="text" value="@RegistrationForm.wechat">
        </div>
    </div>*@

    <div class="weui-cells">
        <div class="weui-cell__hd ">
            <label class="weui-label weui-start">6. 职业： [填空题] </label>
        </div>
        <div class="weui-cell__bd weui-cell__bd_z1">
            <input class="weui-input border-radius" name="career" id="career" type="text" value="@RegistrationForm.career">
        </div>
    </div>

    <div class="weui-cells">
        <label class="weui-label weui-start">7. 婚姻状况： [单选题] </label>
        <div class="weui-form" style="padding: 0px 0px;">
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="maritalStatus" id="maritalStatus1" value="未婚" type="radio" @(RegistrationForm.maritalStatus == "未婚" ? "checked" : "")>
                <label for="maritalStatus1">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>未婚</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="maritalStatus" id="maritalStatus2" value="已婚未育" type="radio" @(RegistrationForm.maritalStatus == "已婚未育" ? "checked" : "")>
                <label for="maritalStatus2">
                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>已婚未育</p></div>
                </label>
            </div>
            <div class="weui-form-li iblock">
                <input class="weui-form-checkbox" name="maritalStatus" id="maritalStatus3" value="已婚已育" type="radio" @(RegistrationForm.maritalStatus == "已婚已育" ? "checked" : "")>
                <label for="maritalStatus3">
                    <i class="weui-icon-radio"></i>
