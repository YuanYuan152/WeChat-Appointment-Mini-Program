                    <i class="weui-icon-radio"></i>
                    <div class="weui-form-text"><p>其他</p></div>
                </label>
                <div class="weui-cell__bd" style="float: left;">
                    <input class="weui-input border-radius" name="gatewayQT" id="gatewayQT" type="text" value="@RegistrationForm.gateway">
