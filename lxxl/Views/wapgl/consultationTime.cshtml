                '14:00', '14:30',
                '15:00', '15:30',
                '16:00', '16:30',
                '17:00', '17:30',
                '18:00', '18:30',
                '19:00', '19:30',
                '20:00', '20:30',
                '21:00', '21:30',
                '22:00', '22:30',
                '23:00', '23:30',
            ],
            onChange: function (d) {

            },
            onClose: function () {
                //console.log("close");
            },
            onOpen: function () {
                //console.log("open");
            },
        });
    </script>


    <div class="weui-cells weui-cells_form">
    </div>
    <br>
    <br><br>

    <div class="weui-footer weui-footer_fixed-bottom">
        <p class="weui-footer__links">
            <a href="#" class="weui-footer__link">连心心理</a>
        </p>
        <p class="weui-footer__text" style="color: #586C94; font-size: 12px;"> 若有问题，请联系我们，电话：021-</p>
        <p class="weui-footer__text" style="font-size: 12px;">Support By  上海连心心理咨询有限公司</p>
    </div>
</body>
</html>