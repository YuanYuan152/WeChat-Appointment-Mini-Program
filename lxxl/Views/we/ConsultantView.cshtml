<script>
    $.ajax({
        url: "/WeixinCurrency/getJsToken",
        type: "POST",
        success: function (data) {
            if (data.errcode == 0) {
                wx.config({
                    debug: false,
                    appId: data.weixin.appId, // 必填，公众号的唯一标识
                    timestamp: data.weixin.timestamp, // 必填，生成签名的时间戳
                    nonceStr: data.weixin.nonceStr, // 必填，生成签名的随机串
                    signature: data.weixin.signature, // 必填，签名，见附录1
                    jsApiList: [
                    'checkJsApi',
                    'openLocation',
                    'getLocation',
                    'chooseWXPay'
                    ]
                });
            } else {
                alert("获取签名失败");
            }
        },
        error: function () {
            alert("获取签名失败");
        }
    })

</script>
<script>
    var vm = new Vue({
        el: '#rrapp',
        data: {
            doctorScheduleList: [],
            doctorSchedule: {},
            doctor: {},
            doctorID: 0,
            clickRadioID: -1,
            xyID: 0,
        },
        created: function () {
            this.doctorID = '@(ViewBag.doctorID)';
            //var id = $.getParam("id");
            console.log(this.doctorID);
            this.getIni(this.doctorID);

        },
        methods: {
            getIni: function (id) {
                var that = this;
                $.ajaxSettings.async = false;
                $.get("/we/getDoctor/" + id, function (r) {
                    that.doctor = r.doctor;
                    console.log(that.doctor);
                    that.getInfo(that.doctor.ID);
                });
            },
            getInfo: function (id) {
                var that = this
                $.ajaxSettings.async = false;
                $.get("/we/getDoctorSchedule/" + id, function (r) {
                    console.log(r);
                    that.doctorScheduleList = r.doctorScheduleList;
                });
            },
            //myopendiv: function () {
            //    var index = layer.open({
            //        type: 1,//Layer提供了5种层类型。可传入的值有：0（信息框，默认）1（页面层）2（iframe层）3（加载层）4（tips层）,
            //        skin: 'layui-layer-rim',//layui-layer-rim//layui-layer-molv
            //        title: "",
            //        offset: "3px",
            //        area: ['100%', '360px'],
            //        shadeClose: true,
            //        closeBtn: 2,
            //        offset: 'auto',
            //        content: jQuery("#approveLayer"),
            //        btn: ['取消'],
            //        cancel: function (index, layero) {
            //        },
            //        btn2: function () {
            //        }
            //    });
            //},
            clickRadio: function (value) {
                if (value > 0) { vm.clickRadioID = value; }
                console.log(vm.clickRadioID);
                $('#spinner').show();
            },
            myopendiv: function (value) {
                if (vm.clickRadioID < 0) {
                    layer.msg('请选择需要预约的时间');
                    return;
                }
                var that = this;

                $.ajax({
                    url: '/we/getPatient',
                    data: { doctorID: that.doctorID },
                    type: 'post',
                    success: function (data) {
                        if (data.code == 0) {
                            if (data.csum > 0) {
                                vm.doctorSchedule = vm.doctorScheduleList[vm.clickRadioID];
                                var index = layer.open({
                                    type: 1,//Layer提供了5种层类型。可传入的值有：0（信息框，默认）1（页面层）2（iframe层）3（加载层）4（tips层）,
                                    skin: 'layui-layer-rim',//layui-layer-rim//layui-layer-molv
                                    title: "",
                                    offset: "3px",
                                    area: ['90%', '360px'],
                                    shadeClose: true,
                                    closeBtn: 1,
                                    offset: 'auto',
                                    content: jQuery("#approveLayer"),
                                    cancel: function (index, layero) {
                                    },
                                    btn2: function () {
                                    }
                                });
                            }
                            else {
                                if (data.formGid === '') {
                                    vm.layeropenForm(data.patient.Name, that.doctor.name);
                                }
                                else {
                                    layer.confirm('请确认是否成年？', {
                                        title: '提示',
                                        btn: ['是', '否', '取消']
                                          , btn3: function (index, layero) {
                                          }
                                    }, function (index, layero) {
                                        layer.close(index);
                                        vm.layeropenXY(2, data.patient.Name, vm.doctorScheduleList[vm.clickRadioID].Price, that.doctor.name);
                                    }, function (index) {
                                        layer.close(index);
                                        vm.layeropenXY(1, data.patient.Name, vm.doctorScheduleList[vm.clickRadioID].Price, that.doctor.name);
                                    });
                                }
                            }
                        }
                        else {
                            layer.msg(data.msg + "，请去注册！", {
                                time: 5000,
                                shade: 0.3,
                                btn: ['确认', '取消'],
                                yes: function () {
                                    window.location.href = data.url;
                                }
                            });
                            return;
                        }
                    }
                });
            },


            layeropenForm: function (patientName, doctorname) {
                var index0 = layer.open({
                    type: 2,//Layer提供了5种层类型。可传入的值有：0（信息框，默认）1（页面层）2（iframe层）3（加载层）4（tips层）,
                    skin: 'layui-layer-rim',//layui-layer-rim//layui-layer-molv
                    title: "",
                    offset: "3px",
                    area: ['98%', '100%'],
                    shadeClose: true,
                    closeBtn: 1,
                    offset: 'auto',
                    content: '/wapForm/register',
                    btn: ['提交', '取消'],
                    cancel: function (index, layero) {
                    },
                    btn1: function (index, layero) {
                        var obj = $(layero).find("iframe")[0].contentWindow;
                        var resXY = obj.tijiao();
                        layer.close(index);
                        if (resXY > 0) {
                            layer.confirm('请确认是否成年？', {
                                title: '提示',
                                btn: ['是', '否', '取消']
                                          , btn3: function (index, layero) {
                                          }
                            }, function (index, layero) {
                                layer.close(index);
                                vm.layeropenXY(2, patientName, vm.doctorScheduleList[vm.clickRadioID].Price, doctorname);
                            }, function (index) {
                                layer.close(index);
                                vm.layeropenXY(1, patientName, vm.doctorScheduleList[vm.clickRadioID].Price, doctorname);
