            layeropenXY: function (type, name, money, doctor) {
                var index0 = layer.open({
                    type: 2,//Layer提供了5种层类型。可传入的值有：0（信息框，默认）1（页面层）2（iframe层）3（加载层）4（tips层）,
                    skin: 'layui-layer-rim',//layui-layer-rim//layui-layer-molv
                    title: "",
                    offset: "3px",
                    area: ['98%', '100%'],
                    shadeClose: true,
                    closeBtn: 1,
                    offset: 'auto',
                    content: '/we/xy?type=' + type + '&name=' + name + '&money=' + money + '&doctor=' + doctor,
                    btn: ['确定', '取消'],
                    cancel: function (index, layero) {
                    },
                    btn1: function (index, layero) {
                        var obj = $(layero).find("iframe")[0].contentWindow;
                        var resXY = obj.tijiao();
                        if (resXY > 0) {
                            vm.xyID = resXY;
                            layer.close(index);
                            vm.doctorSchedule = vm.doctorScheduleList[vm.clickRadioID];
                            console.log(vm.doctorSchedule);
                            var index = layer.open({
                                type: 1,//Layer提供了5种层类型。可传入的值有：0（信息框，默认）1（页面层）2（iframe层）3（加载层）4（tips层）,
                                skin: 'layui-layer-rim',//layui-layer-rim//layui-layer-molv
                                title: "",
                                offset: "3px",
                                area: ['90%', '360px'],
                                shadeClose: true,
                                closeBtn: 1,
                                offset: 'auto',
                                content: jQuery("#approveLayer"),
                                cancel: function (index, layero) {
                                },
                                btn2: function () {
                                }
                            });
                        }
                    },
                    btn2: function (index, layero) {
                        layer.close(index);
                    }
                });
            },

            onpay: function () {
                if (vm.clickRadioID < 0) {
                    layer.msg('请选择需要预约的时间');
                    return;
                }

                var that = this;
                $.ajax({
                    url: '/we/appointment',
                    data: { doctorScheduleID: vm.doctorSchedule.ID, xyID: vm.xyID },
                    type: 'post',
                    success: function (data) {
                        layer.msg(data.msg);
                        if (data.code == 0) {
                            window.location = data.url;
                        }
                        else {
                            window.location.reload();
                        }
                    }
                })
            },
        }
    })
</script>





