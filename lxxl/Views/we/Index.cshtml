        .tab-bottom a p {
            color: rgb(67,74,118);
            font-size: 16px;
            font-weight: bold;
        }

        .slidebanbtn {
            width: 5.5rem;
            height: 1.8rem;
            line-height: 1.8rem;
            font-size:0.85rem;
            position: absolute;
            right: 0px;
            bottom: 0px;
            border-radius: 2rem;
            font-weight: bold;
            background-color: rgb(243,217,242);
            color: rgb(217,98,200);
            display: inline-block;
            padding: 0 12px;
        }

        .weui-btn_primary:not(.weui-btn_disabled):active {
            color: rgba(243,217,242, 0.6);
            background-color: rgb(217,98,200);
        }

        .ban-con {
            position: relative;
            margin-right: 1px;
            margin-left: 1px;
        }

            .ban-con .img img {
                width: 100%;
            }

            .ban-con .text {
                position: absolute;
                left: 50%;
                -webkit-transform: translate(-50%,0);
                -moz-transform: translate(-50%,0);
                -ms-transform: translate(-50%,0);
                -o-transform: translate(-50%,0);
                transform: translate(-50%,0);
                bottom: 9px;
                width: 92%;
                height: auto;
                margin: 0 auto;
                color: #fff;
            }

                .ban-con .text p {
                    position: relative;
                    font-size: 20px;
                    font-weight: bold;
                    letter-spacing: 6px;
                    text-transform: uppercase;
                }

                    .ban-con .text p:after {
                        content: "";
                        position: absolute;
                        top: -18px;
                        left: 0;
                        width: 52px;
                        height: 2px;
                        background: #fff;
                    }

                .ban-con .text h5 {
                    font-size: 18px;
                    font-weight: normal;
                    margin-top: 36px;
                }

                .ban-con .text h3 {
                    font-size: 20px;
                    font-weight: 500;
                    margin-top: 10px;
                    text-transform: uppercase;
                }

        .dimship {
            width: 72px;
