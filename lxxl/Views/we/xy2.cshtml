    <script type="text/javascript">
        function CjinerX() {
            var jiner = document.getElementById("jinerX").innerHTML;
            if (jiner === "" || jiner == null) {
                return false;
            }

            if (isNaN(jiner)) {
                alert("请填入数字");
                return true;

            }
            document.getElementById("jinerD").innerHTML = digitUppercase(jiner);
            jinerCS = jiner/5;
            document.getElementById("jinerCSX").innerHTML = digitUppercase(jinerCS);
            document.getElementById("jinerCSD").innerHTML = digitUppercase(jinerCS);
        }

        function digitUppercase(n) {
            var fraction = ['角', '分'];
            var digit = [
                    '零', '壹', '贰', '叁', '肆',
                    '伍', '陆', '柒', '捌', '玖'
            ];
            var unit = [
                    ['元', '万', '亿'],
                    ['', '拾', '佰', '仟']
            ];
            var head = n < 0 ? '欠' : '';
            n = Math.abs(n);
            var s = '';
            for (var i = 0; i < fraction.length; i++) {
                s += (digit[Math.floor(n * 10 * Math.pow(10, i)) % 10] + fraction[i]).replace(/零./, '');
            }
            s = s || '整';
            n = Math.floor(n);
            for (var i = 0; i < unit[0].length && n > 0; i++) {
                var p = '';
                for (var j = 0; j < unit[1].length && n > 0; j++) {
                    p = digit[n % 10] + unit[1][j] + p;
                    n = Math.floor(n / 10);
                }
                s = p.replace(/(零.)*零$/, '').replace(/^$/, '零') + unit[0][i] + s;
            }
            return head + s.replace(/(零.)*零元/, '元')
                    .replace(/(零.)+/g, '零')
                    .replace(/^整$/, '零元整');
        };


        $(document).ready(function () {
            CjinerX();
        });

        function tijiao() {
            var jiner = document.getElementById("jinerX").innerHTML;
            if (jiner === "" || jiner == null) {
                alert("请填入金额");
                return -1;
            }
            var name = $("#name").val();
            if (name === "" || name == null) {
                alert("请填入姓名");
                return -1;
            }
            if (window.frames["uploadFrame2"].document.getElementById("signature-img").src.substr(0, 5) === 'data:') {
                $.ajaxSettings.async = false;
                var id = 0;
                $.ajax({
                    url: '/Patient/EditXY',
                    data: { jiner: jiner, name: name, doctor: '@ViewBag.doctor', img1: window.frames["uploadFrame2"].document.getElementById("signature-img").src, img2:null },
                    type: 'post',
                    async: false,
                    success: function (data) {
                        if (data.code == 0) {
                            id = data.id;
                        }
                    }
                })
                return id;
            }
            else {
                alert("签名异常，请检查");
                return -1;
            }
        }
    </script>

