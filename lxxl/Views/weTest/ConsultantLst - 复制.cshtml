@using lxxl.Models;
@{
    Layout = null;
    ViewBag.Title = "ConsultantLst";
    var BannerLst = ViewBag.BannerLst;
    var DoctorLst = ViewBag.DoctorLst;
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>连心心理</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1.0, user-scalable=no">
    <link rel="stylesheet" href="/Content/weui/css/weui.css" />
    <link rel="stylesheet" href="/Content/weui/css/weuix.css" />
    <script type="text/javascript" src="/Public/index/js/jquery.min.js"></script>
    <script src="/Content/weui/js/zepto.min.js"></script>
    <script src="/Content/weui/js/zepto.weui.js"></script>
    <script src="/Content/weui/js/swipe.js"></script>

    <link rel="stylesheet" type="text/css" href="/Public/index/css/slick.css">

    <style>
        * {
            margin: 0px;
            padding: 0px;
        }

        html,
        body {
            height: 100%;
        }

        #wrap {
            width: 100%;
            height: 100%;
            position: relative;
        }

        #head {
            width: 100%;
            position: fixed;
            background-color: #E7E8ED;
            height: 52px;
            top: 0;
            z-index: 999;
        }

        #main {
            width: 100%;
            position: absolute;
            padding-top: 55px;
            padding-bottom: 55px;
            font-family: initial;
        }

        #foot {
            position: fixed;
            bottom: 0px;
            height: 50px;
            width: 100%;
            background: #f5eedc;
        }

        .tab-bottom a img {
            width: 40px;
        }

        .tab-bottom a p {
            color: rgb(67,74,118);
            font-size: 16px;
            font-weight: bold;
        }

        .weui-news-media {
            width: 7rem;
        }
        .weui-news-title {
            font-size: 18px;
            font-weight: bold;
            position: relative;
            max-width: 100%;
            color: rgb(67,74,118);
        }

        .my-news-p {
            font-size: 14px;
            color: rgb(67,74,118);
            -webkit-line-clamp: 3;
            line-height: 18px;
            margin-top: 2px;
        }

        .weui-news-left {
            margin-left: 0.05rem !important;
            font-size: 16px !important;
            color: rgb(255,190,38);
            font-weight: bold;
        }

        .dimship {
            width: 72px;
            height: 20px;
            line-height: 20px;
            font-size: 12px;
            position: absolute;
            left: 3px;
            top: 13px;
            background-color: rgb(239,253,255);
            color: rgb(67,74,118);
            border-radius: 1em;
            text-align: center;
        }

        .zxshishu {
            height: 20px;
            line-height: 20px;
            font-size: 12px;
            padding: 0 8px;
            position: relative;
            right: 12px;
            background-color: rgb(105,81,131);
            color: #ffffff;
            border-radius: 12px 0 12px 0;
            text-align: center;
            transform: scale(0.8);
        }

        #header {
            background-color: #004982;
            overflow: hidden;
            position: fixed;
            z-index: 99;
            width: 100%;
            left: 0;
            top: 0;
        }
    </style>

    <script>
        $(function () {
            $('#t1').tab({
                defaultIndex: 0,
                activeClass: 'tab-green',
                onToggle: function (index) {
                    console.log('index' + index);
                }
            });
        })
    </script>

</head>

<body style="background-color:rgb(67,74,118)">

    <div id="header" class="weui-header">
        <div class="weui-header-left"> <a href="javascript:history.back(-1);" style="color: #FFF;">返回</a>  </div>
        <h1 class="weui-header-title" style="color: #FFF;">咨询师</h1>
        <div class="weui-header-right"><a href="@Url.Action("Index", "we")" style="color: #FFF;">主页</a></div>
    </div>

    <div id="container" style="margin-top: 50px;">
        <div class="weui-search-bar" style="background-color: transparent; position: initial; padding: 12px 24px 12px 20px;">
            <input type="search" class="search-input" id='search' placeholder='搜索咨询师' style="background-color: rgb(67, 74, 118); border: 1px solid rgb(104,114,211); border-radius: 30px; color: #ffffff; text-align: center; line-height: 2.2;" />
            <a style="background-color: transparent; padding: 2px 6px; margin-left: -46px; z-index: 1; ">
                <img src="/Public/we//seI.png" alt="" style="width:30px;display:block">
            </a>
        </div>

        <div class="weui-news">
            <ul class="weui-news-list">
                @foreach (T_Doctor item in ViewBag.DoctorLst)
                {
                    <li class="weui-news-item" style="padding-top:4px; padding-bottom:2px;" >
                        <a class="weui-news-inner" href="/we/ConsultantView/@item.gId">
                            <div class="weui-news-media">
                                <img class="img-responsive" src="@(item.url == "" ? "/Public/we/tc59.png" : item.url)" alt="@item.name" title="Title" />
                                <div class="dimship">地面/视频</div>
                                @*<div class="zxshishu">咨询时数：@item.ConsultHours 小时+</div>*@
                            </div>
                            <div class="weui-news-inners">
                                <div class="weui-news-title">
                                    <span class="weui-news-left" style="color:rgb(67,74,118); font-weight:bold;">@item.name</span>
                                    <span class="weui-news-left" style="color:rgb(67,74,118);">[@item.Province]</span>
                                    <span style="color: rgb(139,86,192); float: right; font-size: 14px;margin-top:2px;">从业 @item.WorkYears 年</span>
                                </div>
                                <div class="weui-news-text">
                                    <p class="zxshishu">咨询时数：@item.ConsultHours 小时+</p>
                                </div>
                                <div class="weui-news-text">
                                    <p class="weui-news-p my-news-p">@item.Profile</p>
                                </div>
                                <div class="weui-news-info">
                                    <div class="weui-news-infoitem">
                                        <span class="weui-news-left" style="color:rgb(67,74,118); font-size:12px !important; background-color:rgb(245,245,245);">家庭婚姻 | 亲子关系</span>
                                    </div>
                                    <div class="weui-news-infoitem">
                                        <span>￥@item.Billing /小时</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <div style="height:120px; text-align: center;">
        </div>
        <div class="weui-tabbar tab-bottom" style="background-color: #ffffff; border-radius: 12px 12px 0 0;">
            <a href="javascript:;" class="weui-tabbar__item">
                <img src="/Public/we/bottom1.png" alt="">
                <p class="weui-tabbar__label">首页</p>
            </a>
            <a href="javascript:;" class="weui-tabbar__item">
                <img src="/Public/we/bottom2.png" alt="">
                <p class="weui-tabbar__label">活动招募</p>
            </a>

            <a href="javascript:;" class="weui-tabbar__item ">
                <img src="/Public/we/bottom10.png" alt="" style="position: absolute; bottom:35px; left: 0px; width: 100%;">
                <p class="weui-tabbar__label  f-green" style="margin-top: 40px;">心理咨询</p>
            </a>
            <a href="javascript:;" class="weui-tabbar__item">
                <img src="/Public/we/bottom3.png" alt="">
                <p class="weui-tabbar__label">主题月</p>
            </a>
            <a href="javascript:;" class="weui-tabbar__item ">
                <img src="/Public/we/bottom4.png" alt="">
                <p class="weui-tabbar__label">我的</p>
            </a>
        </div>

    </div>

    <script type="text/javascript" src="/Public/index/js/slick.min.js"></script>
    <script type="text/javascript" src="/Public/index/js/zturn.js"></script>
    <script type="text/javascript">

        $(document).ready(function () {
            $('.cou-teambaner').slick({
                arrows: false,
                slidesToShow: 2,
                slidesToScroll: 1,
                autoplay: true,
                autoplaySpeed: 3000,
            });

        });
    </script>
</body>

</html>