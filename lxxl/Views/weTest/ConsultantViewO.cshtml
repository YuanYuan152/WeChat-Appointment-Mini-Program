        console.log(stickeyI0);
        console.log(stickeyI1);
        console.log(stickeyI2);

        topVal = 200;
        if (st < stickeyI1 - topVal) {
            console.log(0);
            $("#tagnav li:first-child").addClass('weui-state-active').siblings().removeClass('weui-state-active');
